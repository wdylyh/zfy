// new2.md 9a: function types written directly as param/field types
i32 add(i32 a, i32 b)
    return a + b

struct Handler
    i32(i32, i32) op
    i32 base

i32 apply(i32(i32, i32) f, i32 x, i32 y)
    return f(x, y)

void main()
    output(apply(add, 3, 4))
    Handler h = Handler(op=add, base=10)
    output(h.op(h.base, 5))
