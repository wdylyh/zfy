// File 作泛型函数实参（T = File 标量传递，非 struct 字段）
fn <F> F echo_open(let F f, let string mode)
    return f
fn void dump(let File f)
    write(f, "via generic\n")
fn main()
    let File w = open("_tmp/probe/v4_out.tmp", "w") ?? panic("open fail")
    let File w2 = echo_open(move w, "w")
    dump(move w2)
    output("moved-ok")
    let File r = open("_tmp/probe/v4_out.tmp", "r") ?? panic("open fail")
    output(read_all(r))
    close(r)
    output("ok")
