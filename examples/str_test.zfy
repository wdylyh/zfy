// 字符串操作端到端测试（函数式内建调用风格）
// 覆盖：length/下标读字符/切片 [a,b] 与 [a,b:step]（步长冒号）/
//       find(s,'l') 含 count= 第几次出现（未找到 -1）/trim/split 赋给 string 列表/
//       replace(s,起,止,"串")/+ 拼接/整体赋值（RAII 先释放旧串）
void main()
    string n = "Hello World"
    string list m
    output(length(n))               // 期望 11
    output(n[4])                    // 期望 o
    output(n[4,10])                 // 期望 o World（两端含）
    output(n[4,10:2])               // 期望 oWrd（步长 2，冒号）
    output(find(n, 'l'))            // 期望 2（第 1 次出现）
    output(find(n, 'l', count=2))   // 期望 3（第 2 次出现）
    output(find(n, 'l', count=3))   // 期望 9（第 3 次出现）
    output(find(n, 'z'))            // 期望 -1（未找到返回 -1）
    output(trim(n, 'l'))            // 期望 Heo Word（删除所有 'l'）
    m = split(n, 'l')               // 切分为 string 列表："Hello World" 有 3 个 'l'，
                                    // 连续分隔符产生空段 -> "He","","o Wor","d"
    output(m[0], m[1], m[2], m[3], sep=",")   // 期望 He,,o Wor,d
    output(length(m))               // 期望 4（段数 = 分隔符出现次数 + 1）
    output(replace(n, 6, 10, "zfy"))          // 期望 Hello zfy（[6,10] 区间替换）
    string g = n + "!"              // + 拼接（生成新串）
    output(g)                       // 期望 Hello World!
    g = "zfy"                       // string 整体赋值（RAII：先释放旧串再挂新串）
    output(g)                       // 期望 zfy
    output("x" + g)                 // 期望 xzfy
