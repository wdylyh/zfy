// t14.zfy —— big_sqrt 第 3 段：内层求 digit 循环

fn i32[] big_trim(let i32[] a)
    let i32[] out
    let i64 i = 0
    let i64 n = length(a)
    while i < n and a[i] == 0
        i++
    if i == n
        out = push(out, 0)
        return out
    while i < n
        out = push(out, a[i])
        i++
    return out

fn bool big_zero(let i32[] a)
    return length(a) == 1 and a[0] == 0

fn i32[] big_mul_add(let i32[] a, let i32 m, let i32 add)
    let i32[] out
    if big_zero(a) and m == 0
        out = push(out, add)
        return big_trim(out)
    let i32[] rev
    let i64 i = length(a) - 1
    while i >= 0
        rev = push(rev, a[i])
        i--
    let i32 carry = add
    let i32[] outr
    let i64 j = 0
    while j < length(rev)
        let i32 t = rev[j] * m + carry
        outr = push(outr, t % 10)
        carry = t / 10
        j++
    while carry > 0
        outr = push(outr, carry % 10)
        carry = carry / 10
    let i64 k = length(outr) - 1
    while k >= 0
        out = push(out, outr[k])
        k--
    return big_trim(out)

fn i32 big_cmp(let i32[] a, let i32[] b)
    if length(a) < length(b)
        return 0 - 1
    if length(a) > length(b)
        return 1
    let i64 i = 0
    while i < length(a)
        if a[i] < b[i]
            return 0 - 1
        if a[i] > b[i]
            return 1
        i++
    return 0

fn i32[] big_sub(let i32[] a, let i32[] b)
    let i32[] ar
    let i64 i = length(a) - 1
    while i >= 0
        ar = push(ar, a[i])
        i--
    let i32[] br
    let i64 j = length(b) - 1
    while j >= 0
        br = push(br, b[j])
        j--
    let i32[] outr
    let i32 borrow = 0
    let i64 k = 0
    while k < length(ar)
        let i32 av = ar[k]
        let i32 bv = 0
        if k < length(br)
            bv = br[k]
        let i32 t = av - bv - borrow
        if t < 0
            t = t + 10
            borrow = 1
        else
            borrow = 0
        outr = push(outr, t)
        k++
    let i32[] out
    let i64 m2 = length(outr) - 1
    while m2 >= 0
        out = push(out, outr[m2])
        m2--
    return big_trim(out)

fn string big_sqrt(let i32[] N, let i64 want)
    output("  S1 enter\n")
    let i32[] groups
    let i64 n = length(N)
    let i64 first = n % 2
    if first == 0
        first = 2
    let i32 g0 = 0
    let i64 i = 0
    while i < first
        g0 = g0 * 10 + N[i]
        i++
    groups = push(groups, g0)
    while i < n
        let i32 g = N[i] * 10 + N[i + 1]
        groups = push(groups, g)
        i = i + 2
    output("  S2 grouped glen=", length(groups), "\n")

    let i32[] rem
    rem = push(rem, 0)
    let i32[] r
    r = push(r, 0)
    let string digits = ""
    let i64 gi = 0
    let i64 produced = 0
    output("  S4 loop start\n")
    while produced < want
        let i32 g = 0
        if gi < length(groups)
            g = groups[gi]
        let i32[] cur = big_mul_add(rem, 100, g)
        let i32[] r20 = big_mul_add(r, 20, 0)
        output("    L4 r20 len=", length(r20), "\n")
        let i32 d = 9
        let bool found = false
        let i32[] chosen
        chosen = push(chosen, 0)
        output("    L5 chosen init\n")
        while d >= 0 and not found
            let i32[] t = big_mul_add(r20, d, d * d)
            output("      M1 d=", d, " t len=", length(t), "\n")
            if big_cmp(t, cur) <= 0
                chosen = t
                found = true
            else
                d--
        output("    L6 d=", d, " found=", found, "\n")
        if not found
            d = 0
        rem = big_sub(cur, chosen)
        output("    L7 rem done\n")
        r = big_mul_add(r, 10, d)
        output("    L8 r done\n")
        digits = digits + cast(d + 48, string)
        output("    L9 digits=", digits, "\n")
        produced++
        gi++
        if produced >= 3
            return digits
    return digits

fn main()
    output("A\n")
    let i32[] N
    N = push(N, 2)
    let i64 e = 0
    while e < 4
        N = big_mul_add(N, 10, 0)
        e++
    output("B N len=", length(N), "\n")
    output("C call\n")
    let string r = big_sqrt(N, 4)
    output("D r=", r, "\n")