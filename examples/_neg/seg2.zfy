void main()
    i64 array sa[6] = 1,2,3,4,5,6
    sa[1,3] += 10
    output(sa[0], sa[1], sa[2], sa[3], sa[4], sa[5], sep=',', end=' ')
    output("")
    i64 array sb[6] = 1,2,3,4,5,6
    sb[0,5:2] *= 3
    output(sb[0], sb[2], sb[4], sep=',', end=' ')
    output("")
    f64 pi = 3.75
    cast(pi, i32)
    output(pi)
    output("A\tB\vC\aD")
    i64 pos = find("hello", 'l', count=2)
    output(pos)
