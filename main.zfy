// ledger.zfy —— 单文件迷你记账 / 文本数据库
// 编译：zfyc build ledger.zfy

mod strutil
    pub fn bool starts_with(let string s, let string prefix)
        let i64 ls = length(s)
        let i64 lp = length(prefix)
        if ls < lp
            return false
        let i64 i = 0
        while i < lp
            if s[i] != prefix[i]
                return false
            i++
        return true

    pub fn bool ends_with(let string s, let string suffix)
        let i64 ls = length(s)
        let i64 lx = length(suffix)
        if ls < lx
            return false
        let i64 off = ls - lx
        let i64 i = 0
        while i < lx
            if s[off + i] != suffix[i]
                return false
            i++
        return true

    pub fn i64! parse_i64(let string s)
        let i64 n = length(s)
        if n == 0
            fail(ErrCode.CUSTOM, "empty number")
        let i64 i = 0
        let bool neg = false
        if s[0] == '-'
            neg = true
            i = 1
        if i >= n
            fail(ErrCode.CUSTOM, "bad number")
        let i64 v = 0
        while i < n
            let char c = s[i]
            if c == '.'
                let i64 j = i + 1
                while j < n
                    let char c2 = s[j]
                    let i32 cv2 = ord(c2)
                    if cv2 < ord('0') or cv2 > ord('9')
                        fail(ErrCode.CUSTOM, "bad digit")
                    j++
                break
            let i32 cv = ord(c)
            if cv < ord('0') or cv > ord('9')
                fail(ErrCode.CUSTOM, "bad digit")
            v = v * 10 + cast(cv - ord('0'), i64)
            i++
        if neg
            v = -v
        return v

    pub fn string pad_i64(let i64 v, let i32 width)
        let bool neg = v < 0
        let i64 a = v
        if neg
            a = -a
        let string digits = ""
        if a == 0
            digits = "0"
        while a > 0
            let i32 d = cast(a % 10, i32)
            let string ch = ""
            ch += chr(ord('0') + d)
            digits = ch + digits
            a = a / 10
        if neg
            digits = "-" + digits
        let i64 w = cast(width, i64)
        while length(digits) < w
            digits = "0" + digits
        return digits

struct Entry
    string date
    string category
    i64 amount
    string note

struct Ledger
    Entry items[]

let string DB_FILE = "ledger.db"

fn void die(let string msg)
    output("error: ", msg, "\n")
    panic(ErrCode.CUSTOM, msg)

fn bool is_leap(let i32 y)
    if y % 400 == 0
        return true
    if y % 100 == 0
        return false
    return y % 4 == 0

fn i32 days_in_month(let i32 y, let i32 m)
    if m == 2
        if is_leap(y)
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    return 31

fn bool valid_date(let string d)
    if length(d) != 10
        return false
    if d[4] != '-' or d[7] != '-'
        return false
    let i64! y = strutil.parse_i64(d[0, 3])
    let i64! m = strutil.parse_i64(d[5, 6])
    let i64! day = strutil.parse_i64(d[8, 9])
    let i64 yy = y ?? -1
    let i64 mm = m ?? -1
    let i64 dd = day ?? -1
    if yy < 1
        return false
    if mm < 1 or mm > 12
        return false
    if dd < 1 or dd > cast(days_in_month(cast(yy, i32), cast(mm, i32)), i64)
        return false
    return true

fn i64! yuan_to_cents(let string s)
    let string parts[] = split(s, '.')
    if length(parts) == 1
        let i64! v = strutil.parse_i64(parts[0])
        let i64 base = v ?? 0
        return base * 100
    if length(parts) != 2
        fail(ErrCode.CUSTOM, "bad amount")
    let i64! iv = strutil.parse_i64(parts[0])
    let i64 ip = iv ?? 0
    let string fp_str = parts[1]
    if length(fp_str) == 0
        return ip * 100
    if length(fp_str) == 1
        fp_str += "0"
    if length(fp_str) > 2
        fp_str = fp_str[0, 1]
    let i64! fv = strutil.parse_i64(fp_str)
    let i64 fp = fv ?? 0
    return ip * 100 + fp

fn string cents_to_yuan(let i64 cents)
    let bool neg = cents < 0
    let i64 a = cents
    if neg
        a = -a
    let i64 yuan = a / 100
    let i64 cent = a % 100
    let string out = strutil.pad_i64(yuan, 1) + "." + strutil.pad_i64(cent, 2)
    if neg
        out = "-" + out
    return out

fn void save_items(let Entry items[])
    let string content = ""
    let i64 n = length(items)
    let i64 i = 0
    while i < n
        let Entry e = items[i]
        content += e.date + "\t" + e.category + "\t" + strutil.pad_i64(e.amount, 1) + "\t" + e.note + "\n"
        i++
    let i64! w = write_file(DB_FILE, content)
    let i64 wv = w ?? -1
    if wv < 0
        die("cannot write database")

fn Ledger load_ledger()
    let Ledger L = Ledger()
    if not exists(DB_FILE)
        return L
    let string! raw = read_file(DB_FILE)
    let string content = raw ?? ""
    if length(content) == 0
        return L
    let string raw_lines[] = split(content, '\n')
    let i64 n = length(raw_lines)
    let i64 i = 0
    while i < n
        let string line = raw_lines[i]
        i++
        if length(line) == 0
            continue
        if strutil.ends_with(line, "\r")
            line = line[0, length(line) - 2]
        let string cols[] = split(line, '\t')
        if length(cols) < 4
            continue
        let i64! amt = strutil.parse_i64(cols[2])
        let i64 av = amt ?? 0
        let Entry e = Entry(date=cols[0], category=cols[1], amount=av, note=cols[3])
        push(L.items, e)
    return L

fn void cmd_init()
    let Ledger L = Ledger()
    save_items(L.items)
    output("initialized empty ledger at ", DB_FILE, "\n")

fn void cmd_add(let string date, let string category, let string amount, let string note)
    if not valid_date(date)
        die("invalid date: " + date)
    let i64! cents = yuan_to_cents(amount)
    let i64 cv = cents ?? -1
    if cv < 0
        die("invalid amount: " + amount)
    let Ledger L = load_ledger()
    let Entry e = Entry(date=date, category=category, amount=cv, note=note)
    push(L.items, e)
    save_items(L.items)
    output("added: ", date, " ", category, " ", cents_to_yuan(cv), " ", note, "\n")

fn void cmd_del(let string idx_s)
    let Ledger L = load_ledger()
    let Entry items[] = L.items
    let i64! idx = strutil.parse_i64(idx_s)
    let i64 iv = idx ?? -1
    let i64 len = length(items)
    if iv < 1 or iv > len
        die("index out of range")
    remove(items, iv - 1)
    save_items(items)
    output("deleted entry #", iv, "\n")

fn void print_entries(let Entry items[])
    output(" #  date        category       amount      note\n")
    output("--------------------------------------------------------\n")
    let i64 n = length(items)
    let i64 i = 0
    while i < n
        let Entry e = items[i]
        output(strutil.pad_i64(i + 1, 2), "  ",
               e.date, "  ",
               prec(e.category, 12), "  ",
               prec(cents_to_yuan(e.amount), 10), "  ",
               e.note, "\n")
        i++

fn void cmd_list()
    let Ledger L = load_ledger()
    if length(L.items) == 0
        output("(empty)\n")
        return
    print_entries(L.items)

fn void cmd_sum()
    let Ledger L = load_ledger()
    let i64 total = 0
    let i64 n = length(L.items)
    let i64 i = 0
    while i < n
        total += L.items[i].amount
        i++
    output("total: ", cents_to_yuan(total), " (", n, " entries)\n")

fn void cmd_month(let string ym)
    let Ledger L = load_ledger()
    let Entry hit[] = Entry(date="", category="", amount=0, note="")
    remove(hit, 0)
    let i64 total = 0
    let i64 n = length(L.items)
    let i64 i = 0
    while i < n
        let Entry e = L.items[i]
        if strutil.starts_with(e.date, ym)
            push(hit, e)
            total += e.amount
        i++
    if length(hit) == 0
        output("no entries for ", ym, "\n")
        return
    print_entries(hit)
    output("month ", ym, " total: ", cents_to_yuan(total), "\n")

fn void cmd_export(let string path)
    let Ledger L = load_ledger()
    let string out = "date,category,amount,note\n"
    let i64 n = length(L.items)
    let i64 i = 0
    while i < n
        let Entry e = L.items[i]
        out += e.date + "," + e.category + "," + cents_to_yuan(e.amount) + "," + e.note + "\n"
        i++
    let i64! w = write_file(path, out)
    let i64 wv = w ?? -1
    if wv < 0
        die("cannot export")
    output("exported ", n, " entries to ", path, "\n")

fn void cmd_help()
    output("ledger commands:\n")
    output("  init\n")
    output("  add <YYYY-MM-DD> <category> <amount> <note...>\n")
    output("  del <index>\n")
    output("  list\n")
    output("  sum\n")
    output("  month <YYYY-MM>\n")
    output("  export <file>\n")
    output("  help\n")

fn main()
    let string line = ""
    input(line, delim='\n')
    if strutil.ends_with(line, "\r")
        line = line[0, length(line) - 2]
    let string args[] = split(line, ' ')
    let i64 n = length(args)
    if n == 0
        cmd_help()
        return 0

    let string cmd = args[0]

    if cmd == "init"
        cmd_init()
    else if cmd == "add"
        if n < 5
            die("usage: add <date> <category> <amount> <note...>")
        let string note = ""
        let i64 i = 4
        while i < n
            if i > 4
                note += " "
            note += args[i]
            i++
        cmd_add(args[1], args[2], args[3], note)
    else if cmd == "del"
        if n < 2
            die("usage: del <index>")
        cmd_del(args[1])
    else if cmd == "list"
        cmd_list()
    else if cmd == "sum"
        cmd_sum()
    else if cmd == "month"
        if n < 2
            die("usage: month <YYYY-MM>")
        cmd_month(args[1])
    else if cmd == "export"
        if n < 2
            die("usage: export <file>")
        cmd_export(args[1])
    else if cmd == "help"
        cmd_help()
    else
        die("unknown command: " + cmd)

    return 0