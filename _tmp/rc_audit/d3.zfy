// 定位变体 d3：push + 整体 move 重赋值清空（xs = ys）
interface Shape
    fn i64 area()

struct Sq
    i64 v = 0
    fn i64 area()
        return self.v

fn main()
    let Shape[] xs
    let i64 i = 0
    while i < 5
        xs = push(xs, Shape(Sq(i)))
        i = i + 1
    let Shape[] ys
    xs = ys
    output(length(xs))
    output("d3 ok")
