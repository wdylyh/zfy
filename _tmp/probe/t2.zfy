enum Shape
    Empty
    Circle(f64)
    Rect(f64, f64)
fn main()
    let Shape s = Shape.Circle(2)
    match s
        Shape.Circle(r) => output(r)
        Shape.Rect(a, b) => output(a * b)
        Shape.Empty => output(0)
    let Shape t = Shape.Rect(3, 4)
    match t
        Shape.Rect(a, b) => output(a * b)
        _ => output(0 - 1)
    output("ok")
