// 标量声明省略初值：填类型零值；const 必须带初值
fn main()
    let i32 x
    let f64 d
    let bool b
    let char c
    let string s
    output(x, d, b, c, s, sep='|')   // 期望 0|0|false||（char 零值不可见）
    let i32 y
    y = 5
    output(y)                        // 期望 5
    let i32 lst[]
    lst = push(lst, x)
    lst = push(lst, y)
    output(lst[0], lst[1], sep=',')  // 期望 0,5
