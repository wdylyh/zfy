// t03: 函数——ref 参数（标量/string/数组/列表）、返回 T[]/T[N]、函数类型参数（grammar.md §5）
type Fun = i32(i32)

fn void bump(ref let i32 x)
    x += 10

fn void wrap(ref let string s)
    s = s + "!"

fn void fill(ref let i32 xs[])
    push(xs, 10)
    push(xs, 20)
    xs[0] = 99

fn void fill2(ref let i32[] xs)
    push(xs, 1)

fn i32[] upto(let i32 n)
    let i32 a[]
    for let i32 i = 0,   i < n, i++
        push(a, i)
    return a

fn i32[3] triple()
    let i32 a[3] = 1, 2, 3
    return a

fn i32 apply(let Fun f, let i32 v)
    return f(v)

fn i32 inc(let i32 x)
    return x + 1

fn main()
    let i32 v = 5
    bump(ref v)
    let string s = "a"
    wrap(ref s)
    let i32 e[]
    fill(ref e)
    let i32 e2[]
    fill2(ref e2)
    let i32[] a = upto(5)
    let i32[3] t = triple()
    output(v, s, e, e2, a, t)
    output(apply(inc, 41))
    return 0
