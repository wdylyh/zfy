fn void task4()
    // 5 万元素列表，200 轮深拷贝 + 步长切片 + 写
    // 限制记录：列表声明初值不支持整体拷贝（只收逐元素初值），改用数组
    let i32 base[50000]
    for let i32 i = 0,   i < 50000, i++
        base[i] = i
    let i64 acc = 0
    let i64 const LCG_MOD = 2147483647
    for let i32 r = 0,   r < 200, r++
        let i32 cp[50000] = base
        let i32 sl[25000] = base[0, 49998:2]
        let i64 idx = cast(r, i64) % length(sl)
        sl[idx] += r
        acc = (acc + cast(sl[idx], i64)) % LCG_MOD
    output("T4 acc=", acc, " len=", length(base))

fn main()
    task4()
