// 9b 链式指针字段：p.next.x 逐层自动解引用 + struct 自引用（指针形态，new2.md #7 前置）
struct Node
    i32 v = 0
    Node* next = null

fn main()
    let Node c = Node(3, null)
    let Node b = Node(2, &c)
    let Node a = Node(1, &b)
    // 链式读：a.next.v 中间层 TPtr(TStruct) 自动解引用
    output(a.v, a.next.v, a.next.next.v, sep=',')
    // 链式写
    a.next.v = 20
    a.next.next.v = 30
    output(b.v, c.v, sep=',')
    // 复合赋值
    a.next.v += 5
    output(b.v)
    return 0
