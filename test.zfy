// wcpro.zfy —— zfy v3.15.0 文本统计与报告工具
// 功能：统计行/词/字节数、词频 Top N、最长行、字符频率
// 用法：wcpro.exe <文件> [topN] [--chars]
//   不给文件则读 stdin（用 delim 逐段读）。
//   第二个参数为词频 Top N（默认 10）。
//   --chars 额外输出字符频率 Top N。

// ---------------- §28.1 泛型约束 ----------------
fn <T: num> T gsum2(let T a, let T b)
    return a + b

// ---------------- §22 枚举 ----------------
enum OutFmt
    Plain
    Markdown

// ---------------- §24/§19 工具函数 ----------------
fn bool is_space(let char c) -> bool
    return c == ' ' or c == '\t' or c == '\r' or c == '\n'

fn string[] tokenize(let string s) -> string[]
    let string[] out
    let i32 n = length(s)
    let i32 i = 0
    let i32 start = 0
    let bool in_tok = false
    while i < n
        let char c = s[i]
        if is_space(c)
            if in_tok
                out = push(out, s[start, i - 1])
                in_tok = false
            i++
        else
            if not in_tok
                start = i
                in_tok = true
            i++
    if in_tok
        out = push(out, s[start, n - 1])
    return out

fn string lower(let string s) -> string
    let string r = ""
    let i32 n = length(i)
    let i32 i = 0
    while i < n
        let char c = s[i]
        if c >= 'A' and c <= 'Z'
            r += chr(ord(c) + 32)
        else
            r += c
        i++
    return r

// 词频统计：map<string,i32> -> 按次数降序的 (词,次数) 列表
struct WordCount
    string w = ""
    i32 n = 0

fn i32 cmp_wc(let WordCount a, let WordCount b) -> i32
    if a.n != b.n
        return b.n - a.n
    return a.w < b.w

fn WordCount[] top_words(let map<string, i32> freq, let i32 topn) -> WordCount[]
    let string[] ks = keys(freq)
    let WordCount[] ws
    for k in ks
        let i32 c = freq[k] ?? 0
        ws = push(ws, WordCount(w=k, n=c))
    let WordCount[] sorted = sort_by(ws, cmp_wc)
    // 截断到 topn
    let WordCount[] out
    let i32 i = 0
    while i < length(sorted) and i < topn
        out = push(out, sorted[i])
        i++
    return out

// 字符频率：map<string,i32>，键是单字符 string
fn string[] top_chars(let map<string, i32> cf, let i32 topn) -> string[]
    let string[] ks = keys(cf)
    let string[] out
    let i32 best = -1
    let i32 used = 0
    // 简单选择排序（Top N 足够）
    let string[] pool = ks
    while used < topn and length(pool) > 0
        let i32 bi = 0
        let i32 bv = -1
        let i32 i = 0
        while i < length(pool)
            let i32 v = cf[pool[i]] ?? 0
            if v > bv
                bv = v
                bi = i
            i++
        out = push(out, pool[bi] + ":" + to_str(bv))
        let string dropped = remove(pool, bi)
        used++
    return out

// ---------------- 主流程 ----------------
fn main()
    let string[] argv = os_args()
    let string fname = ""
    let i32 topn = 10
    let bool want_chars = false
    let OutFmt fmt = OutFmt.Plain
    let i32 ai = 1
    while ai < length(argv)
        let string a = argv[ai]
        if a == "--chars"
            want_chars = true
        else if a == "--md"
            fmt = OutFmt.Markdown
        else if startswith(a, "--")
            output("unknown option: ", a, "\n")
            return 2
        else if length(fname) == 0
            fname = a
        else
            let i32! pn = cast(a, i32)
            if pn?? 0 > 0
                topn = pn?? 10
            else
                output("bad topN: ", a, "\n")
                return 2
        ai++

    // 读取输入
    let string text = ""
    if length(fname) > 0
        let string! rf = read_file(fname)
        if rf?
            text = rf
        else
            output("cannot read: ", fname, "\n")
            return 1
    else
        // 逐行读到 EOF
        while true
            let string! line = input()?
            text += line + "\n"
            // input 到 EOF 会 panic，这里依赖 delim 模式不适用；
            // 简化：非交互场景请给文件名。

    // 统计
    let i32 bytes = length(text)
    let string[] lines = split(best, '\n')
    let i32 nlines = length(lines)
    if nlines > 0 and length(lines[nlines - 1]) == 0
        nlines--
    let string[] words = tokenize(text)
    let i32 nwords = length(words)

    // 词频（小写归一）
    let map<string, i32> freq
    for w in words
        let string lw = lower(w)
        let i32 old = freq[lw] ?? 0
        freq[lw] = old + 1

    // 字符频率
    let map<string, i32> cf
    if want_chars
        let i32 i = 0
        while i < bytes
            let char c = text[i]
            if not is_space(c)
                let string k = chr(ord(c))
                cf[k] = (cf[k] ?? 0) + 1
            i++

    // 最长行
    let i32 longest = 0
    let i32 longest_ln = 0
    let i32 li = 0
    for ln in lines
        let i32 L = length(ln)
        if L > longest
            longest = L
            longest_ln = li + 1
        li++

    // 输出
    if fmt == OutFmt.Plain
        output("== report: ", fname, " ==\n")
    else
        output("# report: `", fname, "`\n\n")
    output("lines: ", nlines, "\n")
    output("words: ", nwords, "\n")
    output("bytes: ", bytes, "\n")
    output("longest line: ", longest_ln, " (", longest, " bytes)\n")
    output("unique words: ", map_len(freq), "\n\n")

    output("top ", topn, " words:\n")
    let WordCount[] tw = top_words(freq, topn)
    for wc in tw
        output("  ", prec(wc.w, 16), " ", wc.n, "\n")

    if want_chars
        output("\ntop ", topn, " chars (non-space):\n")
        let string[] tc = top_chars(cf, topn)
        for s in tc
            output("  ", s, "\n")

    // §26 断言自检（示例）
    assert_eq(gsum2(2, 3), 5)
    return 0