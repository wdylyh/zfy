mod gui;
mod widgets;
use widgets::{App, UI}
use theme::{Theme, get_theme}
use gui::{gui_frame_sleep}

fn main()
    let App app = App()
    if app.open(320, 220, "zfy 计数器") != 0
        return 1
    let Theme th = get_theme()

    // 标签元素
    let UI title = UI("label")
    title.pos(20, 20)
    title.size(280, 24)
    title.text("计数 0")
    let i32 kt = app.add(title)

    // 按钮元素
    let UI btn = UI("button")
    btn.pos(20, 70)
    btn.size(140, 44)
    btn.text("点我 +1")
    btn.color(th.accent)
    btn.radius(8)
    let i32 kb = app.add(btn)

    let i32 prev = 0
    while app.alive()
        app.step()
        if app.uis[kb].clicks != prev        // 差值 = 新点击
            prev = app.uis[kb].clicks
            app.set_text(kt, "计数 " + to_str(prev))
        gui_frame_sleep(tick_ms())
    app.close()
    return