// module system test (new2.md #4): inline mod / nesting / file mod / pub / group use / as rename / :: paths

mod math
    pub let i32 const PI = 3

    pub fn i32 add(let i32 a, let i32 b)
        return a + b

    pub struct Point
        i32 x
        i32 y

    fn i32 hidden()
        return 99

    mod inner
        pub fn i32 triple(let i32 x)
            return x * 3

// file module: loads filem.zfy in this directory
mod filem;

use math::add
use math::{Point, PI as PI2}
use math::inner::triple
use filem::square

fn main()
    let i32 s = math::add(1, 2)
    let Point p = Point(x=1, y=2)
    output(s, end="\n")
    output(PI2, end="\n")
    output(triple(4), end="\n")
    output(p.x + p.y, end="\n")
    output(square(5), end="\n")
