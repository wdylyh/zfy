// w-014 #1：类型后缀语法 T[]/T[N]、函数返回数组/列表、ref 列表参数
fn i32[] mk()
    let i32 a[] = 1, 2, 3
    return a
fn i32[3] mkarr()
    let i32 a[3] = 7, 8, 9
    return a
fn i32[] upto(let i32 n)
    let i32 a[]
    for let i32 i = 0,   i < n, i++
        a = push(a, i)
    return a
fn void fill(ref let i32 xs[])
    xs = push(xs, 10)
    xs = push(xs, 20)
    xs[0] = 99
fn main()
    let i32[] a = mk()
    output(a)
    let i32[3] b = mkarr()
    output(b)
    let i32[] c = upto(5)
    output(c)
    let i32[] d = a[1, 2]
    output(d)
    output(mk())
    let i32 e[]
    fill(ref e)
    output(e)
    let i64 n = length(e)
    output(n)
    return
