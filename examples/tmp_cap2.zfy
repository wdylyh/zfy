// 临时探针：规范边界事实验证（验证后删除）
// 预期输出：
// 0            （& 捕获 string：lambda 内拼接，返回 0）
// hi!          （宿主再读同一箱：穿透可见）
// 3            （& 捕获列表：length 穿透）
// 9            （push 穿透写回后读尾元素）
// 4            （宿主 length=4，与 lambda 共享）
// 7            （值捕获列表 push：副本上追加）
// 1            （值捕获隔离：外层 length 不变）
// 3            （值捕获 struct 读字段和）
struct Pnt
    i32 x
    i32 y

fn main()
    // 1) & 捕获 string（堆箱载荷 = 堆串指针）
    let string msg = "hi"
    let fn() -> i32 fmsg = fn [&msg]() -> i32
        msg = msg + "!"
        return 0
    let i32 r1 = fmsg()
    output(r1)              // 0
    output(msg)             // hi!（穿透拼接可见）

    // 2) & 捕获列表（堆箱载荷 = seq 指针）
    let i32[] a = 1, 2, 3
    let fn() -> i32 fla = fn [&a]() -> i32
        a = push(a, 9)
        return a[length(a) - 1]
    output(length(a))       // 3
    output(fla())           // 9
    output(length(a))       // 4（穿透共享）

    // 3) 值捕获列表 + push（副本独立）
    let i32[] b = 5
    let fn() -> i32 flb = fn [b]() -> i32
        let i32[] c = push(b, 7)
        return c[length(c) - 1]
    output(flb())           // 7
    output(length(b))       // 1（隔离）

    // 4) 值捕获 struct
    let Pnt p = Pnt(x=1, y=2)
    let fn() -> i32 fp = fn() => p.x + p.y
    output(fp())            // 3

    output("ok")
