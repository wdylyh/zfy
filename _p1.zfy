struct St
    u8 buf[8]
    u32 st[4]

fn main()
    let u64 g = 0x9E3779B97F4A7C15
    output("g=", g, "\n")
    let u64 x = 0xDEADBEEFCAFEBABE
    let u128 m = cast(x, u128) * cast(1000, u128)
    let u64 lo = cast(m, u64)
    let u64 hi = cast(m >> 64, u64)
    output("lo=", lo, " hi=", hi, "\n")
    let u64 masked = (x >> 4) & 15
    output("masked=", masked, "\n")
    let string s = ""
    let i32 i = 0
    while i < 5
        s += chr(48 + i)
        i++
    output("s=", s, "\n")
    let i32 c0 = cast(s[0], i32)
    output("c0=", c0, "\n")
    let St t = St()
    t.buf[0] = 65
    t.st[2] = 4242
    output("buf0=", t.buf[0], " st2=", t.st[2], "\n")
    let i32[] xs = 1, 2, 3, 4, 5
    bump(ref xs, 100)
    output("xs0=", xs[0], "\n")
    return 0

fn void bump(ref let i32 xs[], let i32 v)
    xs[0] = v
