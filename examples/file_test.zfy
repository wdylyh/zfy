// 文件 I/O 测试（design_fileio.md 第一阶段）
// open/read_all/read_line/write/writeln/close/exists/read_file/write_file
// File move-only 句柄：作用域退出自动 close、move 传参、失效/关闭后使用 panic

fn i64 count_lines(let File f)
    let i64 n = 0
    let i64 go = 1
    while go == 1
        let string! lr = read_line(f)
        let string line = lr ??
            if err.code == 7
                go = 0
            ""
        if go == 1
            n = n + 1
    return n

fn main()
    // 一步式写/读
    let i64! wn = write_file("_ft1.txt", "hello file\nsecond line\nthird")
    output("written: ", wn ?? -1)
    let string! ra = read_file("_ft1.txt")
    output("read_file: ", ra ?? "FAIL")

    // 句柄写 + 显式 close
    let File! fw = open("_ft2.txt", "w")
    let File w = fw ?? panic("open w failed")
    write(w, "line1")
    writeln(w, "")
    writeln(w, "line2")
    close(w)

    // 句柄读：read_line / move 传参（helper 内 RAII 关闭）
    let File! fr = open("_ft2.txt", "r")
    let File r = fr ?? panic("open r failed")
    let string! l1 = read_line(r)
    output("l1: ", l1 ?? "<eof>")
    output("count: ", count_lines(move r))

    // exists
    output("exists-yes: ", exists("_ft1.txt"))
    output("exists-no: ", exists("_ft_no_such_file.xyz"))

    // 追加模式
    let File! fa = open("_ft2.txt", "a")
    let File a = fa ?? panic("open a failed")
    writeln(a, "appended")
    close(a)
    let string! rb = read_file("_ft2.txt")
    let string body = rb ?? ""
    output("has-appended: ", find(body, 'p') ?? -1)

    // 作用域退出自动 close：块内打开不显式 close，随函数退出关闭
    let File! fz = open("_ft1.txt", "r")
    let File z = fz ?? panic("open z failed")
    output("z-first: ", read_line(z) ?? "<eof>")
    return 0
