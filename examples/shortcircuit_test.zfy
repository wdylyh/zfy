// and/or 短路求值测试：右边不应被求值
fn main()
    let i32 arr[5]
    for let i32 i = 0,   i < 5, i++
        arr[i] = i * 10
    let i32 idx = 7
    // 不短路的话 arr[7] 越界崩溃；短路后右边不求值
    let bool a = idx < 5 and arr[idx] > 0
    output("a=", a, end='\n')
    // or：左边为真时右边不求值
    let bool b2 = idx >= 5 or arr[idx] > 0
    output("b=", b2, end='\n')
    // 两边都求值的普通情形
    let bool c = idx < 5 and arr[2] == 20
    output("c=", c, end='\n')
    let bool d = idx > 5 or arr[1] == 10
    output("d=", d, end='\n')
    // rhs 真正被求值的路径
    let bool e2 = arr[2] == 20 and arr[3] == 30
    output("e=", e2, end='\n')
    let bool f = arr[0] == 99 or arr[4] == 40
    output("f=", f, end='\n')
