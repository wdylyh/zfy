// zfy 语言基准测试 - zfy 版本
// 五类任务，与 Python/C++/Rust 版本功能等效，输出校验和
// 编译: zfyc build bench.zfy
// 限制记录：顶层不支持 const 常量声明，常量只能放函数内

fn void task1()
    // 构建 0..199999，筛选偶数，求和 + 计数
    let i32 src[]
    for let i32 i = 0,   i < 200000, i++
        src[length(src)] = i
    let i32 evens[]
    for let i64 i = 0,   i < length(src), i++
        if src[i] % 2 == 0
            evens[length(evens)] = src[i]
    let i64 s = 0
    for let i64 i = 0,   i < length(evens), i++
        s += cast(evens[i], i64)
    output("T1 sum=", s, " count=", length(evens))

fn void task2()
    // 筛法：100000 以内素数个数
    let i64 const LCG_A = 1103515245
    let i64 const LCG_C = 12345
    let i64 const LCG_MOD = 2147483647
    let bool comp[100001]
    let i64 cnt = 0
    for let i64 i = 2,   i <= 100000, i++
        if not comp[i]
            cnt++
            let i64 j = i * i
            for j,   j <= 100000, j += i
                comp[j] = true
    // LCG 伪随机 + 插入排序
    let i64 arr[2000]
    let i64 state = 42
    for let i32 k = 0,   k < 2000, k++
        state = (state * LCG_A + LCG_C) % LCG_MOD
        arr[k] = state
    for let i32 i = 1,   i < 2000, i++
        let i64 key = arr[i]
        let i64 j = cast(i, i64) - 1
        // 限制记录：and/or 不短路，arr[-1] 会先求值越界，只能改写循环
        while j >= 0
            if arr[j] > key
                arr[j + 1] = arr[j]
                j--
            else
                break
        arr[j + 1] = key
    output("T2 primes=", cnt, " first=", arr[0], " last=", arr[1999])

fn void task3()
    // 读 n 个整数，逐个 *2，输出
    let i64 n = 0
    input(n)
    let i64 s = 0
    let i64 v = 0
    for let i32 k = 0,   k < cast(n, i32), k++
        v = 0
        input(v)
        v = v * 2
        s += v
        output(v)
    output("T3 sum=", s)

fn void task4()
    // 5 万元素列表，200 轮深拷贝 + 步长切片 + 写
    // 限制记录：列表声明初值不支持整体拷贝（只收逐元素初值），改用数组
    let i32 base[50000]
    for let i32 i = 0,   i < 50000, i++
        base[i] = i
    let i64 acc = 0
    let i64 const LCG_MOD = 2147483647
    for let i32 r = 0,   r < 200, r++
        let i32 cp[50000] = base
        let i32 sl[25000] = base[0, 49998:2]
        let i64 idx = cast(r, i64) % length(sl)
        sl[idx] += r
        acc = (acc + cast(sl[idx], i64)) % LCG_MOD
    output("T4 acc=", acc, " len=", length(base))

fn void task5()
    // 256x256 矩阵乘（一维展开）+ i128 LCG 哈希循环
    let i128 const M1 = 6364136223846793005
    let i128 const M2 = 1442695040888963407
    let i128 const MOD7 = 9223372036854775807
    let f64 a[65536]
    let f64 b[65536]
    let f64 c[65536]
    for let i32 i = 0,   i < 256, i++
        for let i32 j = 0,   j < 256, j++
            a[i * 256 + j] = cast((i * 256 + j) % 97, f64) * 0.5
            b[i * 256 + j] = cast((i + j) % 89, f64) * 0.25
    for let i32 i = 0,   i < 256, i++
        for let i32 k = 0,   k < 256, k++
            let f64 aik = a[i * 256 + k]
            for let i32 j = 0,   j < 256, j++
                c[i * 256 + j] += aik * b[k * 256 + j]
    let f64 tr = 0.0
    for let i32 i = 0,   i < 256, i++
        tr += c[i * 256 + i]
    let i128 hs = 7
    for let i32 k = 0,   k < 5000000, k++
        hs = (hs * M1 + M2) % MOD7
    output("T5 trace=", prec(tr, 17), " hash=", hs)

fn main()
    task1()
    task2()
    task3()
    task4()
    task5()
