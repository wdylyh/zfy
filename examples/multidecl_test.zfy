// 一行多声明器（w-012）：标量/数组/列表/混合
i64 main()
    string a[], b[]
    push(a, "x")
    push(b, "z")
    output(length(a), length(b), sep=',')
    i32 m, n = 5
    output(m, n, sep=',')
    i32 arr1[3], arr2[2] = 7, 8
    arr1[0] = 1
    output(arr1[0], arr2[0], arr2[1], sep=',')
    f64 p = 1.5, q
    output(p, q, sep=',')
    // 同行后续声明器可见前面的名字
    i32 r = 2, s = r * 3
    output(r, s, sep=',')
    return 0
