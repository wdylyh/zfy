struct Student
    string name
    i32 score

// 打印一个学生
void print_student(Student s)
    output(s.name, ": ", s.score)

// 打印学生列表
void print_students(Student[] xs)
    if length(xs) == 0
        output("(empty)")

    i32 i = 0
    while i < length(xs)
        print_student(xs[i])
        i++

// 按分数从高到低排序（简单选择排序）
void sort_students(Student[] xs)
    i32 i = 0
    while i < length(xs)
        i32 best = i
        i32 j = i + 1
        while j < length(xs)
            if xs[j].score > xs[best].score
                best = j
            j++
        if best != i
            Student tmp = xs[i]
            xs[i] = xs[best]
            xs[best] = tmp
        i++

// 查找学生，找不到返回错误值
i32! find_student(Student[] xs, string name)
    i32 i = 0
    while i < length(xs)
        if xs[i].name == name
            return i
        i++
    return fail(ErrCode.NOT_FOUND, "student not found")

// 计算平均分
f32 average(Student[] xs)
    if length(xs) == 0
        return 0.0
    i32 sum = 0
    i32 i = 0
    while i < length(xs)
        sum += xs[i].score
        i++
    return cast(sum, f32) / cast(length(xs), f32)

// 分数转等级
char grade(i32 score)
    if score >= 90
        return 'A'
    if score >= 80
        return 'B'
    if score >= 70
        return 'C'
    if score >= 60
        return 'D'
    return 'F'

// 演示 ?? 值形式与错误传播
void demo_error_handling(Student[] xs)
    i32! maybe = find_student(xs, "Bob")
    i32 idx = maybe ?? -1
    if idx >= 0
        output("Bob found at index ", idx)
    else
        output("Bob not found, default index = ", idx)

    // 使用 ? 传播：函数返回类型必须显式 T!
    // 这里为了演示，单独写一个函数调用。

i32! score_of(Student[] xs, string name)
    i32 idx = find_student(xs, name)?
    return xs[idx].score

// 主函数
void main()
    Student[] xs
    push(xs, Student("Alice", 92))
    push(xs, Student("Bob", 78))
    push(xs, Student("Cara", 85))
    push(xs, Student("Dan", 59))

    output("=== all students ===")
    print_students(xs)

    output("")
    output("=== sorted by score desc ===")
    sort_students(xs)
    print_students(xs)

    output("")
    output("=== average ===")
    output("average = ", average(xs))

    output("")
    output("=== grades ===")
    i32 i = 0
    while i < length(xs)
        output(xs[i].name, " -> ", grade(xs[i].score))
        i++

    output("")
    output("=== error demo ===")
    demo_error_handling(xs)

    i32! s = score_of(xs, "Cara")
    output("Cara score = ", s ?? -1)

    output("")
    output("=== remove Bob ===")
    i32! bob = find_student(xs, "Bob")
    if (bob ?? -1) >= 0
        remove(xs, bob ?? -1)
    print_students(xs)

    output("")
    output("=== string builtins ===")
    string text = "  hello,world,hello  "
    string t = trim(text, ' ')
    output("trimmed = [", t, "]")
    string[] parts = split(t, ',')
    output("split count = ", length(parts))
    i32 k = 0
    while k < length(parts)
        output("part ", k, " = ", parts[k])
        k++
    string r = replace(t, 0, 4, "hi")
    output("replace = ", r)

    output("")
    output("=== char builtins ===")
    char c = 'A'
    output("ord('A') = ", ord(c))
    output("chr(66) = ", chr(66))

    output("")
    output("=== frac demo ===")
    i32 frac f = 3 / 4
    output("frac 3/4 = ", f)

    return 0