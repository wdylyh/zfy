// t01: 类型系统——宽度名、传统别名、type 别名、类型后缀、一行多声明器（grammar.md §3/§4）
type Meter = i64
type Fun = i32(i32)

fn main()
    // 宽度名
    let i8 a = 1
    let u64 b = 2
    let f32 c = 1.5
    let f64 d = 2.5
    // 传统别名归一化
    let i16 e = 3
    let i32 f = 4
    let f64 g = 3.25
    let u64 h = 5
    // type 别名
    let Meter m = 100
    // 类型后缀声明（w-014 #1）
    let i32[] xs = 1, 2, 3
    let i32[3] arr = 7, 8, 9
    let i32[][] nested
    let i32[2][3] grid
    // 传统声明形式对照
    let i32 arr2[4] = 1, 2
    let i32 list3[]
    // 一行多声明器（w-012）
    let i32 p, q = 10
    let i32 r = 2, s = r * 3
    let string sa, sb = "hi"
    let i32 m1[3], m2[2] = 7, 8
    // const/frac/unred 修饰（§4：修饰符在类型后名字前）
    let i32 const k = 42
    let f64 frac fr = 1/2
    let f64 frac unred fu = 6/48
    let i128 frac const lk = 3/9
    // bool/char/string
    let bool flag = true
    let char ch = 'A'
    let string str = "zfy"
    // 泛型实例化类型位置
    output(a, b, c, d, e, f, g, h)
    output(m, xs, arr, p, q, r, s, k)
    output(fr, fu, lk)
    output(flag, ch, str)
    return 0
