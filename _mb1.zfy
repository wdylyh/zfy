// 数学内建探针（v3.2）
fn main()
    output("sqrt(2.0)=", sqrt(2.0))
    output("sqrt(9)=  ", sqrt(9))
    output("log(e)=", log(exp(1.0)))
    output("sin(0)=", sin(0.0))
    output("cos(0)=", cos(0.0))
    output("tan(0)=", tan(0.0))
    output("pow(2,10)=", pow(2.0, 10.0))
    output("floor(3.7)=", floor(3.7))
    output("ceil(3.2)=", ceil(3.2))
    output("abs(-12)=", abs(-12))
    output("abs(34)=", abs(34))
    output("abs(-2.5)=", abs(-2.5))
    let i128 big = -123456789012345678
    output("abs(i128)=", abs(big))
    let u64 un = 99
    output("abs(u64)=", abs(un))
    let f32 f = -1.5
    output("abs(f32->)=", abs(f))
