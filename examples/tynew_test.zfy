// 新类型语法冒烟：i32/u8/f64 单词类型 + 数组 T a[N] + 列表 T a[]
i32 a = 123
f64 b = 12.5
u8 c = 255
i128 big = 9999999999
i32 arr[4] = 1, 2
f64 lst[] = 12.1, 32.33
i32 empty[]

i32 add(i32 x, i32 y)
    return x + y

void show(i32 v[4])
    output(v[0], v[1])

i32 sum(f64 xs[])
    i32 s = 0
    for i32 i = 0, i < length(xs), i++
        s += cast(xs[i], i32)
    return s

void main()
    push(empty, 7)
    push(empty, 8)
    output(a, b, c, big)
    output(arr[0], arr[1], arr[2])
    output(lst[0], lst[1])
    output(length(lst), length(empty))
    output(add(1, 2))
    show(arr)
    output(sum(lst))
