// v3.30 表达式位置 match 测试（return match）
// 覆盖：enum 全覆盖 / enum + _ 兜底 / 标量 + _ / arm 块体（体内显式 return）；
// let 初始化位的 match（既有形态）不回归。

enum Color
    Red
    Green
    Blue

enum Shape
    Empty
    Circle(f64)
    Rect(f64, f64)

// 1) return 位 + enum 全覆盖（无 _ 兜底）
fn string color_name(let Color c)
    return match c
        Color.Red => "red"
        Color.Green => "green"
        Color.Blue => "blue"

// 2) return 位 + enum 部分覆盖 + _ 兜底（载荷绑定在表达式里使用）
fn f64 sq_or_zero(let Shape s)
    return match s
        Shape.Circle(r) => r * r
        _ => 0.0

// 3) return 位 + 标量 scrutinee（字面量模式 + _ 兜底）
fn i32 classify(let i32 n)
    return match n
        0 => 100
        1 => 200
        _ => 300

// 4) return 位 + arm 缩进块体（块内须显式 return）
fn i32 pick(let bool b)
    return match b
        true =>
            let i32 v = 7
            return v * 2
        _ => 0

fn main()
    // return match：enum 全覆盖
    assert_eq(color_name(Color.Red), "red")
    assert_eq(color_name(Color.Green), "green")
    assert_eq(color_name(Color.Blue), "blue")

    // return match：enum + _ 兜底
    assert_eq(sq_or_zero(Shape.Circle(2.0)), 4.0)
    assert_eq(sq_or_zero(Shape.Rect(1.0, 2.0)), 0.0)
    assert_eq(sq_or_zero(Shape.Empty), 0.0)

    // return match：标量 + _
    assert_eq(classify(0), 100)
    assert_eq(classify(1), 200)
    assert_eq(classify(5), 300)

    // return match：arm 块体
    assert_eq(pick(true), 14)
    assert_eq(pick(false), 0)

    // let 初始化位（既有形态，不回归）
    let f64 a = match Shape.Circle(1.0)
        Shape.Circle(r) => 3.0 * r * r
        _ => 0.0
    assert_eq(a, 3.0)

    output("match_expr ok")
