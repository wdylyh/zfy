// examples/plugin_test.zfy —— 插件式组件注册（自定义 WidgetKind + 注册表 + 容器派发）
// 不改 stdlib：示例自定义 kind → register_widget → ui 语句/容器即可绘制与派发
mod gui
mod widgets
use widgets::{App, UI, WidgetKind, WidgetSlot, PaintCtx, Rect,
              register_widget, register_widget_named, unregister_widget, find_widget, has_widget,
              kind_count, kind_id_of_name, kind_name_at, PluginHost,
              a11y_count, a11y_hit, a11y_get, A11yNode, ROLE_BUTTON}
use gui::{Event, EV_LDOWN, EV_LUP, gui_frame_sleep}

// 自定义组件：点一下计数 +1 的"星星"方块
pub struct StarKind
    i32 clicks = 0

    fn i32 kind_id()
        return 7701

    fn i32 measure(let Rect avail)
        return 32

    fn void paint(let PaintCtx c)
        c.fill(c.x, c.y, c.w, c.h, c.th.accentPressed)
        c.border(c.x, c.y, c.w, c.h, c.th.accent)
        c.draw_text(c.x + 8, c.y + 6, c.w - 16, "★", c.th.accent, 16, 1)

    fn bool on_event(let Event e)
        if e.typ == EV_LDOWN
            self.clicks++
            return true
        if e.typ == EV_LUP
            return true
        return false

    fn string a11y_name()
        return "star-widget"

    fn string a11y_role()
        return "button"

    fn string a11y_value()
        return cast(self.clicks, string)

fn main()
    let i32 fails = 0

    // ===== 1) 注册 / 查表 / 重复注册覆盖 =====
    if kind_count() != 0
        output("FAIL registry should start empty")
        fails++
    register_widget_named("star", WidgetKind(StarKind()))
    if not has_widget(7701) or kind_count() != 1
        output("FAIL register")
        fails++
    if kind_id_of_name("star") != 7701
        output("FAIL kind_id_of_name")
        fails++
    if kind_name_at(0) != "star"
        output("FAIL kind_name_at")
        fails++

    // 接口调用（经泛型槽取出实现体后调用）
    let WidgetSlot<WidgetKind> sk = find_widget(7701)
    let WidgetKind kind = copy(sk.v)
    if kind.kind_id() != 7701
        output("FAIL interface kind_id")
        fails++
    if kind.measure(Rect(x=0, y=0, w=200, h=100)) != 32
        output("FAIL interface measure")
        fails++
    if kind.a11y_name() != "star-widget" or kind.a11y_role() != "button"
        output("FAIL interface a11y")
        fails++

    // 重复注册：覆盖旧实现（告警），条数不变
    register_widget_named("star", WidgetKind(StarKind()))
    if kind_count() != 1
        output("FAIL duplicate register should overwrite")
        fails++

    // 未注册 kind：find_widget 返回空实现哨兵
    let WidgetSlot<WidgetKind> nk = find_widget(9999)
    let WidgetKind nkind = copy(nk.v)
    if nkind.kind_id() != 0 or nkind.measure(Rect(x=0, y=0, w=10, h=10)) != 0
        output("FAIL missing kind sentinel")
        fails++

    // 注销 → 重新注册
    unregister_widget(7701)
    if has_widget(7701) or kind_count() != 0
        output("FAIL unregister")
        fails++
    register_widget_named("star", WidgetKind(StarKind()))
    if not has_widget(7701)
        output("FAIL re-register")
        fails++

    // ===== 2) 容器 / ui 语句按注册表查找 =====
    let App app = App()
    if app.open(320, 240, "zfy plugin_test") != 0
        output("FAIL open")
        return 1
    let UI u = UI("star")
    u.pos(20, 20)
    u.size(100, 40)
    u.text("star")
    let i32 k = app.add(u)
    if app.uis[k].which != 999
        output("FAIL ui kind should fall back to plugin registry which=", app.uis[k].which)
        fails++
    if length(app.plugins.nodes) != 1
        output("FAIL plugin node not added")
        fails++

    // 事件派发（接口 on_event 命中返回 true，节点标脏）
    let PluginHost ph = copy(app.plugins)
    let Event pe = Event(typ=EV_LDOWN, x=40, y=35, key=0)
    let bool used = ph.dispatch(pe)
    if not used
        output("FAIL plugin dispatch not consumed")
        fails++
    if not ph.nodes[0].dirty
        output("FAIL plugin node should be dirty after dispatch")
        fails++
    app.plugins = move ph

    // 绘制 + 无障碍快照：有限帧后自动关窗
    let i32 f = 0
    while f < 40 and app.alive()
        app.step()
        gui_frame_sleep(app.t0)
        f++
    if f != 40
        output("FAIL frames=", f)
        fails++
    if a11y_count() < 1
        output("FAIL plugin a11y not published count=", a11y_count())
        fails++
    let i32 hi = a11y_hit(30, 30)
    if hi < 0
        output("FAIL plugin a11y_hit")
        fails++
    else
        let A11yNode hn = a11y_get(hi)
        if hn.role != ROLE_BUTTON or hn.name != "star-widget"
            output("FAIL plugin a11y node name=", hn.name, " role=", hn.role)
            fails++
    app.close()

    if fails == 0
        output("plugin_test: all PASS")
        return 0
    output(fails, " failures")
    return 1
