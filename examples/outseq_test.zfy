// output(数组/列表)（w-013）：整体打印，元素间以 sep 分隔
fn main()
    let i32 nums[] = 1, 2, 3
    output(nums)
    output(nums, sep=',')
    let string words[] = "a", "b", "c"
    output(words)
    let i32 arr[3]
    arr[1] = 5
    output(arr)
    let f64 fs[] = 1.5, 2.5
    output(fs, sep='|')
    let bool bs[] = true, false, true
    output(bs)
    let i32 empty[]
    output(empty, end='.')
    output("done")
    // 与标量混排
    output("n=", nums)
    return 0
