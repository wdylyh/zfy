// T6: 指针链表 + struct（堆分配 100k 节点，遍历求和后逐个释放）
extern "C"
    void* malloc(let u64 n)
    void free(let void* p)

struct Node
    i64 v = 0
    Node* next = null

fn main()
    let Node* head = null
    let i64 n = 100000
    let i64 i = 0
    while i < n
        let Node* p = cast(malloc(cast(sizeof(Node), u64)), Node*)
        p.v = i
        p.next = head
        head = p
        i++
    let i64 s = 0
    let Node* cur = head
    while cur != null
        s += cur.v
        cur = cur.next
    output("T6 sum=", s)
    while head != null
        let Node* nx = head.next
        free(cast(head, void*))
        head = nx
    return 0
