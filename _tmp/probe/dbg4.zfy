mod widgets;
use widgets::{App, UI}
use gui::{gui_frame_sleep}
fn main()
    let App app = App()
    if app.open(300, 250, "d4") != 0
        return 0
    app.t0 = tick_ms()
    let i32 f = 0
    while f < 4 and app.alive()
        app.step()
        ui slider sld
            x 20, y 150, w 280
            value 30
            on_value ->
                output("  FIRE v=", app.uis[app.find_ui("sld")].value, "\n")
        if f == 0
            output("f0: uis.len=", length(app.uis), " v=", app.uis[0].value,
                   " pv=", app.uis[0].p_value, " slv=", app.sliders[0].value, "\n")
        if f == 1
            output("f1: v=", app.uis[0].value, " pv=", app.uis[0].p_value,
                   " slv=", app.sliders[0].value, "\n")
        f++
        gui_frame_sleep(app.t0)
    app.close()
