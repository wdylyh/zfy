// T6: 指针链表 + struct（堆分配 100k 节点，遍历求和后逐个释放）
extern "C"
    void* malloc(u64 n)
    void free(void* p)

struct Node
    i64 v = 0
    Node* next = null

i64 main()
    Node* head = null
    i64 n = 100000
    i64 i = 0
    while i < n
        Node* p = cast(malloc(cast(sizeof(Node), u64)), Node*)
        p.v = i
        p.next = head
        head = p
        i++
    i64 s = 0
    Node* cur = head
    while cur != null
        s += cur.v
        cur = cur.next
    output("T6 sum=", s)
    while head != null
        Node* nx = head.next
        free(cast(head, void*))
        head = nx
    return 0
