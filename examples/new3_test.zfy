// 第三轮改造（new.md）冒烟测试
void main()
    i32 frac unred ur = 6/48
    output(ur, end=' ')                       // 期望 6/48（不约分）
    output("")

    i32 frac a = 6/48
    output(a, end=' ')                        // 期望 1/8（自动约分）
    output("")

    // unred 运算 → 赋给普通 frac 约分（6/48 * 2/4 = 12/192 = 1/16）
    i32 frac ur2 = 2/4
    i32 frac c = ur * ur2
    output(c, end=' ')                        // 期望 1/16
    output("")

    // remove：数组槽位填零值，长度不变
    i64 arr[5] = 1,2,3
    remove(arr, 1)
    output(arr[0], arr[1], arr[2], arr[4], sep=',', end=' ')   // 期望 1,0,3,0
    output(length(arr))                       // 期望 5

    // remove：列表删除并左移
    f64 lst[] = 1.5,2.5,3.5,4.5
    remove(lst, 1)
    output(lst[0], lst[1], lst[2], sep=',', end=' ')   // 期望 1.500000,3.500000,4.500000
    output(length(lst))                       // 期望 3

    // %=
    i64 m = 17
    m %= 5
    output(m, end=' ')                        // 期望 2
    output("")

    // 切片左值复合赋值：区间每个元素原地加 10
    i64 sa[6] = 1,2,3,4,5,6
    sa[1,3] += 10
    output(sa[0], sa[1], sa[2], sa[3], sa[4], sa[5], sep=',', end=' ')  // 期望 1,12,13,14,5,6
    output("")

    // 步长切片复合赋值
    i64 sb[6] = 1,2,3,4,5,6
    sb[0,5:2] *= 3
    output(sb[0], sb[2], sb[4], sep=',', end=' ')   // 期望 3,9,18
    output("")

    // cast 语句重绑定
    f64 pi = 3.75
    cast(pi, i32)
    output(pi, end=' ')                       // 期望 3
    output("")

    // 转义序列新增 \a \b \f \v \r \0
    output("A\tB\vC\aD")

    // find count > 0（未找到产错误值，?? 解包）
    i64 pos = find("hello", 'l', count=2) ?? -1
    output(pos, end=' ')                      // 期望 3
    output("")

    // trim 空子串 / split 空分隔符
    string s0 = "abc"
    output(trim(s0, ""), end='|')             // 期望 abc
    string one[] = split(s0, "")
    output(length(one), end='|')              // 期望 1
    output(one[0], end=' ')                   // 期望 abc
    output("")

    // 孤立 for 头占位变量
    i64 k = 3
    for k, k > 0, k--
        output(k, end=' ')                    // 期望 3 2 1
    output("")

    // const 数组
    i64 const carr[3] = 7,8,9
    output(carr[2], end=' ')                  // 期望 9
    output("")

    // 深拷贝语义
    string s1 = "123"
    string s2 = s1
    s2 += "xyz"
    output(s1, s2, sep='|', end=' ')          // 期望 123|123xyz
    i32 ia[3] = 1,2,3
    i32 ib[3] = ia
    ib[0] = 99
    output(ia[0], ib[0], sep='|', end=' ')    // 期望 1|99
    output("")
