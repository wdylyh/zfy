struct Counter
    i32 n = 0
    i32 step = 1

    fn void bump()
        self.n += self.step

    fn i32 get()
        return self.n

    fn void add(let i32 x)
        self.n += x

fn main()
    let Counter c = Counter(n = 10, step = 2)
    c.bump()
    c.bump()
    output(c.get(), "\n")     // 14
    c.add(6)
    output(c.get(), "\n")     // 20
    let Counter d = Counter(n = 100, step = 5)
    d.bump()
    output(d.get(), " ", c.get(), "\n")   // 105 20 (状态独立)
    return 0
