// 分数字面量树精确折叠（v3.33）：树内 + - * / 编译期按精确有理数折叠，
// 落型复用单字面量期望路径（int=精确后截断/float=实数除/frac=精确/无期望=i32 frac）
fn main()
    let frac g = (1/3) + (2/3)
    output(g)                        // 1/1
    let frac h = (1/3) + (1/3)
    output(h)                        // 2/3
    let frac m = (1/3) * (2/5)
    output(m)                        // 2/15
    let i32 q = (9/4) - (1/4)
    output(q)                        // 2（精确 8/4 截断）
    let f64 x = (1/3) + (2/3)
    output(x)                        // 1.0（实数除，不再 0.0）
    output(cast((1/2) / (3/4), f64)) // 2/3 = 0.666
    output((1/3) == (2/6))           // true（精确比较）
    output((1/3) < (1/2))            // true
    output((1/3) + (2/3))            // 1/1（无期望 → i32 frac）
    output("ok")
