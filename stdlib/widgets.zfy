// stdlib/widgets.zfy —— GUI 组件层（design_gui.md L2，v3.3.8）
//
// 纯 zfy 实现，构建在 gui（L1）之上。核心设计：
//   - **damage 跟踪**：每个组件带 dirty 标志，只有变化的组件在本帧重绘，
//     整帧仅在"本帧有组件重绘"时才 present（BitBlt）——空闲时零拷贝开销
//   - **保留模式**（retained）：App 持有组件数组，每帧一次 app.step() 完成
//     事件分发、状态更新、脏区重绘；业务逻辑读组件状态（clicks/text/value/sel）
//
// 用法：
//   mod widgets;
//   use widgets::{App, Button, InputBox, Slider}
//   fn main()
//       let App app = App()
//       if app.open(480, 360, "demo") != 0
//           return 1
//       let Button btn = Button(x=20, y=20, w=120, h=36, text="点我")
//       app.add_button(btn)
//       while app.alive()
//           app.step()
//           gui_frame_sleep(app.t0)
//       app.close()


use gui::{gui_open, gui_alive, gui_close, gui_w, gui_h, gui_dpi, gui_fill_rect, gui_rect, gui_draw_text, gui_text_w, gui_present, gui_poll, gui_frame_sleep, Event, EV_MOVE, EV_LDOWN, EV_LUP, EV_KEY, EV_WHEEL, KEY_EXT, KEY_CTRL, gui_clip_get}

// ===== 主题配色 =====
pub let u32 const C_BG      = 0x1E1E24   // 窗口背景
pub let u32 const C_PANEL   = 0x2A2A34   // 面板
pub let u32 const C_BORDER  = 0x55555F   // 边框
pub let u32 const C_TEXT    = 0xF0F0F0   // 正文
pub let u32 const C_ACCENT  = 0x2F7FD6   // 强调（焦点/进度）
pub let u32 const C_HOT     = 0x3A8FE8   // 悬停
pub let u32 const C_DOWN    = 0x1F5FA8   // 按下
pub let u32 const C_OK      = 0x3FA060   // 绿

// 界面缩放：96dpi=100。组件内部尺寸一律 逻辑值 * SC() / 100
pub fn i32 SC()
    return gui_dpi() * 100 / 96

// 文本行高（雅黑 16 逻辑px）——按 DPI 缩放后的物理值
fn i32 LH()
    return 22 * SC() / 100

// ===== Label：静态文本 =====
pub struct Label
    i32 x
    i32 y
    string text
    u32 color = C_TEXT
    i32 bg_w = 0         // 清屏宽度：0=按当前文本宽度；文本会变短时设大可防残影
    bool dirty = true

    fn void draw()
        let i32 tw = gui_text_w(self.text)
        let i32 cw = self.bg_w
        if cw <= 0
            cw = tw + 4
        gui_fill_rect(self.x - 2, self.y - 2, cw + 2, LH(), C_BG)
        gui_draw_text(self.x, self.y, self.text, self.color)
        self.dirty = false

// ===== Button：点击计数按钮 =====
pub struct Button
    i32 x
    i32 y
    i32 w
    i32 h
    string text
    bool hot = false
    bool pressed = false
    i32 clicks = 0        // 业务读这个
    bool dirty = true

    fn bool hit(let i32 mx, let i32 my)
        return mx >= self.x and mx < self.x + self.w and my >= self.y and my < self.y + self.h

    fn void set_text(let string t)
        self.text = t
        self.dirty = true

    fn void draw()
        let u32 fill = C_PANEL
        if self.pressed
            fill = C_DOWN
        else
            if self.hot
                fill = C_HOT
        gui_fill_rect(self.x, self.y, self.w, self.h, fill)
        gui_rect(self.x, self.y, self.w, self.h, C_BORDER)
        let i32 tw = gui_text_w(self.text)
        gui_draw_text(self.x + (self.w - tw) / 2, self.y + (self.h - LH()) / 2 + 2 * SC() / 100, self.text, C_TEXT)
        self.dirty = false

// ===== InputBox：单行文本框（点击聚焦，Backspace 退格，按键追加） =====
pub struct InputBox
    i32 x
    i32 y
    i32 w
    string text
    bool focus = false
    bool dirty = true

    fn bool hit(let i32 mx, let i32 my)
        return mx >= self.x and mx < self.x + self.w and my >= self.y and my < self.y + LH() + 8 * SC() / 100

    fn void set_focus(let bool f)
        if self.focus != f
            self.focus = f
            self.dirty = true

    // 返回 true = 本帧有变化
    fn bool handle_key(let i64 k)
        let i64 n = length(self.text)
        if k == 8
            // Backspace：删末字符
            if n > 1
                self.text = self.text[0, n - 2]
                self.dirty = true
                return true
            if n == 1
                self.text = ""
                self.dirty = true
                return true
            return false
        if k >= 32 and k < KEY_EXT
            // 可打印（WM_CHAR 已做 Shift 映射）；中文/全角按 UTF-16 码元追加
            self.text = self.text + cast(k, char)
            self.dirty = true
            return true
        return false

    fn void draw()
        let i32 hh = LH() + 8 * SC() / 100
        gui_fill_rect(self.x, self.y, self.w, hh, C_PANEL)
        if self.focus
            gui_rect(self.x, self.y, self.w, hh, C_ACCENT)
        else
            gui_rect(self.x, self.y, self.w, hh, C_BORDER)
        gui_draw_text(self.x + 6 * SC() / 100, self.y + 5 * SC() / 100, self.text, C_TEXT)
        if self.focus
            let i32 tw = gui_text_w(self.text)
            gui_fill_rect(self.x + 8 * SC() / 100 + tw, self.y + 5 * SC() / 100, 2 * SC() / 100, LH() - 4 * SC() / 100, C_TEXT)
        self.dirty = false

// ===== Slider：拖动滑块，value 0..100 =====
pub struct Slider
    i32 x
    i32 y
    i32 w
    i32 value = 0        // 业务读这个（0..100）
    bool dragging = false
    bool dirty = true

    fn void set_value(let i32 v)
        let i32 vv = v
        if vv < 0
            vv = 0
        if vv > 100
            vv = 100
        if vv != self.value
            self.value = vv
            self.dirty = true

    // 命中判定（含上下 6px 容差）
    fn bool hit_wide(let i32 mx, let i32 my)
        return mx >= self.x and mx < self.x + self.w and my >= self.y - 6 * SC() / 100 and my < self.y + 26 * SC() / 100

    fn void draw()
        let i32 u = SC()
        gui_fill_rect(self.x, self.y + 8 * u / 100, self.w, 4 * u / 100, C_PANEL)
        gui_rect(self.x, self.y + 8 * u / 100, self.w, 4 * u / 100, C_BORDER)
        let i32 fx = self.x + (self.w - 2 * u / 100) * self.value / 100
        if fx > self.x
            gui_fill_rect(self.x, self.y + 8 * u / 100, fx - self.x, 4 * u / 100, C_ACCENT)
        if self.dragging
            gui_fill_rect(fx - 5 * u / 100, self.y, 10 * u / 100, 20 * u / 100, C_HOT)
        else
            gui_fill_rect(fx - 5 * u / 100, self.y, 10 * u / 100, 20 * u / 100, C_ACCENT)
        self.dirty = false

// ===== ProgressBar：进度条 =====
pub struct ProgressBar
    i32 x
    i32 y
    i32 w
    i32 value = 0
    u32 color = C_OK
    bool dirty = true

    fn void set_value(let i32 v)
        let i32 vv = v
        if vv < 0
            vv = 0
        if vv > 100
            vv = 100
        if vv != self.value
            self.value = vv
            self.dirty = true

    fn void draw()
        let i32 u = SC()
        gui_fill_rect(self.x, self.y, self.w, 18 * u / 100, C_PANEL)
        gui_rect(self.x, self.y, self.w, 18 * u / 100, C_BORDER)
        let i32 fw = (self.w - 4 * u / 100) * self.value / 100
        if fw > 0
            gui_fill_rect(self.x + 2 * u / 100, self.y + 2 * u / 100, fw, 14 * u / 100, self.color)
        self.dirty = false

// ===== ListBox：字符串列表（滚轮滚动，点击选中） =====
pub struct ListBox
    i32 x
    i32 y
    i32 w
    i32 rows             // 可见行数
    string[] items
    i32 sel = -1         // 业务读这个（-1 未选）
    i32 top = 0          // 滚动偏移（首行下标）
    bool dirty = true

    fn void clear()
        self.items = self.items[0, 0]
        self.sel = -1
        self.top = 0
        self.dirty = true

    fn void add_item(let string s)
        self.items = push(self.items, s)
        self.dirty = true

    fn void scroll(let i32 d)
        let i32 n = length(self.items)
        let i32 nt = self.top + d
        if nt < 0
            nt = 0
        if n > self.rows
            if nt > n - self.rows
                nt = n - self.rows
        else
            nt = 0
        if nt != self.top
            self.top = nt
            self.dirty = true

    fn void draw()
        let i32 hgt = self.rows * LH() + 8 * SC() / 100
        gui_fill_rect(self.x, self.y, self.w, hgt, C_PANEL)
        gui_rect(self.x, self.y, self.w, hgt, C_BORDER)
        let i32 n = length(self.items)
        let i32 last = self.top + self.rows
        if last > n
            last = n
        let i32 i = self.top
        while i < last
            let i32 row = i - self.top
            let i32 ry = self.y + 4 * SC() / 100 + row * LH()
            if i == self.sel
                gui_fill_rect(self.x + 2 * SC() / 100, ry - 1, self.w - 4 * SC() / 100, LH(), C_ACCENT)
                gui_draw_text(self.x + 8 * SC() / 100, ry, self.items[i], 0xFFFFFF)
            else
                gui_draw_text(self.x + 8 * SC() / 100, ry, self.items[i], C_TEXT)
            i++
        self.dirty = false

// ===== App：应用容器 + 事件循环骨架 =====
pub struct App
    Label[] labels
    Button[] buttons
    InputBox[] inputs
    Slider[] sliders
    ProgressBar[] bars
    ListBox[] lists
    TextArea[] texts
    Checkbox[] checks
    Menu[] menus
    bool menu_dirty = false
    i32 mx = -1
    i32 my = -1
    bool ldown = false
    bool ldown_prev = false
    bool quit = false
    bool any_dirty = false
    i64 t0 = 0           // 帧起点（gui_frame_sleep 用）

    fn i32 open(let i32 w, let i32 h, let string title)
        let i32 r = gui_open(w, h, title)
        if r != 0
            return r
        gui_fill_rect(0, 0, gui_w(), gui_h(), C_BG)
        gui_present()
        self.t0 = tick_ms()
        return 0

    fn bool alive()
        return gui_alive() and not self.quit

    fn void close()
        gui_close()

    // add_* 返回组件索引（v3.5 DX）：App 为值语义容器——add 进去的是副本，
    // 之后业务读写一律走 app.xxx[idx].field，不要读局部变量
    fn i32 add_label(let Label l)
        self.labels = push(self.labels, l)
        return length(self.labels) - 1

    fn i32 add_button(let Button b)
        self.buttons = push(self.buttons, b)
        return length(self.buttons) - 1

    fn i32 add_input(let InputBox ib)
        self.inputs = push(self.inputs, ib)
        return length(self.inputs) - 1

    fn i32 add_slider(let Slider s)
        self.sliders = push(self.sliders, s)
        return length(self.sliders) - 1

    fn i32 add_bar(let ProgressBar p)
        self.bars = push(self.bars, p)
        return length(self.bars) - 1

    fn i32 add_list(let ListBox lb)
        self.lists = push(self.lists, lb)
        return length(self.lists) - 1

    fn i32 add_text(let TextArea t)
        self.texts = push(self.texts, t)
        return length(self.texts) - 1

    fn i32 add_checkbox(let Checkbox c)
        self.checks = push(self.checks, c)
        return length(self.checks) - 1

    fn i32 add_menu(let Menu m)
        self.menus = push(self.menus, m)
        self.menu_dirty = true
        return length(self.menus) - 1

    // 关闭全部下拉（点击空白/打开新菜单/选中项后调用）
    fn void close_menus()
        let i32 i = 0
        while i < length(self.menus)
            if self.menus[i].open
                self.menus[i].open = false
                self.menus[i].dirty = true
            i++
        if self.menu_dirty == false
            self.menu_dirty = true

    // 菜单栏高度（物理 px）
    fn i32 menu_bar_h()
        return LH() + 6 * SC() / 100

    // 任意组件标脏（业务侧主动刷新用）
    fn void invalidate_all()
        let i32 i = 0
        while i < length(self.labels)
            self.labels[i].dirty = true
            i++
        i = 0
        while i < length(self.buttons)
            self.buttons[i].dirty = true
            i++
        i = 0
        while i < length(self.inputs)
            self.inputs[i].dirty = true
            i++
        i = 0
        while i < length(self.sliders)
            self.sliders[i].dirty = true
            i++
        i = 0
        while i < length(self.bars)
            self.bars[i].dirty = true
            i++
        i = 0
        while i < length(self.lists)
            self.lists[i].dirty = true
            i++
        i = 0
        while i < length(self.texts)
            self.texts[i].dirty = true
            i++
        i = 0
        while i < length(self.checks)
            self.checks[i].dirty = true
            i++
        self.menu_dirty = true

    // 一帧：泵事件 → 更新 → 脏区重绘 → 按需 present
    fn void step()
        self.t0 = tick_ms()                // 帧起点（gui_frame_sleep 依赖每帧刷新）
        self.any_dirty = false
        let Event e = Event()
        while gui_poll(ref e)
            if e.typ == EV_MOVE
                self.mx = cast(e.x, i32)
                self.my = cast(e.y, i32)
                self.on_hover()
                let i32 mi = 0
                while mi < length(self.menus)
                    if self.menus[mi].open
                        self.menu_dirty = true
                    mi++
            if e.typ == EV_LDOWN or e.typ == EV_LUP
                self.mx = cast(e.x, i32)
                self.my = cast(e.y, i32)
                self.ldown = e.typ == EV_LDOWN
                self.on_click()
            if e.typ == EV_WHEEL
                let i32 i = 0
                while i < length(self.lists)
                    self.lists[i].scroll(cast(e.key, i32))
                    if self.lists[i].dirty
                        self.any_dirty = true
                    i++
                i = 0
                while i < length(self.texts)
                    self.texts[i].scroll(cast(e.key, i32))
                    if self.texts[i].dirty
                        self.any_dirty = true
                    i++
            if e.typ == EV_KEY
                self.on_key(cast(e.key, i64))
        // 拖动持续更新（按住不放也跟随）
        let i32 si = 0
        while si < length(self.sliders)
            if self.sliders[si].dragging and self.ldown
                self.sliders[si].set_value((self.mx - self.sliders[si].x) * 100 / (self.sliders[si].w - 2))
            if self.sliders[si].dirty
                self.any_dirty = true
            si++
        self.ldown_prev = self.ldown
        // 重绘脏组件
        self.flush_dirty()
        if self.any_dirty
            gui_present()

    fn void on_hover()
        let i32 i = 0
        while i < length(self.buttons)
            let bool h = self.buttons[i].hit(self.mx, self.my) and not self.ldown
            if h != self.buttons[i].hot
                self.buttons[i].hot = h
                self.buttons[i].dirty = true
            i++
        i = 0
        while i < length(self.checks)
            let bool hc = self.checks[i].hit(self.mx, self.my) and not self.ldown
            if hc != self.checks[i].hot
                self.checks[i].hot = hc
                self.checks[i].dirty = true
            i++

    fn void on_click()
        let bool press = self.ldown and not self.ldown_prev
        let bool release = not self.ldown and self.ldown_prev
        // ---- 菜单栏（优先于一切组件） ----
        if press and length(self.menus) > 0
            let i32 mbh = self.menu_bar_h()
            let bool in_bar = self.my < mbh
            let bool handled = false
            let i32 mi = 0
            // 下拉打开时：条目命中 > 其他标题 > 空白关闭
            mi = 0
            while mi < length(self.menus)
                if self.menus[mi].open
                    let i32 it = self.menu_item_at(mi, self.mx, self.my)
                    if it >= 0
                        self.menus[mi].sel = it
                        self.menus[mi].clicks++
                        self.menus[mi].open = false
                        self.menus[mi].dirty = true
                        self.menu_dirty = true
                        handled = true
                mi++
            if not handled and in_bar
                mi = 0
                while mi < length(self.menus)
                    if self.mx >= self.menus[mi].x and self.mx < self.menus[mi].x + self.menus[mi].tw
                        let bool was = self.menus[mi].open
                        self.close_menus()
                        self.menus[mi].open = not was
                        self.menus[mi].dirty = true
                        self.menu_dirty = true
                        handled = true
                    mi++
            if not handled
                self.close_menus()
            self.ldown_prev = self.ldown
            return
        // 输入框聚焦：press 时先全部失焦（inputs 与 texts 互斥），再按命中恢复
        let i32 i = 0
        if press
            i = 0
            while i < length(self.inputs)
                self.inputs[i].set_focus(false)
                i++
            i = 0
            while i < length(self.texts)
                self.texts[i].set_focus(false)
                i++
        i = 0
        while i < length(self.inputs)
            if press
                self.inputs[i].set_focus(self.inputs[i].hit(self.mx, self.my))
            if self.inputs[i].dirty
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.texts)
            if press
                self.texts[i].set_focus(self.texts[i].hit(self.mx, self.my))
                if self.texts[i].focus
                    self.texts[i].place_cursor(self.mx, self.my)
            if self.texts[i].dirty
                self.any_dirty = true
            i++
        // 复选框
        i = 0
        while i < length(self.checks)
            let bool inside = self.checks[i].hit(self.mx, self.my)
            if press and inside
                self.checks[i].pressed = true
                self.checks[i].dirty = true
            if release and self.checks[i].pressed
                self.checks[i].pressed = false
                self.checks[i].checked = not self.checks[i].checked
                self.checks[i].clicks++
                self.checks[i].dirty = true
            if self.checks[i].dirty
                self.any_dirty = true
            i++
        // 按钮
        i = 0
        while i < length(self.buttons)
            let bool inside = self.buttons[i].hit(self.mx, self.my)
            if press and inside
                self.buttons[i].pressed = true
                self.buttons[i].dirty = true
            if release and self.buttons[i].pressed
                self.buttons[i].pressed = false
                self.buttons[i].dirty = true
                if inside
                    self.buttons[i].clicks++
            if self.buttons[i].dirty
                self.any_dirty = true
            i++
        // 滑块：左键按下进入拖动，抬起结束
        i = 0
        while i < length(self.sliders)
            if press and self.sliders[i].hit_wide(self.mx, self.my)
                self.sliders[i].dragging = true
                self.sliders[i].set_value((self.mx - self.sliders[i].x) * 100 / (self.sliders[i].w - 2))
            if release
                self.sliders[i].dragging = false
            if self.sliders[i].dirty
                self.any_dirty = true
            i++
        // 列表选中
        i = 0
        while i < length(self.lists)
            if press and self.mx >= self.lists[i].x and self.mx < self.lists[i].x + self.lists[i].w
                let i32 rows = length(self.lists[i].items)
                let i32 hgt = self.lists[i].rows * LH() + 8 * SC() / 100
                if self.my >= self.lists[i].y and self.my < self.lists[i].y + hgt
                    let i32 row = (self.my - self.lists[i].y - 4 * SC() / 100) / LH()
                    let i32 idx = self.lists[i].top + row
                    if row >= 0 and idx < rows
                        self.lists[i].sel = idx
                        self.lists[i].dirty = true
            if self.lists[i].dirty
                self.any_dirty = true
            i++
        // 边沿状态推进：每次鼠标事件处理后更新（合成 press/release
        // 与真实事件流都依赖此序——press 后紧跟 release 才可检出）
        self.ldown_prev = self.ldown

    fn void on_key(let i64 k)
        let i32 i = 0
        while i < length(self.inputs)
            if self.inputs[i].focus
                if self.inputs[i].handle_key(k)
                    self.any_dirty = true
            i++
        i = 0
        while i < length(self.texts)
            if self.texts[i].focus
                if self.texts[i].handle_key(k)
                    self.any_dirty = true
            i++

    // 下拉菜单条目命中：返回条目索引（-1 = 未命中）
    fn i32 menu_item_at(let i32 mi, let i32 px, let i32 py)
        let i32 u = SC()
        let i32 mbh = LH() + 6 * u / 100
        let i32 iw = self.menu_item_w(mi)
        let i32 ih = LH() + 4 * u / 100
        let i32 n = length(self.menus[mi].items)
        let i32 i = 0
        while i < n
            let i32 iy = mbh + i * ih
            if px >= self.menus[mi].x and px < self.menus[mi].x + iw and py >= iy and py < iy + ih
                return i
            i++
        return -1

    // 下拉面板宽度（最长条目 + 内边距）
    fn i32 menu_item_w(let i32 mi)
        let i32 u = SC()
        let i32 iw = 0
        let i32 i = 0
        while i < length(self.menus[mi].items)
            let i32 twi = gui_text_w(self.menus[mi].items[i])
            if twi > iw
                iw = twi
            i++
        return iw + 24 * u / 100

    // 布局菜单标题横向位置（加菜单/改标题后调用一次即可；draw 也会自愈）
    fn void layout_menus()
        let i32 u = SC()
        let i32 px = 6 * u / 100
        let i32 i = 0
        while i < length(self.menus)
            self.menus[i].x = px
            self.menus[i].tw = gui_text_w(self.menus[i].title) + 16 * u / 100
            px = px + self.menus[i].tw
            self.menus[i].dirty = true
            i++
        self.menu_dirty = true

    fn void draw_menu_bar()
        let i32 u = SC()
        let i32 mbh = LH() + 6 * u / 100
        if length(self.menus) == 0
            return
        // 自愈布局（v3.5 DX）：任一菜单 tw<=0（未调 layout_menus）时先补齐
        // 标题 x/tw——否则标题画得出（gui_draw_text 不用 tw）却点不中（命中用 x+tw）
        let i32 nl = 0
        while nl < length(self.menus)
            if self.menus[nl].tw <= 0
                self.layout_menus()
                break
            nl++
        let i32 nopen = 0
        let i32 i = 0
        while i < length(self.menus)
            if self.menus[i].open
                nopen++
            i++
        if self.menu_dirty or nopen > 0
            gui_fill_rect(0, 0, gui_w(), mbh, C_PANEL)
            gui_fill_rect(0, mbh - 1, gui_w(), 1, C_BORDER)
            i = 0
            while i < length(self.menus)
                let Menu m = self.menus[i]
                let bool hot = self.my < mbh and self.mx >= m.x and self.mx < m.x + m.tw
                if m.open
                    gui_fill_rect(m.x, 0, m.tw, mbh, C_HOT)
                else
                    if hot
                        gui_fill_rect(m.x, 0, m.tw, mbh, C_PANEL)
                gui_draw_text(m.x + 8 * u / 100, 4 * u / 100, m.title, C_TEXT)
                i++
            // 下拉面板（打开时覆盖在内容之上，最后画）
            i = 0
            while i < length(self.menus)
                if self.menus[i].open
                    let i32 iw = self.menu_item_w(i)
                    let i32 ih = LH() + 4 * u / 100
                    let i32 n = length(self.menus[i].items)
                    gui_fill_rect(self.menus[i].x, mbh, iw, n * ih + 4 * u / 100, C_PANEL)
                    gui_rect(self.menus[i].x, mbh, iw, n * ih + 4 * u / 100, C_BORDER)
                    let i32 j = 0
                    while j < n
                        let i32 iy = mbh + j * ih
                        let bool hov = self.mx >= self.menus[i].x and self.mx < self.menus[i].x + iw and self.my >= iy and self.my < iy + ih
                        if hov
                            gui_fill_rect(self.menus[i].x + 1, iy, iw - 2, ih, C_HOT)
                        gui_draw_text(self.menus[i].x + 12 * u / 100, iy + 2 * u / 100,
                                      self.menus[i].items[j], C_TEXT)
                        j++
                i++
            self.menu_dirty = false

    fn void flush_dirty()
        self.draw_menu_bar()
        let i32 i = 0
        while i < length(self.labels)
            if self.labels[i].dirty
                self.labels[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.buttons)
            if self.buttons[i].dirty
                self.buttons[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.inputs)
            if self.inputs[i].dirty
                self.inputs[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.sliders)
            if self.sliders[i].dirty
                self.sliders[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.bars)
            if self.bars[i].dirty
                self.bars[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.lists)
            if self.lists[i].dirty
                self.lists[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.texts)
            if self.texts[i].dirty
                self.texts[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.checks)
            if self.checks[i].dirty
                self.checks[i].draw()
                self.any_dirty = true
            i++


// ===== 字符串辅助（TextArea 用；按 UTF-8 字节索引，闭区间切片） =====

// 前 i 字节（i<=0 得空串）
fn string prefix(let string s, let i32 i)
    if i <= 0
        return ""
    return s[0, i - 1]

// 从第 i 字节到串尾（i>=len 得空串）
fn string suffix(let string s, let i32 i)
    let i32 n = length(s)
    if i >= n
        return ""
    return s[i, n - 1]

// s[i] 是否 UTF-8 continuation 字节（0x80..0xBF；ord 返回有符号字节值，即 -128..-65）
fn bool is_cont(let string s, let i32 i)
    if i < 0 or i >= length(s)
        return false
    let i32 b = ord(s[i])
    return b <= -65

// 从位置 i 向前对齐到码点起点
fn i32 align_back(let string s, let i32 i)
    let i32 p = i
    while p > 0 and is_cont(s, p)
        p--
    return p

// 从位置 i 向后对齐到下一码点起点
fn i32 align_fwd(let string s, let i32 i)
    let i32 n = length(s)
    let i32 q = i
    while q < n and is_cont(s, q)
        q++
    return q

// ===== Checkbox：复选框 =====
// ===== Menu：菜单栏下拉菜单（App.add_menu 挂载；sel/clicks 业务读取） =====
pub struct Menu
    string title
    string[] items
    i32 x = 0            // 标题左起点（layout_menus 布局）
    i32 tw = 0           // 标题宽
    i32 sel = -1         // 最后选中的条目索引
    i32 clicks = 0       // 选中任一条目时 ++（业务对比差值）
    bool open = false
    bool dirty = true

pub struct Checkbox
    i32 x
    i32 y
    string text
    bool checked = false      // 业务读写
    bool hot = false
    bool pressed = false
    i32 clicks = 0
    bool dirty = true

    fn i32 box_size()
        return 16 * SC() / 100

    fn bool hit(let i32 mx, let i32 my)
        let i32 bs = self.box_size()
        let i32 tw = gui_text_w(self.text)
        let i32 wfull = bs + 6 * SC() / 100 + tw
        let i32 hfull = bs
        if bs < LH()
            hfull = LH()
        return mx >= self.x and mx < self.x + wfull and my >= self.y and my < self.y + hfull

    fn void draw()
        let i32 u = SC()
        let i32 bs = self.box_size()
        let u32 fill = C_PANEL
        if self.pressed
            fill = C_DOWN
        else
            if self.hot
                fill = C_HOT
        gui_fill_rect(self.x, self.y, bs, bs, fill)
        gui_rect(self.x, self.y, bs, bs, C_BORDER)
        if self.checked
            gui_draw_text(self.x + 2 * u / 100, self.y - 2 * u / 100, "✓", C_OK)
        let i32 ty = self.y + (bs - LH()) / 2
        gui_draw_text(self.x + bs + 6 * u / 100, ty, self.text, C_TEXT)
        self.dirty = false

// ===== TextArea：多行文本编辑 =====
// 光标（字节列 cx / 行 cy）、Enter 拆行、Backspace 合行、方向键/Home/End/
// Delete、滚轮滚动、Ctrl+V 粘贴（剪贴板 \n 拆行插入）。超宽行按像素截断。
pub struct TextArea
    i32 x
    i32 y
    i32 w
    i32 h
    string[] lines
    i32 cx = 0            // 光标字节列
    i32 cy = 0            // 光标行
    i32 top = 0           // 首可见行
    bool focus = false
    bool dirty = true

    fn i32 vis_rows()
        let i32 vr = (self.h - 8 * SC() / 100) / LH()
        if vr < 1
            vr = 1
        return vr

    fn void scroll(let i32 d)
        let i32 vr = self.vis_rows()
        let i32 n = length(self.lines)
        let i32 nt = self.top + d
        if nt < 0
            nt = 0
        if n > vr
            if nt > n - vr
                nt = n - vr
        else
            nt = 0
        if nt != self.top
            self.top = nt
            self.dirty = true

    fn void clamp_scroll()
        let i32 vr = self.vis_rows()
        if self.cy < self.top
            self.top = self.cy
        if self.cy >= self.top + vr
            self.top = self.cy - vr + 1
        if self.top < 0
            self.top = 0
        self.dirty = true

    fn void set_text(let string s)
        self.lines = split(s, "\n")
        let i32 i = 0
        while i < length(self.lines)
            self.lines[i] = trim(self.lines[i], "\r")
            i++
        self.cx = 0
        self.cy = 0
        self.top = 0
        self.dirty = true

    fn string text()
        let string s2 = ""
        let i32 i = 0
        while i < length(self.lines)
            if i > 0
                s2 = s2 + "\n"
            s2 = s2 + self.lines[i]
            i++
        return s2

    fn bool hit(let i32 mx, let i32 my)
        return mx >= self.x and mx < self.x + self.w and my >= self.y and my < self.y + self.h

    fn void set_focus(let bool f)
        if self.focus != f
            self.focus = f
            self.dirty = true

    // 鼠标点击定位光标（空 lines 时自动初始化为单空行，v3.5 DX 防越界）
    fn void place_cursor(let i32 mx, let i32 my)
        if length(self.lines) == 0
            self.set_text("")
        let i32 pad = 4 * SC() / 100
        let i32 row = (my - self.y - pad) / LH()
        if row < 0
            row = 0
        self.cy = self.top + row
        let i32 nl = length(self.lines)
        if self.cy >= nl
            self.cy = nl - 1
        let string ln = self.lines[self.cy]
        let i32 target = mx - self.x - pad
        let i32 i = 0
        let i32 best = 0
        while i < length(ln)
            if gui_text_w(prefix(ln, i)) > target
                break
            best = i
            i = align_fwd(ln, i)
            if i == best
                i++
        self.cx = best
        self.clamp_scroll()

    // 替换第 cy 行并重建数组的通用入口都不需要——直接改 self.lines[cy]
    // 光标处插入多行文本（\n 拆行；空串无操作），供 Ctrl+V 与业务侧复用
    fn void insert_at_cursor(let string clip)
        if length(self.lines) == 0
            self.set_text("")
        let i32 nl = length(self.lines)
        let string ln = self.lines[self.cy]
        if clip != ""
            let string[] segs = split(clip, "\n")
            let i32 ns = length(segs)
            let i32 i = 0
            while i < ns
                segs[i] = trim(segs[i], "\r")
                i++
            segs[0] = prefix(ln, self.cx) + segs[0]
            segs[ns - 1] = segs[ns - 1] + suffix(ln, self.cx)
            // lines[0..cy-1] + segs + lines[cy+1..]（占位首元素后裁掉）
            let string[] out = self.lines[0, 0]
            i = 0
            while i < self.cy
                out = push(out, self.lines[i])
                i++
            i = 0
            while i < ns
                out = push(out, segs[i])
                i++
            i = self.cy + 1
            while i < nl
                out = push(out, self.lines[i])
                i++
            self.lines = out[1, length(out) - 1]
            self.cy = self.cy + ns - 1
            self.cx = length(segs[ns - 1]) - length(suffix(ln, self.cx))
        self.clamp_scroll()

    fn bool handle_key(let i64 k)
        if length(self.lines) == 0
            self.set_text("")
        let i32 nl = length(self.lines)
        let string ln = self.lines[self.cy]
        let i32 n = length(ln)
        if k == 8
            // Backspace：删光标前一码点；行首则与上一行合并
            if self.cx > 0
                let i32 s2 = align_back(ln, self.cx - 1)
                self.lines[self.cy] = prefix(ln, s2) + suffix(ln, self.cx)
                self.cx = s2
            else
                if self.cy > 0
                    let i32 pn = length(self.lines[self.cy - 1])
                    self.lines[self.cy - 1] = self.lines[self.cy - 1] + ln
                    let string[] out = self.lines[0, 0]
                    let i32 i = 0
                    while i < nl
                        if i != self.cy
                            out = push(out, self.lines[i])
                        i++
                    self.lines = out[1, length(out) - 1]
                    self.cy--
                    self.cx = pn
            self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x2E
            // Delete：删光标处码点；行尾则吞并下一行
            if self.cx < n
                let i32 e2 = align_fwd(ln, self.cx + 1)
                self.lines[self.cy] = prefix(ln, self.cx) + suffix(ln, e2)
            else
                if self.cy < nl - 1
                    self.lines[self.cy] = ln + self.lines[self.cy + 1]
                    let string[] out = self.lines[0, 0]
                    let i32 i = 0
                    while i < nl
                        if i != self.cy + 1
                            out = push(out, self.lines[i])
                        i++
                    self.lines = out[1, length(out) - 1]
            self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x25
            // Left
            if self.cx > 0
                self.cx = align_back(ln, self.cx - 1)
            else
                if self.cy > 0
                    self.cy--
                    self.cx = length(self.lines[self.cy])
            self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x27
            // Right
            if self.cx < n
                self.cx = align_fwd(ln, self.cx + 1)
            else
                if self.cy < nl - 1
                    self.cy++
                    self.cx = 0
            self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x26
            // Up
            if self.cy > 0
                self.cy--
                if self.cx > length(self.lines[self.cy])
                    self.cx = length(self.lines[self.cy])
                self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x28
            // Down
            if self.cy < nl - 1
                self.cy++
                if self.cx > length(self.lines[self.cy])
                    self.cx = length(self.lines[self.cy])
                self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x24
            self.cx = 0
            self.dirty = true
            return true
        if k == KEY_EXT + 0x23
            self.cx = n
            self.dirty = true
            return true
        if k == KEY_CTRL + 86 or k == 22
            // Ctrl+V 粘贴（86='V'；22=0x16 为 WM_CHAR 控制码兜底）
            self.insert_at_cursor(gui_clip_get())
            return true
        if k == 13 or k == 10
            // Enter：光标处拆行
            let string head = prefix(ln, self.cx)
            let string tail = suffix(ln, self.cx)
            let string[] out = self.lines[0, 0]
            let i32 i = 0
            while i < self.cy
                out = push(out, self.lines[i])
                i++
            out = push(out, head)
            out = push(out, tail)
            i = self.cy + 1
            while i < nl
                out = push(out, self.lines[i])
                i++
            self.lines = out[1, length(out) - 1]
            self.cy++
            self.cx = 0
            self.clamp_scroll()
            return true
        if k >= 32 and k < KEY_EXT
            // 可打印（含中文，WM_CHAR UTF-16 码元）：光标处插入
            self.lines[self.cy] = prefix(ln, self.cx) + cast(k, char) + suffix(ln, self.cx)
            self.cx = self.cx + length("" + cast(k, char))
            self.clamp_scroll()
            return true
        return false

    fn void draw()
        let i32 u = SC()
        let i32 pad = 4 * u / 100
        gui_fill_rect(self.x, self.y, self.w, self.h, C_PANEL)
        if self.focus
            gui_rect(self.x, self.y, self.w, self.h, C_ACCENT)
        else
            gui_rect(self.x, self.y, self.w, self.h, C_BORDER)
        let i32 vr = self.vis_rows()
        let i32 nl = length(self.lines)
        let i32 last = self.top + vr
        if last > nl
            last = nl
        let i32 avail = self.w - 2 * pad
        let i32 i = self.top
        while i < last
            let i32 ry = self.y + pad + (i - self.top) * LH()
            let string ln = self.lines[i]
            // 超宽行按像素截断（对齐码点）
            let i32 cnt = length(ln)
            while cnt > 0 and gui_text_w(prefix(ln, cnt)) > avail
                cnt = align_back(ln, cnt - 1)
            if cnt > 0
                gui_draw_text(self.x + pad, ry, prefix(ln, cnt), C_TEXT)
            i++
        // 光标
        if self.focus
            if self.cy >= self.top and self.cy < last
                let string ln2 = self.lines[self.cy]
                let i32 cxx = gui_text_w(prefix(ln2, self.cx))
                gui_fill_rect(self.x + pad + cxx, self.y + pad + (self.cy - self.top) * LH(), 2 * u / 100, LH(), C_TEXT)
        self.dirty = false
