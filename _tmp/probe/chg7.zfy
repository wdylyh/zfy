mod widgets;
use widgets::{App, UI}
use gui::{gui_frame_sleep}
fn main()
    let App app = App()
    if app.open(320, 260, "c7") != 0
        return 0
    app.t0 = tick_ms()
    let i32 f = 0
    while f < 4 and app.alive()
        app.step()
        ui input box
            x 20, y 100, w 280
            on_change ->
                output("CHG fires\n")
        ui list lst
            x 20, y 130, w 200, rows 3
            items "a", "b"
            on_select ->
                output("SEL fires\n")
        ui input box2
            x 20, y 100, w 280
            on_input ->
                output("IN2 fires\n")
        if f == 1
            app.inputs[0].set_focus(true)
            app.on_key(65)
            app.lists[0].sel = 1
        f++
        gui_frame_sleep(app.t0)
    app.close()
