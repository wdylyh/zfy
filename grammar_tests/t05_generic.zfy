// t05: 泛型——泛型函数 + 泛型 struct 实例化（grammar.md §3/§5/§9）
struct Box<T>
    T v

fn <T> T first(let T a, let T b)
    return a

fn <T> T pick(let T a, let T b, let T c)
    return c

fn Box<i32> make_box(let i32 x)
    return Box(x)

fn main()
    let Box<i32> b = Box(7)
    let Box<i32> c = make_box(11)
    b.v += 3
    output(b.v, c.v)
    // 嵌套实例
    let Box<Box<i32>> n = Box(Box(4))
    output(n.v.v)
    // 泛型函数推断
    let i32 f1 = first(1, 2)
    let string f2 = first("a", "b")
    let i32 p = pick(1, 2, 3)
    output(f1, f2, p)
    return 0
