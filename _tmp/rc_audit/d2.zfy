// 定位变体 d2：push + remove（无下标覆盖/整体赋值）
interface Shape
    fn i64 area()

struct Sq
    i64 v = 0
    fn i64 area()
        return self.v

fn main()
    let Shape[] xs
    let i64 i = 0
    while i < 5
        xs = push(xs, Shape(Sq(i)))
        i = i + 1
    let Shape r = remove(xs, 4)
    output(r.area())
    output(length(xs))
    output("d2 ok")
