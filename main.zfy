// 单文件综合演示：zfy 语言特性

i32 const MAXN = 8

type IntPtr = i32*

struct Point
    f64 x = 0.0
    f64 y = 0.0

struct Box<T>
    T v

<T> T min_of(T a, T b)
    if a < b
        return a
    return b

i32! safe_div(i32 a, i32 b)
    if b == 0
        return fail(ErrCode.DIV_ZERO, "division by zero")
    return a / b

void add_to(i32 ref acc, i32 n)
    acc += n

void main()
    i32 n = 10
    i64 big = n
    output("n =", n, "big =", big)

    i32 arr[MAXN] = 1, 2, 3
    f64 xs[] = 1.5, 2.5, 3.5
    push(xs, 4.5)
    output("len(arr) =", length(arr), "len(xs) =", length(xs))
    output("xs[0] =", xs[0], "xs[3] =", xs[3])

    i32 sum = 0
    for i32 i = 0, i < length(arr), i++
        sum += arr[i]
    output("sum(arr) =", sum)

    Point p = Point(x=1.0, y=2.0)
    p.y += 3.0
    output("p =", p.x, p.y)

    Box<i32> bi = Box(7)
    Box<f64> bf = Box(2.5)
    output("Box i32 =", bi.v, "Box f64 =", bf.v)
    output("min =", min_of(3, 9), min_of(2.5, 1.5))

    i32 d1 = safe_div(10, 2) ?? -1
    output("10/2 =", d1)

    i32 d2 = safe_div(10, 0) ??
        output("caught:", err.code, err.msg)
        -1
    output("10/0 =", d2)

    i32 total = 100
    add_to(ref total, 23)
    output("total =", total)

    i32 v = 42
    IntPtr ptr = &v
    unsafe
        ptr^ = 99
        output("via ptr =", ptr^)
    output("v =", v)

    string s = "  hello zfy  "
    string t = trim(s, ' ')
    output("trimmed = [" + t + "]")
    output("find 'z' =", find(t, 'z') ?? -1)