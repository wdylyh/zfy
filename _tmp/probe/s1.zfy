fn main()
    let i32[] a = 5, 2, 9, 1
    let i32[] asc = sort(a, min)
    output(asc, "\n")
    let i32[] dsc = sort(a, max)
    output(dsc, "|", a, "\n")
    output(sort(1, 6, 3, max), "\n")
    output(sort(3, 1, 2, min), "\n")
    let string[] ss = "pear", "apple", "fig"
    output(sort(ss, min), "\n")
    output(sort(ss, max), "\n")
    output(sort('c', 'a', 'b', min), "\n")
    output(sort(true, false, min), "\n")
    output(sort(2.5, 1.5, 9.0, max), "\n")
    let i32[] b = 7, 3
    let i32[] c = 1, 8
    output(sort(b, c, 2, -56, 555, max), "\n")
    output(sort(b, c, 2, -56, 555, min), "\n")
