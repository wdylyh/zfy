// 定位变体 d1：push 循环 + 下标覆盖 + for-in（无 remove/整体赋值）
interface Shape
    fn i64 area()

struct Sq
    i64 v = 0
    fn i64 area()
        return self.v

fn main()
    let Shape[] xs
    let i64 i = 0
    while i < 5
        xs = push(xs, Shape(Sq(i)))
        i = i + 1
    xs[2] = Shape(Sq(100))
    let i64 acc = 0
    for t in xs
        acc = acc + t.area()
    output(acc)
    output("d1 ok")
