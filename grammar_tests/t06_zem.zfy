// t06: ZEM 错误值——T!、fail、?? 值/块形式、e? 传播、ErrCode、panic（grammar.md §10）
fn i32! safe_div(let i32 a, let i32 b)
    if b == 0
        fail(ErrCode.DIV_ZERO, "div by zero")
    return a / b

fn i32! chain(let i32 a, let i32 b)
    let i32 r = safe_div(a, b)?
    return r

fn i32 fallback(let i32 a, let i32 b)
    return safe_div(a, b) ?? -1

fn i32! code_msg(let i32 a, let i32 b)
    return safe_div(a, b) ??
        ErrCode.CUSTOM

fn void handler(let i32 code, let string msg)
    output("[handler]", code, msg)

fn main()
    let i32 ok = fallback(10, 2)
    let i32 bad = fallback(1, 0)
    let i32! c = code_msg(3, 0)
    output(ok, bad)
    // ?? 块形式语句位置（缩进块，非花括号）
    let i32 r = safe_div(6, 0) ??
        output("caught", err.code)
        -1
    output(r)
    // panic / panic_handler
    panic_handler(handler)
    let i32 d = chain(8, 4) ?? 0
    output(d)
    return 0
