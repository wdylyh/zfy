// T9: 聚合传参（move 免克隆路径 + 值语义深拷贝路径）
// s1: xs 最后使用 → 自动 move，函数内求和
// s2: 循环 30 次传 xs（之后仍使用 → 每次深拷贝）
fn i64 sum_consume(let i64 a[])
    let i64 s = 0
    for let i64 k = 0,   k < length(a), k++
        s += a[k]
    return s

fn main()
    let i64 n = 1000000
    let i64 xs[]
    for let i64 i = 0,   i < n, i++
        push(xs, i)
    let i64 s1 = sum_consume(xs)
    output("T9 s1=", s1)
    let i64 ys[]
    for let i64 i = 0,   i < n, i++
        push(ys, i)
    let i64 s2 = 0
    for let i32 r = 0,   r < 30, r++
        s2 += sum_consume(copy ys)
    output("T9 s2=", s2, " keep=", length(ys))
    return 0
