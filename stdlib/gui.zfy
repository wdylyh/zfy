// stdlib/gui.zfy —— GUI 绑定层（design_gui.md L1，v3.3.7）
//
// 底层为 runtime.c 的 GUI 核心层（Direct2D + DirectWrite + WIC，DXGI 交换链），
// 本模块只做声明与薄包装；组件层（L2）与应用框架（L3）在此之上用纯 zfy 构建。
//
// 用法：
//   mod gui;
//   use gui::{gui_open, gui_poll, gui_fill_rect, gui_draw_text, gui_present, EV_LDOWN}
//   fn main()
//       if gui_open(480, 360, "demo") != 0
//           output("无法创建窗口")
//           return 1
//       while gui_alive() == 1
//           let Event e = Event()
//           if gui_poll(e)
//               ...
//           gui_fill_rect(0, 0, 480, 360, 0x202028)
//           gui_draw_text(20, 20, "你好 zfy GUI", 0xFFFFFF)
//           gui_present()
//           sleep_ms(16)
//
// 颜色：统一 0xAARRGGBB（如 0xFFFF0000 红、0xFF20A0FF 蓝）；仅给 0x00RRGGBB
//       时 alpha 视为 0xFF（兼容旧 0xRRGGBB 配色）
// 坐标：客户区左上为原点，y 向下；所有坐标为物理像素（逻辑值须自行 ×SC）
// DPI：gui_open 的 w/h 为逻辑尺寸，C 侧按 dpi/96 放大为物理像素；
//      字体 gui_font(px) 的 px 也是逻辑字号，C 侧同样换算
//
// 事件类型（与 runtime.c GUI_EV_* 一致）
pub let i32 const EV_MOVE = 1      // x,y = 鼠标客户区坐标
pub let i32 const EV_LDOWN = 2
pub let i32 const EV_LUP = 3
pub let i32 const EV_RDOWN = 4
pub let i32 const EV_RUP = 5
pub let i32 const EV_KEY = 6       // key = UTF-8 字节 / 扩展键前缀码（见 KEY_*）
pub let i32 const EV_WHEEL = 7     // key = 滚动增量（正=向上）
pub let i32 const EV_SIZE = 8      // x,y = 新客户区宽高（resize/DPI 变化）
// 无障碍（UI Automation）回投：UIA 客户端动作经 C 侧投递到事件队列
pub let i32 const EV_A11Y_INVOKE = 9    // x = 节点下标（UIA Invoke/Toggle/Select 请求）
pub let i32 const EV_A11Y_VALUE = 10    // x = 节点下标；key>0 为数值（key-1），key==0 为文本（gui_a11y_take_value 取）
pub let i32 const EV_A11Y_FOCUS = 11    // x = 节点下标（UIA SetFocus 请求）
// 系统集成（v3.35，Windows；非 Windows 上对应 API 返回失败，事件永不出现）
pub let i32 const EV_TRAY = 12     // k：0 左键单击 / 1 右键单击 / 2 左键双击
pub let i32 const EV_MENU = 13     // k = 菜单命令 id（WM_COMMAND）
pub let i32 const EV_DROP = 14     // x,y = 投放点（客户区）；k = 文件数（路径用 gui_drop_path 取）
pub let i32 const EV_WEB = 15      // k = 1：WebView2 收到一条 postMessage（用 gui_web_take 取）

// 菜单项标志（gui_menu_item 的 flags 位组合）
pub let i32 const MENU_GRAYED = 1      // 灰显（不可点）
pub let i32 const MENU_CHECKED = 2     // 勾选
pub let i32 const MENU_SEPARATOR = 4   // 分隔线（忽略 id/text）

// 混合模式（gui_set_blend）
pub let i32 const BLEND_SRCOVER  = 0   // 默认：源覆盖（D2D 原生）
pub let i32 const BLEND_ADD      = 1   // 加法（D2D 原生 PRIMITIVE_BLEND_ADD）
pub let i32 const BLEND_MULTIPLY = 2   // 正片叠底（CPU 合成）
pub let i32 const BLEND_SCREEN   = 3   // 滤色（CPU 合成）
pub let i32 const BLEND_XOR      = 4   // 差异混合 |src-dst|（CPU 合成）

// 鼠标/键盘事件（gui_poll 填充）
pub struct Event
    i64 typ
    i64 x
    i64 y
    i64 key

    // 便捷判断
    fn bool is(let i64 t)
        return self.typ == t

// 富文本 run：每段覆盖文本的一段字节区间（与 zfy 字符串的字节偏移一致）
// start/len 为 UTF-8 字节偏移与长度；argb=0 表示沿用绘制调用的颜色
pub struct TextRun
    i64 start = 0
    i64 len = 0
    i64 argb = 0
    i64 weight = 0     // 0=用当前默认字重；400/700 等按 DWRITE_FONT_WEIGHT
    i64 italic = 0
    i64 dpx = 0        // 相对当前字号的增量（逻辑 px，可负）

// ===== runtime.c L0 外部符号 =====

extern "C"
    // 打开窗口（客户区逻辑 w x h），标题 UTF-8。0=成功，负数=失败（-6=D2D 不可用）
    i32 zfy_gui_open(let i32 w, let i32 h, let string title)
    // 泵消息并取一事件（4 个出参指针）。1=取到，0=队列空
    i32 zfy_gui_poll(let i64* t, let i64* x, let i64* y, let i64* k)
    i32 zfy_gui_alive()
    i32 zfy_gui_should_close()
    i32 zfy_gui_w()
    i32 zfy_gui_h()
    i32 zfy_gui_dpi()
    void zfy_gui_close()
    void zfy_gui_title(let string title)
    // 提交整帧（Flush + Present）。每帧画完后调用一次
    void zfy_gui_present()
    // 填充矩形
    void zfy_gui_fill_rect(let i32 x, let i32 y, let i32 w, let i32 h, let u32 argb)
    // 描边矩形（真描边；width<=0 视为 1）
    void zfy_gui_stroke_rect(let i32 x, let i32 y, let i32 w, let i32 h, let u32 argb, let i32 width)
    // 绘制 UTF-8 文本（DirectWrite，默认微软雅黑，左上角对齐，透明背景）
    void zfy_gui_draw_text(let i32 x, let i32 y, let string s, let u32 argb)
    // 富文本：runs 指向扁平 i64 数组，每段 6 个 i64 = {起始字节, 字节长, ARGB, 字重, 斜体, 字号增量}
    void zfy_gui_draw_text_rich(let i32 x, let i32 y, let string s, let i64* runs, let i32 n)
    // 文本像素宽度/高度（布局用，物理像素）
    i32 zfy_gui_text_w(let string s)
    i32 zfy_gui_text_h(let string s)
    // 度量四元组：宽/高/基线以上/基线以下
    void zfy_gui_text_metrics(let string s, let i32* w, let i32* h, let i32* asc, let i32* desc)
    // 剪贴板：读 UTF-8 到 buf（须可容纳），返回字节数；-1=失败 -2=缓冲不足
    i32 zfy_gui_clip_get(let string buf, let i32 cap)
    // 剪贴板：写入 UTF-8 文本（替换现有内容）
    void zfy_gui_clip_set(let string s)
    // 多窗口：存活判定（任意窗口）/ 当前窗口句柄 / 切换当前窗口
    i32 zfy_gui_alive_any()
    i32 zfy_gui_self()
    void zfy_gui_select(let i64 id)
    // 当前窗口图标（.ico 等文件路径；失败静默）
    void zfy_gui_set_icon(let string path)
    // 字体与图元原语
    void zfy_gui_font(let i32 px, let i32 bold)
    void zfy_gui_font_ex(let string family, let i32 px, let i32 weight, let i32 italic)
    void zfy_gui_round_rect(let i32 x, let i32 y, let i32 w, let i32 h, let i32 r, let u32 fill, let u32 border)
    void zfy_gui_line(let i32 x0, let i32 y0, let i32 x1, let i32 y1, let u32 argb, let i32 width)
    void zfy_gui_fill_grad(let i32 x, let i32 y, let i32 w, let i32 h, let u32 c1, let u32 c2, let i32 vertical)
    void zfy_gui_fill_circle(let i32 cx, let i32 cy, let i32 r, let u32 argb)
    void zfy_gui_stroke_circle(let i32 cx, let i32 cy, let i32 r, let u32 argb, let i32 width)
    // 圆弧：角度制，0°=+x 轴，正角度顺时针（屏幕 y 向下）
    void zfy_gui_arc(let i32 cx, let i32 cy, let i32 r, let f64 a0, let f64 a1, let u32 argb, let i32 width)
    // 多边形：pts 为 x,y 交错的 i32 数组，n 为点数
    void zfy_gui_fill_poly(let i32* pts, let i32 n, let u32 argb)
    void zfy_gui_stroke_poly(let i32* pts, let i32 n, let u32 argb, let i32 width)
    // 二次贝塞尔（单控制点）
    void zfy_gui_bezier(let i32 x0, let i32 y0, let i32 cx, let i32 cy, let i32 x1, let i32 y1, let u32 argb, let i32 width)
    // 透明度 / 混合模式
    void zfy_gui_set_alpha(let i32 alpha)
    void zfy_gui_reset_alpha()
    void zfy_gui_set_blend(let i32 mode)
    // 阅读方向：1=右到左（RTL），0=左到右。影响 DirectWrite 文本排版
    void zfy_gui_set_rtl(let i32 on)
    // 裁剪 / 变换栈
    void zfy_gui_push_clip(let i32 x, let i32 y, let i32 w, let i32 h)
    void zfy_gui_pop_clip()
    void zfy_gui_push_translate(let i32 dx, let i32 dy)
    void zfy_gui_pop_transform()
    // 位图（WIC 加载 / 内存构建）：句柄 >0，0=失败
    i64 zfy_gui_image_load(let string path)
    i32 zfy_gui_image_w(let i64 h)
    i32 zfy_gui_image_h(let i64 h)
    void zfy_gui_draw_image(let i64 h, let i32 x, let i32 y, let i32 w, let i32 hh, let i32 alpha)
    void zfy_gui_draw_image_sub(let i64 h, let i32 sx, let i32 sy, let i32 sw, let i32 sh,
                                let i32 dx, let i32 dy, let i32 dw, let i32 dh, let i32 alpha)
    void zfy_gui_image_free(let i64 h)
    // RGBA（非预乘，4 字节/像素）内存缓冲 → 位图
    i64 zfy_gui_image_from_rgba(let void* px, let i32 w, let i32 h, let i32 stride)
    // ===== 无障碍（UI Automation Provider）=====
    // 每帧提交节点表：begin → push_node* → set_focus → end（win 为 gui_self()）
    void zfy_a11y_begin(let i64 win)
    void zfy_a11y_push_node(let i64 win, let i64 idx, let string name, let string role, let string value,
                            let i32 states, let i32 x, let i32 y, let i32 w, let i32 h, let i32 parent)
    void zfy_a11y_end()
    void zfy_a11y_set_focus(let i64 idx)
    // 客户区坐标 → 已提交节点下标；-1 = 未命中
    i64 zfy_a11y_hit(let i32 x, let i32 y)
    // 取 UIA 文本设值：返回字节数；0=无待取值；-2=缓冲不足（扩容重试）
    i32 zfy_gui_a11y_take_value(let i64 idx, let string buf, let i32 cap)

// ===== 包装（zfy 侧友好形态） =====

pub fn i32 gui_open(let i32 w, let i32 h, let string title)
    return zfy_gui_open(w, h, title)

pub fn bool gui_alive()
    return zfy_gui_alive() == 1

pub fn bool gui_should_close()
    return zfy_gui_should_close() == 1

pub fn i32 gui_w()
    return zfy_gui_w()

pub fn i32 gui_h()
    return zfy_gui_h()

// 系统 DPI（96=100% 缩放）。布局尺寸用它换算：物理 = 逻辑 * dpi / 96
pub fn i32 gui_dpi()
    return zfy_gui_dpi()

// EV_KEY 的 k 值分区：0..0x10FFFF 为 UTF-8 字节；扩展键/Ctrl 组合键加前缀
pub let i64 const KEY_EXT  = 0x10000000      // | VK：LEFT 0x25 RIGHT 0x27 UP 0x26 DOWN 0x28 DEL 0x2E HOME 0x24 END 0x23
pub let i64 const KEY_CTRL = 0x20000000      // | 'C' 'V' 'A' 'X'
pub let i64 const KEY_SHIFT = 0x40000000     // 与 KEY_EXT 叠加：Shift+导航键（扩选）

// 读剪贴板为 UTF-8（内部按倍增造缓冲；失败返回 ""）
pub fn string gui_clip_get()
    let string buf = "          "             // 10 空格起步
    while length(buf) < 65536
        buf = buf + buf
    let i32 n = zfy_gui_clip_get(buf, length(buf))
    if n < 0
        return ""
    return buf[0, n - 1]

// 写剪贴板
pub fn void gui_clip_set(let string s)
    zfy_gui_clip_set(s)

// ===== 无障碍（UI Automation Provider 的 zfy 侧薄包装） =====
// 用法（组件层每帧调用一次）：gui_a11y_begin(gui_self()) → 对每个节点
// gui_a11y_push_node(...) → gui_a11y_focus(焦点节点) → gui_a11y_end()
pub fn void gui_a11y_begin(let i64 win)
    zfy_a11y_begin(win)

pub fn void gui_a11y_push_node(let i64 win, let i64 idx, let string name, let string role, let string value,
                               let i32 states, let i32 x, let i32 y, let i32 w, let i32 h, let i32 parent)
    zfy_a11y_push_node(win, idx, name, role, value, states, x, y, w, h, parent)

pub fn void gui_a11y_end()
    zfy_a11y_end()

// 本帧焦点节点（-1=无焦点）；end 时提交并（有人监听时）发焦点事件
pub fn void gui_a11y_focus(let i64 idx)
    zfy_a11y_set_focus(idx)

// 命中测试：客户区坐标 → 已提交节点下标；-1=未命中
pub fn i64 gui_a11y_hit(let i32 x, let i32 y)
    return zfy_a11y_hit(x, y)

// 取 UIA 文本设值（内部按倍增造缓冲；无待取值返回 ""）
pub fn string gui_a11y_take_value(let i64 idx)
    let string buf = "                    "     // 20 空格起步
    while length(buf) < 4096
        buf = buf + buf
    let i32 n = zfy_gui_a11y_take_value(idx, buf, length(buf))
    if n <= 0
        return ""
    return buf[0, n - 1]

pub fn void gui_close()
    zfy_gui_close()

pub fn void gui_title(let string t)
    zfy_gui_title(t)

// ===== 多窗口（v3.4） =====
// 约定：gui_open 打开后新窗口即成为"当前窗口"；绘制/事件 API 作用于当前窗口。
// gui_open 返回值保持 0=成功 的兼容语义，窗口句柄用 gui_self() 取（1..8）。
pub fn bool gui_alive_any()
    return zfy_gui_alive_any() == 1

pub fn i32 gui_self()
    return zfy_gui_self()

pub fn void gui_select(let i64 id)
    zfy_gui_select(id)

pub fn void gui_set_icon(let string path)
    zfy_gui_set_icon(path)

pub fn void gui_present()
    zfy_gui_present()

pub fn void gui_fill_rect(let i32 x, let i32 y, let i32 w, let i32 h, let u32 argb)
    zfy_gui_fill_rect(x, y, w, h, argb)

// 描边矩形（真描边，1px）
pub fn void gui_rect(let i32 x, let i32 y, let i32 w, let i32 h, let u32 argb)
    zfy_gui_stroke_rect(x, y, w, h, argb, 1)

// 任意宽度描边矩形
pub fn void gui_stroke_rect(let i32 x, let i32 y, let i32 w, let i32 h, let u32 argb, let i32 width)
    zfy_gui_stroke_rect(x, y, w, h, argb, width)

pub fn void gui_draw_text(let i32 x, let i32 y, let string s, let u32 argb)
    zfy_gui_draw_text(x, y, s, argb)

pub fn i32 gui_text_w(let string s)
    return zfy_gui_text_w(s)

pub fn i32 gui_text_h(let string s)
    return zfy_gui_text_h(s)

// 度量四元组：宽/高/基线以上/基线以下（物理像素）
pub struct TextMetrics
    i32 w = 0
    i32 h = 0
    i32 asc = 0
    i32 desc = 0

pub fn TextMetrics gui_text_metrics(let string s)
    let i32 w = 0
    let i32 h = 0
    let i32 a = 0
    let i32 d = 0
    zfy_gui_text_metrics(s, &w, &h, &a, &d)
    return TextMetrics(w=w, h=h, asc=a, desc=d)

// 富文本：runs 为"每段 6 个 i64"的扁平数组（布局与 TextRun 一致，见上）
pub fn void gui_text_rich(let i32 x, let i32 y, let string s, let i64* runs, let i32 n)
    zfy_gui_draw_text_rich(x, y, s, runs, n)

// ===== UI 打磨原语包装（v3.4.x） =====

// 设置当前字体：px 逻辑像素（内部 ×DPI），bold 非 0 加粗；影响后续文字绘制
pub fn void gui_font(let i32 px, let i32 bold)
    zfy_gui_font(px, bold)

// 扩展字体：family 空串=微软雅黑；weight 400 常规 / 700 粗；italic 非 0 斜体
pub fn void gui_font_ex(let string family, let i32 px, let i32 weight, let i32 italic)
    zfy_gui_font_ex(family, px, weight, italic)

// 圆角矩形：fill=0 只描边，border=0 只填充（r 为圆角半径，逻辑值须自行 ×SC）
pub fn void gui_round_rect(let i32 x, let i32 y, let i32 w, let i32 h, let i32 r, let u32 fill, let u32 border)
    zfy_gui_round_rect(x, y, w, h, r, fill, border)

// 1px 线段（保持旧签名）
pub fn void gui_line(let i32 x0, let i32 y0, let i32 x1, let i32 y1, let u32 argb)
    zfy_gui_line(x0, y0, x1, y1, argb, 1)

// 任意宽度线段
pub fn void gui_line_w(let i32 x0, let i32 y0, let i32 x1, let i32 y1, let u32 argb, let i32 width)
    zfy_gui_line(x0, y0, x1, y1, argb, width)

// 渐变矩形：c1→c2 线性插值，vertical 非 0 纵向
pub fn void gui_fill_grad(let i32 x, let i32 y, let i32 w, let i32 h, let u32 c1, let u32 c2, let i32 vertical)
    zfy_gui_fill_grad(x, y, w, h, c1, c2, vertical)

// 圆：填充 / 描边
pub fn void gui_fill_circle(let i32 cx, let i32 cy, let i32 r, let u32 argb)
    zfy_gui_fill_circle(cx, cy, r, argb)

pub fn void gui_stroke_circle(let i32 cx, let i32 cy, let i32 r, let u32 argb, let i32 width)
    zfy_gui_stroke_circle(cx, cy, r, argb, width)

// 圆弧（角度制）
pub fn void gui_arc(let i32 cx, let i32 cy, let i32 r, let f64 a0, let f64 a1, let u32 argb, let i32 width)
    zfy_gui_arc(cx, cy, r, a0, a1, argb, width)

// 多边形（pts = x,y 交错的 i32 数组首地址，n = 点数）
pub fn void gui_fill_poly(let i32* pts, let i32 n, let u32 argb)
    zfy_gui_fill_poly(pts, n, argb)

pub fn void gui_stroke_poly(let i32* pts, let i32 n, let u32 argb, let i32 width)
    zfy_gui_stroke_poly(pts, n, argb, width)

// 二次贝塞尔曲线
pub fn void gui_bezier(let i32 x0, let i32 y0, let i32 cx, let i32 cy, let i32 x1, let i32 y1, let u32 argb, let i32 width)
    zfy_gui_bezier(x0, y0, cx, cy, x1, y1, argb, width)

// 全局乘性透明度（0..255；后续所有绘制的 alpha 再乘 alpha/255）
pub fn void gui_set_alpha(let i32 alpha)
    zfy_gui_set_alpha(alpha)

pub fn void gui_reset_alpha()
    zfy_gui_reset_alpha()

pub fn void gui_set_blend(let i32 mode)
    zfy_gui_set_blend(mode)

// 阅读方向：1=右到左（RTL，DirectWrite DWRITE_READING_DIRECTION_RIGHT_TO_LEFT）
// 0=左到右。与布局镜像（theme.set_layout_dir）相互独立。
pub fn void gui_set_rtl(let i32 on)
    zfy_gui_set_rtl(on)

// 裁剪 / 变换栈
pub fn void gui_push_clip(let i32 x, let i32 y, let i32 w, let i32 h)
    zfy_gui_push_clip(x, y, w, h)

pub fn void gui_pop_clip()
    zfy_gui_pop_clip()

pub fn void gui_push_translate(let i32 dx, let i32 dy)
    zfy_gui_push_translate(dx, dy)

pub fn void gui_pop_transform()
    zfy_gui_pop_transform()

// ===== 位图 =====

// 加载图片文件（PNG/JPG/BMP/GIF 首帧）→ 句柄；0=失败
pub fn i64 gui_image_load(let string path)
    return zfy_gui_image_load(path)

pub fn i32 gui_image_w(let i64 h)
    return zfy_gui_image_w(h)

pub fn i32 gui_image_h(let i64 h)
    return zfy_gui_image_h(h)

pub fn void gui_image_free(let i64 h)
    zfy_gui_image_free(h)

// 缩放绘制到 (x,y,w,h)；alpha 0..255 与全局 alpha 叠加
pub fn void gui_draw_image(let i64 h, let i32 x, let i32 y, let i32 w, let i32 hh, let i32 alpha)
    zfy_gui_draw_image(h, x, y, w, hh, alpha)

// 子区域绘制（精灵表）：源矩形 (sx,sy,sw,sh) → 目标 (dx,dy,dw,dh)
pub fn void gui_draw_image_sub(let i64 h, let i32 sx, let i32 sy, let i32 sw, let i32 sh,
                               let i32 dx, let i32 dy, let i32 dw, let i32 dh, let i32 alpha)
    zfy_gui_draw_image_sub(h, sx, sy, sw, sh, dx, dy, dw, dh, alpha)

// 内存 RGBA（非预乘）→ 位图句柄；stride<=0 时按 w*4
pub fn i64 gui_image_from_rgba(let void* px, let i32 w, let i32 h, let i32 stride)
    return zfy_gui_image_from_rgba(px, w, h, stride)

// 取一事件；true = e 已填充
pub fn bool gui_poll(ref let Event e)
    let i64 t = 0
    let i64 x = 0
    let i64 y = 0
    let i64 k = 0
    let i32 got = zfy_gui_poll(&t, &x, &y, &k)
    if got == 1
        e.typ = t
        e.x = x
        e.y = y
        e.key = k
        return true
    return false

// 帧节拍：16ms ≈ 60fps（L3 循环用；仅当本帧耗时不足时补睡）
pub fn void gui_frame_sleep(let i64 frame_start_ms)
    let i64 el = tick_ms() - frame_start_ms
    if el < 16
        sleep_ms(16 - el)

// =====================================================================
// 系统集成（v3.35）：系统托盘 / 原生菜单 / 文件拖放 / 气泡通知 / WebView2
//
// 全部为 runtime.c「系统集成」段的 extern 薄绑定。非 Windows 平台上这些
// 函数返回失败（-1/0），事件永不产生，调用方无需条件编译。
// =====================================================================

extern "C"
    // ---- 系统托盘（每个窗口一个托盘槽；icon 为空则取窗口图标再退系统默认）----
    i32 zfy_sys_tray_add(let string icon, let string tip)
    i32 zfy_sys_tray_tip(let string tip)
    i32 zfy_sys_tray_present()
    void zfy_sys_tray_remove()
    // ---- 气泡通知（需先 tray_add；level：0 信息 / 1 警告 / 2 错误）----
    i32 zfy_sys_notify(let string title, let string text, let i32 level)
    // ---- 原生菜单（构建 → apply 装成菜单栏 / popup 作上下文菜单）----
    i32 zfy_sys_menu_begin()
    i32 zfy_sys_menu_sub(let string text)
    void zfy_sys_menu_end()
    i32 zfy_sys_menu_item(let i32 id, let string text, let i32 flags)
    i32 zfy_sys_menu_apply()
    i32 zfy_sys_menu_popup(let i32 x, let i32 y)
    void zfy_sys_menu_free()
    i32 zfy_sys_menu_check(let i32 id, let i32 on)
    i32 zfy_sys_menu_enable(let i32 id, let i32 on)
    // ---- 文件拖放（EV_DROP 后用 drop_count/drop_path 取路径）----
    i32 zfy_sys_drop_enable(let i32 on)
    i32 zfy_sys_drop_count()
    i32 zfy_sys_drop_path(let i32 idx, let string buf, let i32 cap)
    void zfy_sys_drop_clear()
    // ---- WebView2 ----
    i32 zfy_webview_loader(let string path)
    i32 zfy_webview_create(let i32 x, let i32 y, let i32 w, let i32 h)
    i32 zfy_webview_ready()
    void zfy_webview_bounds(let i32 x, let i32 y, let i32 w, let i32 h)
    i32 zfy_webview_show(let i32 on)
    i32 zfy_webview_navigate(let string url)
    i32 zfy_webview_html(let string html)
    i32 zfy_webview_post(let string json)
    i32 zfy_webview_take(let string buf, let i32 cap)
    void zfy_webview_destroy()

// ===== 系统托盘 =====
// 加入通知区图标：icon 为 .ico 路径（空串=用窗口图标/系统默认）；0=成功，-1=失败
pub fn i32 gui_tray_add(let string icon, let string tip)
    return zfy_sys_tray_add(icon, tip)

// 更新托盘悬停提示
pub fn i32 gui_tray_tip(let string tip)
    return zfy_sys_tray_tip(tip)

// 当前窗口是否已有托盘图标
pub fn bool gui_tray_present()
    return zfy_sys_tray_present() == 1

pub fn void gui_tray_remove()
    zfy_sys_tray_remove()

// 气泡通知：level 0=信息 1=警告 2=错误
pub fn i32 gui_notify(let string title, let string text, let i32 level)
    return zfy_sys_notify(title, text, level)

// ===== 原生菜单 =====
// 开始构建：gui_menu_begin() → gui_menu_sub/item... → gui_menu_apply()
pub fn i32 gui_menu_begin()
    return zfy_sys_menu_begin()

pub fn i32 gui_menu_sub(let string text)
    return zfy_sys_menu_sub(text)

pub fn void gui_menu_end()
    zfy_sys_menu_end()

// 追加命令项；flags 见 MENU_GRAYED / MENU_CHECKED / MENU_SEPARATOR
pub fn i32 gui_menu_item(let i32 id, let string text, let i32 flags)
    return zfy_sys_menu_item(id, text, flags)

// 把构建好的菜单装成当前窗口的菜单栏（旧菜单栏自动销毁）
pub fn i32 gui_menu_apply()
    return zfy_sys_menu_apply()

// 右键上下文菜单：返回所选命令 id（0=未选择）
pub fn i32 gui_menu_popup(let i32 x, let i32 y)
    return zfy_sys_menu_popup(x, y)

// 丢弃未应用的构建结果
pub fn void gui_menu_free()
    zfy_sys_menu_free()

// 勾选/取消勾选命令项
pub fn i32 gui_menu_check(let i32 id, let i32 on)
    return zfy_sys_menu_check(id, on)

// 启用/灰显命令项
pub fn i32 gui_menu_enable(let i32 id, let i32 on)
    return zfy_sys_menu_enable(id, on)

// ===== 文件拖放 =====
// 允许把文件拖进当前窗口（收到 EV_DROP 后读路径）
pub fn i32 gui_drop_enable(let i32 on)
    return zfy_sys_drop_enable(on)

pub fn i32 gui_drop_count()
    return zfy_sys_drop_count()

// 第 idx 个投放文件的路径（内部按倍增造缓冲；越界/失败返回 ""）
pub fn string gui_drop_path(let i32 idx)
    let string buf = "                    "     // 20 空格起步
    while length(buf) < 65536
        buf = buf + buf
    let i32 n = zfy_sys_drop_path(idx, buf, length(buf))
    if n <= 0
        return ""
    return buf[0, n - 1]

// 清空本次投放记录
pub fn void gui_drop_clear()
    zfy_sys_drop_clear()

// ===== WebView2 =====
// 指定 Loader DLL 路径（空串=自动探测）；0=成功，-1=未找到
pub fn i32 gui_webview_loader(let string path)
    return zfy_webview_loader(path)

// 在当前窗口内创建 WebView2（bounds 为物理像素）：0=成功
// -1 无窗口 / -2 已存在 / -3 无 Loader / -4 环境失败 / -5 控制器失败
pub fn i32 gui_webview_create(let i32 x, let i32 y, let i32 w, let i32 h)
    return zfy_webview_create(x, y, w, h)

pub fn bool gui_webview_ready()
    return zfy_webview_ready() == 1

pub fn void gui_webview_bounds(let i32 x, let i32 y, let i32 w, let i32 h)
    zfy_webview_bounds(x, y, w, h)

pub fn i32 gui_webview_show(let i32 on)
    return zfy_webview_show(on)

// 导航到 URL（http/https/file 等）
pub fn i32 gui_webview_navigate(let string url)
    return zfy_webview_navigate(url)

// 直接载入 HTML 文本
pub fn i32 gui_webview_html(let string html)
    return zfy_webview_html(html)

// 向页面 postMessage（JSON 文本）
pub fn i32 gui_webview_post(let string json)
    return zfy_webview_post(json)

// 取最近一条 web 消息（内部按倍增造缓冲；无消息返回 ""）
pub fn string gui_web_take()
    let string buf = "                    "     // 20 空格起步
    while length(buf) < 4096
        buf = buf + buf
    let i32 n = zfy_webview_take(buf, length(buf))
    if n <= 0
        return ""
    return buf[0, n - 1]

// 销毁 WebView2（窗口销毁时也会自动清理）
pub fn void gui_webview_destroy()
    zfy_webview_destroy()
