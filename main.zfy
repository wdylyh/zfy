mod widgets;
use widgets::{App, UI}
use theme::{Theme, get_theme}
use gui::{gui_frame_sleep, gui_w, gui_h}

fn string escape_html(let string s)
    let string out = ""
    let i32 i = 0
    let i32 n = length(s)
    while i < n
        let char c = s[i]
        if c == '&'
            out += "&amp;"
        else
            if c == '<'
                out += "&lt;"
            else
                if c == '>'
                    out += "&gt;"
                else
                    if c == '"'
                        out += "&quot;"
                    else
                        out += c
        i++
    return out

fn string inline_format(let string s)
    let string out = ""
    let i32 i = 0
    let i32 n = length(s)
    while i < n
        let char c = s[i]
        if c == '`'
            let i32 k = i + 1
            let bool found = false
            while k < n and not found
                if s[k] == '`'
                    found = true
                else
                    k++
            if found
                out += "<code>" + escape_html(substr(s, i + 1, k - i - 1)) + "</code>"
                i = k + 1
            else
                out += escape_html("`")
                i++
        else
            if c == '*' and i + 1 < n and s[i + 1] == '*'
                let i32 k = i + 2
                let bool found = false
                while k + 1 < n and not found
                    if s[k] == '*' and s[k + 1] == '*'
                        found = true
                    else
                        k++
                if found
                    out += "<strong>" + inline_format(substr(s, i + 2, k - i - 2)) + "</strong>"
                    i = k + 2
                else
                    out += "*"
                    i++
            else
                if c == '*'
                    let i32 k = i + 1
                    let bool found = false
                    while k < n and not found
                        if s[k] == '*'
                            found = true
                        else
                            k++
                    if found
                        out += "<em>" + inline_format(substr(s, i + 1, k - i - 1)) + "</em>"
                        i = k + 1
                    else
                        out += "*"
                        i++
                else
                    out += escape_html("" + c)
                    i++
    return out

fn string convert(let string md)
    let string[] lines = split(md, '\n')
    let string out = ""
    let i32 i = 0
    let i32 n = length(lines)
    let bool in_list = false
    let bool in_olist = false
    let bool in_code = false

    while i < n
        let string line = lines[i]
        if length(line) >= 3 and substr(line, 0, 3) == "```"
            if in_code
                out += "</code></pre>\n"
                in_code = false
            else
                out += "<pre><code>"
                in_code = true
            i++
            continue
        if in_code
            out += escape_html(line) + "\n"
            i++
            continue
        if length(trim(line, " ")) == 0
            if in_list
                out += "</ul>\n"
                in_list = false
            if in_olist
                out += "</ol>\n"
                in_olist = false
            i++
            continue
        if line[0] == '#'
            let i32 level = 0
            while level < length(line) and line[level] == '#'
                level++
            if level <= 6 and level < length(line) and line[level] == ' '
                let string text = substr(line, level + 1, length(line) - level - 1)
                out += "<h" + to_str(level) + ">" + inline_format(text) + "</h" + to_str(level) + ">\n"
                i++
                continue
        if length(line) >= 3 and substr(line, 0, 3) == "---"
            out += "<hr>\n"
            i++
            continue
        if line[0] == '>'
            let string text = ""
            if length(line) > 1
                text = substr(line, 1, length(line) - 1)
            out += "<blockquote>" + inline_format(trim(text, " ")) + "</blockquote>\n"
            i++
            continue
        if length(line) >= 2 and line[0] == '-' and line[1] == ' '
            if not in_list
                if in_olist
                    out += "</ol>\n"
                    in_olist = false
                out += "<ul>\n"
                in_list = true
            out += "<li>" + inline_format(substr(line, 2, length(line) - 2)) + "</li>\n"
            i++
            continue
        if length(line) >= 3 and line[0] >= '0' and line[0] <= '9'
            let i32 k = 0
            while k < length(line) and line[k] >= '0' and line[k] <= '9'
                k++
            if k < length(line) and line[k] == '.' and k + 1 < length(line) and line[k + 1] == ' '
                if not in_olist
                    if in_list
                        out += "</ul>\n"
                        in_list = false
                    out += "<ol>\n"
                    in_olist = true
                out += "<li>" + inline_format(substr(line, k + 2, length(line) - k - 2)) + "</li>\n"
                i++
                continue
        if in_list
            out += "</ul>\n"
            in_list = false
        if in_olist
            out += "</ol>\n"
            in_olist = false
        out += "<p>" + inline_format(line) + "</p>\n"
        i++

    if in_list
        out += "</ul>\n"
    if in_olist
        out += "</ol>\n"
    if in_code
        out += "</code></pre>\n"
    return out

fn main()
    let App app = App()
    if app.open(900, 600, "Markdown 实时预览") != 0
        return 1
    let Theme th = get_theme()

    let UI ed = UI("textarea")
    ed.text("# 标题\n\n输入 **Markdown** 看右侧预览。\n\n- 列表项一\n- 列表项二\n\n> 引用\n\n`行内代码`\n")
    let i32 k_ed = app.add(ed)

    let UI preview = UI("label")
    preview.text("(预览)")
    preview.text_color(th.text)
    let i32 k_pv = app.add(preview)

    let UI btn = UI("button")
    btn.text("导出 HTML")
    btn.color(th.accent)
    btn.radius(6)
    let i32 k_btn = app.add(btn)

    let UI status = UI("label")
    status.text("就绪")
    status.text_color(th.success)
    let i32 k_st = app.add(status)

    let i32 prev_clicks = 0
    let i32 last_w = 0
    let i32 last_h = 0
    let string last_md = ""

    while app.alive()
        let i32 w = gui_w()
        let i32 h = gui_h()
        if w != last_w or h != last_h
            last_w = w
            last_h = h
            let i32 m = 10
            let i32 bottom = 44
            let i32 col_w = (w - m * 3) / 2
            let i32 body_h = h - bottom - m * 3
            app.set_pos(k_ed, m, m)
            app.set_size(k_ed, col_w, body_h)
            app.set_pos(k_pv, m * 2 + col_w, m)
            app.set_size(k_pv, col_w, body_h)
            app.set_pos(k_btn, m, m * 2 + body_h)
            app.set_size(k_btn, 120, 30)
            app.set_pos(k_st, m * 2 + 120, m * 2 + body_h + 6)
            app.set_size(k_st, w - m * 3 - 120, 24)

        app.step()

        let string cur_md = app.uis[k_ed].text_out
        if cur_md != last_md
            last_md = cur_md
            app.set_text(k_pv, convert(cur_md))

        if app.uis[k_btn].clicks != prev_clicks
            prev_clicks = app.uis[k_btn].clicks
            let string html = "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n"
            html += "<style>body{font-family:sans-serif;max-width:800px;margin:40px auto;line-height:1.6;padding:0 20px}</style>\n"
            html += "</head>\n<body>\n" + convert(last_md) + "</body>\n</html>\n"
            let i64! wn = write_file("preview.html", html)
            let i64 written = wn ?? -1
            if written < 0
                app.set_text(k_st, "导出失败")
                app.set_color(k_st, 0xCC3333)
            else
                app.set_text(k_st, "已导出 preview.html (" + to_str(written) + " 字节)")
                app.set_color(k_st, th.success)

        gui_frame_sleep(app.t0)

    app.close()
    return 0