fn main()
    let i32 i = 3
    let f64 d = 2.5
    output(d + i)          // 5.5 —— 变量混算隐式宽化
    output(i * 1.5)        // 4.5
    output(i < 3.5)        // true
    let f32 g = 1.5
    let i64 j = 2
    output(g + j)          // 3.5 (f32)
    let f64 x = i + 0.5    // 变量+字面量
    output(x)              // 3.5
    output("ok")
