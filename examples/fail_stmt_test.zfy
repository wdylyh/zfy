// 语句级 fail：直接终止函数返回错误值（w-009 正例）
// fail 在语句位置与 a? 失败路径同款降码（RAII + 写返回槽 + ret）
fn i32! check(let i32 v)
    if v < 0
        fail(1, "negative")
    return v * 2

fn main()
    let i32! a = check(21)
    output(a ?? -1)
    let i32! b = check(-5)
    output(b ?? -1)
    let i32! c = check(0)
    output(c ?? -1)
    return 0
