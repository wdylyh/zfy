// new2.md 9a: function types written directly as param/field types
fn i32 add(let i32 a, let i32 b)
    return a + b

struct Handler
    i32(i32, i32) op
    i32 base

fn i32 apply(let i32(i32, i32) f, let i32 x, let i32 y)
    return f(x, y)

fn main()
    output(apply(add, 3, 4))
    let Handler h = Handler(op=add, base=10)
    output(h.op(h.base, 5))
