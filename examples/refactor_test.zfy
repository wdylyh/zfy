// 整改验证：数组/列表/frac 参数 + 顶层全局变量 + for 作用域 + 目标窄化 + split 一等值

// 全局变量（可带可不带初值，零值填充）
i32 gcount = 10
string gname = "zfy"
i32 gnums[]
f64 gd

// frac 参数（聚合传参）
i32 frac fr_sum(i32 frac a, i32 frac b)
    return a + b

// 数组参数：带长度声明（长度可为字面量或参数名）
i32 arr_sum(i32 a[5])
    i32 s = 0
    for i32 i = 0, i < 5, i++
        s += a[i]
    return s

// 长度引用另一参数（深拷贝语义：函数内修改不影响调用方数组）
i32 arr_fill(i32 n, i32 b[n])
    for i32 i = 0, i < n, i++
        b[i] = i * 2
    return b[2]

// 列表参数
i32 list_len(i32 xs[])
    return length(xs)

i32 list_len_str(string xs[])
    return length(xs)

i64 main()
    // 全局变量读写
    output(gcount, gname, "sep=", end="\n")
    push(gnums, 3)
    push(gnums, 4)
    output(gnums[0], gnums[1], end="\n")

    // frac 参数
    i32 frac x = 1/2
    i32 frac y = 1/3
    i32 frac s = fr_sum(x, y)
    output(s, end="\n")

    // 数组参数（静态长度）
    i32 a[5] = 1, 2, 3, 4, 5
    output(arr_sum(a), end="\n")

    // 数组参数（长度=另一参数）
    i32 m = 4
    i32 d[4]
    arr_fill(m, d)
    output(arr_fill(m, d), d[2], end="\n")  // 4（函数内写入成功） 0（深拷贝不影响调用方）

    // 列表参数
    i32 xs[] = 7, 8, 9
    output(list_len(xs), end="\n")

    // for 循环变量作用域扩到所在块（循环变量在循环后仍可见）
    i32 last = 0
    for i32 i = 0, i < 3, i++
        last = i * i
    output(i, end="\n")
    output(last, end="\n")

    // 目标驱动窄化：i64 -> i32 无需 cast
    i64 big = 100
    i32 small = big
    output(small, end="\n")
    // length 返回 i64，直接赋给 i32
    i32 n = length(xs)
    output(n, end="\n")

    // split 一等值：直接赋值 / length / 下标 / 传参
    string line = "a,b,c"
    string parts[] = split(line, ',')
    output(length(parts), end="\n")
    output(parts[1], end="\n")
    output(list_len_str(parts), end="\n")
    return 0
