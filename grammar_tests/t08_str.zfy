// t08: 字符串——find/trim/split/replace/切片/ord/chr/下标读写/拼接（grammar.md §8/§11）
i64 main()
    string s = "hello, world"
    // find 产 T!（第二参为 char，§11）
    i64 i1 = find(s, 'o') ?? -1
    i64 i2 = find(s, 'o', count=2) ?? -1
    // trim
    string t = trim("  pad  ", ' ')
    // split 返回 string[]（分隔符为 char）
    string[] parts = split("a,b,c", ',')
    // replace 全替换 / 次数限定（char 参数）
    string r1 = replace("aaa", 'a', 'b')
    string r2 = replace("aaa", 'a', 'b', 2)
    // 切片：两端含、步长
    string sl = s[0, 4]
    string sl2 = s[0, 9:3]
    // 下标读 / 下标写（w-014 #5）
    char c0 = s[0]
    s[0] = 'H'
    // char 数值化（w-014 #5）
    char ch = 'A'
    i32 code = ord(ch)
    char back = chr(66)
    i32 promoted = ch + 1
    bool eq = ch == 'A'
    // 拼接
    string cat = s + "!"
    cat += "??"
    output(i1, i2, t)
    output(parts)
    output(r1, r2, sl, sl2)
    output(c0, s, code, back, promoted, eq)
    output(cat)
    return 0
