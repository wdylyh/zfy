// examples/widgets_test.zfy —— L2 组件层自动测试（v3.3.8）
// 断言：组件状态机（悬停/点击/聚焦/输入/拖动/滚动/选中）+ 渲染冒烟 + damage 计数
mod gui;
mod widgets;
use widgets::{App, Label, Button, InputBox, TextArea, Slider, ProgressBar, ListBox, C_BG, C_OK}
use gui::{KEY_CTRL, KEY_EXT}
use gui::{gui_frame_sleep}

fn main()
    let i32 fails = 0

    // ===== 1) 纯逻辑：不需要窗口 =====
    let Slider s0 = Slider(x=10, y=10, w=200)
    s0.set_value(150)
    if s0.value != 100
        output("FAIL slider clamp up")
        fails++
    s0.set_value(-5)
    if s0.value != 0
        output("FAIL slider clamp down")
        fails++
    s0.set_value(42)
    if s0.value != 42 or not s0.dirty
        output("FAIL slider set")
        fails++
    s0.dirty = false
    s0.set_value(42)
    if s0.dirty
        output("FAIL slider noop should stay clean")
        fails++
    if not s0.hit_wide(100, 12) or s0.hit_wide(100, 40) or s0.hit_wide(300, 12)
        output("FAIL slider hit_wide")
        fails++

    let InputBox ib0 = InputBox(x=0, y=0, w=200)
    let i64 ch_A = 65
    let i64 ch_B = 66
    let i64 bs = 8
    if not ib0.handle_key(ch_A) or not ib0.handle_key(ch_B)
        output("FAIL input append")
        fails++
    if ib0.text != "AB"
        output("FAIL input text")
        fails++
    if not ib0.handle_key(bs) or ib0.text != "A"
        output("FAIL input backspace")
        fails++
    if not ib0.handle_key(bs) or ib0.text != ""
        output("FAIL input backspace empty")
        fails++
    if ib0.handle_key(bs)
        output("FAIL backspace on empty should be noop")
        fails++

    // ===== 1c) TextArea 鼠标拖选（w-053） =====
    let TextArea ta = TextArea(x=0, y=0, w=200, h=100)
    ta.set_text("abcd\nefgh\nijkl")
    // 模拟按下 (row1 中段) 再拖到 (row2 中段)
    ta.on_press(0, 0)
    ta.on_drag(0, 0)
    ta.cx = 3
    ta.cy = 1
    if not ta.has_sel()
        output("FAIL ta has_sel after drag")
        fails++
    if not ta.del_selection()
        output("FAIL ta del_selection")
        fails++
    if ta.text() != "h\nijkl"
        output("FAIL ta del cross-line: " + ta.text())
        fails++
    if ta.has_sel()
        output("FAIL ta sel cleared")
        fails++
    // 反向选区（锚点在光标后）
    ta.set_text("abcd\nefgh")
    ta.cx = 2
    ta.cy = 1
    ta.sax = 1
    ta.say = 0
    ta.sel_on = true
    ta.say = 0
    if not ta.del_selection() or ta.text() != "agh"
        output("FAIL ta reverse selection: " + ta.text())
        fails++
    // 输入替换选区
    ta.set_text("hello")
    ta.cx = 1
    ta.sel_on = true
    ta.cy = 0
    ta.sax = 3
    ta.say = 0
    if not ta.handle_key(88) or ta.text() != "hXlo"      // X=88
        output("FAIL ta type replaces selection: " + ta.text())
        fails++
    // 导航键收起选区
    ta.set_text("abc")
    ta.cx = 0
    ta.cy = 0
    ta.sax = 3
    ta.say = 0
    if not ta.handle_key(KEY_EXT + 39)                 // Right
        fails++
    if ta.has_sel() or ta.cx != 1
        output("FAIL ta collapse on nav")
        fails++
    output("ta selection ok")

    // ===== 1b) 全选覆盖 / 多字节选区 / placeholder / 点击定位（w-052） =====
    let i64 ctrl_a = KEY_CTRL + 65
    let InputBox ib1 = InputBox(x=0, y=0, w=200)
    ib1.text = "hello"
    ib1.cx = 5
    ib1.sel_a = 0
    if not ib1.handle_key(ctrl_a)
        output("FAIL ctrl-a")
        fails++
    if not ib1.handle_key(ch_A) or ib1.text != "A"
        output("FAIL sel-overwrite: " + ib1.text)
        fails++
    let InputBox ib2 = InputBox(x=0, y=0, w=200)
    ib2.text = "你好"          // 6 字节 UTF-8
    ib2.cx = 6
    ib2.sel_a = 0
    if not ib2.handle_key(ch_B) or ib2.text != "B"
        output("FAIL multibyte sel-overwrite: " + ib2.text)
        fails++
    let InputBox ib3 = InputBox(x=0, y=0, w=200)
    ib3.ph = "请输入"
    if ib3.text != "" or ib3.cx != 0
        output("FAIL placeholder not content")
        fails++
    ib3.draw()                 // 冒烟：空文本 + placeholder 绘制不崩
    let InputBox ib4 = InputBox(x=0, y=0, w=200)
    ib4.text = "AB"
    if ib4.pos_from_mx(-5) != 0
        output("FAIL pos left")
        fails++
    if ib4.pos_from_mx(10000) != 2
        output("FAIL pos right")
        fails++

    let ListBox lb0 = ListBox(x=0, y=0, w=160, rows=3)
    lb0.add_item("alpha")
    lb0.add_item("beta")
    lb0.add_item("gamma")
    lb0.add_item("delta")
    if length(lb0.items) != 4
        output("FAIL list add")
        fails++
    lb0.scroll(10)
    if lb0.top != 1
        output("FAIL list scroll clamp")
        fails++
    lb0.scroll(-10)
    if lb0.top != 0
        output("FAIL list scroll zero")
        fails++
    lb0.scroll(-1)
    if lb0.top != 0
        output("FAIL list scroll negative")
        fails++

    // ===== 2) 渲染 + App 事件冒烟（窗口闪现约 1.2 秒后自动关闭） =====
    let App app = App()
    if app.open(480, 360, "widgets_test") != 0
        output("FAIL gui open")
        return 1

    let Label title = Label(x=20, y=16, text="zfy widgets 组件层测试")
    let i32 _idx1 = app.add_label(title)
    let Button btn = Button(x=20, y=50, w=130, h=36, text="按钮 0 次")
    let i32 _idx2 = app.add_button(btn)
    let InputBox inp = InputBox(x=20, y=100, w=280)
    let i32 _idx3 = app.add_input(inp)
    let Slider sld = Slider(x=20, y=150, w=280)
    sld.set_value(30)
    let i32 _idx4 = app.add_slider(sld)
    let ProgressBar bar = ProgressBar(x=20, y=190, w=280)
    bar.set_value(30)
    let i32 _idx5 = app.add_bar(bar)
    let ListBox lst = ListBox(x=20, y=224, w=200, rows=4)
    lst.add_item("项目一")
    lst.add_item("item-2")
    lst.add_item("item-3")
    lst.add_item("item-4")
    lst.add_item("item-5")
    let i32 _idx6 = app.add_list(lst)

    // 首帧：所有组件绘制并 present
    app.t0 = tick_ms()
    app.step()
    // 首帧后所有组件应已被绘制（dirty 清零）
    if app.buttons[0].dirty or app.inputs[0].dirty or app.sliders[0].dirty
        output("FAIL first step should flush all dirty")
        fails++

    // 模拟悬停进入按钮（合成状态后调 step；无真实事件时状态保持）
    app.mx = 60
    app.my = 68
    app.on_hover()
    if not app.buttons[0].hot
        output("FAIL button hover")
        fails++

    // 模拟点击：press + release
    app.mx = 60
    app.my = 68
    app.ldown = true
    app.on_click()
    if not app.buttons[0].pressed
        output("FAIL button press")
        fails++
    app.ldown = false
    app.on_click()
    if app.buttons[0].pressed or app.buttons[0].clicks != 1
        output("FAIL button click count")
        fails++

    // 模拟键盘输入到已聚焦输入框
    app.inputs[0].set_focus(true)
    app.on_key(ch_A)
    if app.inputs[0].text != "A"
        output("FAIL input via app.on_key")
        fails++

    // 模拟滑块拖动
    app.mx = 148
    app.my = 158
    app.ldown = true
    app.sliders[0].dragging = true
    app.step()
    if app.sliders[0].value < 40 or app.sliders[0].value > 50
        output("FAIL slider drag value")
        fails++
    app.ldown = false
    app.sliders[0].dragging = false

    // 进度条跟随滑块（业务联动示例）
    app.bars[0].set_value(app.sliders[0].value)
    if app.bars[0].value != app.sliders[0].value
        output("FAIL bar sync")
        fails++

    // 渲染数帧（真实事件泵 + 脏区重绘）
    let i32 f = 0
    while f < 60 and app.alive()
        app.step()
        gui_frame_sleep(app.t0)
        f++
    if f < 1
        output("FAIL frames")
        fails++
    if app.buttons[0].clicks != 1
        output("FAIL clicks changed during frames")
        fails++

    app.close()

    if fails == 0
        output("widgets_test: all PASS")
        return 0
    output(fails, " failures")
    return 1
