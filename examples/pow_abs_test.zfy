// ** 幂 / |e| 绝对值 / sqrt 表达式（v3.3）回归：断言失败 exit 1
fn i64 ipow(let i64 b, let i32 e)
    // 对照实现：循环乘（验证 ** 与手写幂一致）
    let i64 r = 1
    let i32 i = 0
    while i < e
        r *= b
        i++
    return r

fn main()
    let i32 bad = 0
    // ---- ** 整数 ----
    if 2**10 != 1024
        bad++
    if 3**4 != 81
        bad++
    // 右结合：x**2**3 == x**(2**3)
    if 2**2**3 != 256
        bad++
    // 与对照实现一致
    let i32 be = 5
    if 3**be != ipow(3, be)
        bad++
    // 数学优先级：-2**2 == -(2**2) == -4
    if -2**2 != -4
        bad++
    // 幂高于乘除
    if 2**3*4 != 32
        bad++
    if 2*3**2 != 18
        bad++
    // 负指数（整数）→ 0
    if 2**(-3) != 0
        bad++
    // u64 幂（10**12 = 10^12，不溢出；检查模式下溢出会 panic）
    let u64 ub = 10
    let u32 ue = 12
    if ub**ue != 1000000000000
        bad++
    // ---- ** 浮点 ----
    let f64 f1 = 2.0**10
    if f1 < 1023.999 or f1 > 1024.001
        bad++
    let f64 r2 = 2**0.5
    if r2 < 1.41421 or r2 > 1.41422
        bad++
    // f32 走 powf（经 f64 中转比较，规避 f32 字面量比较的格式化限制）
    let f32 fa = 1.5
    let f32 fb = fa**2
    let f64 fbd = cast(fb, f64)
    if fbd < 2.249 or fbd > 2.251
        bad++
    // 混合字面量：整树按 f64
    let f64 fm = 2.0**10
    if fm < 1023.999 or fm > 1024.001
        bad++
    // 与内建 pow 一致
    let f64 pv = pow(2.0, 10.0)
    if pv < 1023.999 or pv > 1024.001
        bad++
    // ---- sqrt 表达式 ----
    let f64 s = sqrt(2.0)
    if s < 1.41421 or s > 1.41422
        bad++
    // 勾股组合：sqrt(3**2 + 4**2) == 5
    let f64 hyp = sqrt(3.0**2 + 4.0**2)
    if hyp < 4.9999 or hyp > 5.0001
        bad++
    // ---- |e| 绝对值（脱糖 abs 重载）----
    let i32 m = -7
    if |m| != 7
        bad++
    let f64 fm2 = -2.5
    if |fm2| < 2.499 or |fm2| > 2.501
        bad++
    // 字面量表达式树
    if |3 - 9| != 6
        bad++
    if |-2.5 - 1.5| < 3.999 or |-2.5 - 1.5| > 4.001
        bad++
    // 无符号恒等
    let u64 uu = 99
    if |uu| != 99
        bad++
    // 与 ** 组合、嵌套
    if |-2|**3 != 8
        bad++
    if -|4| != -4
        bad++
    let i32 a = -3
    let i32 c = 5
    if |a| + |c| != 8
        bad++
    // 括号内按位或
    if |(12 | 10)| != 14
        bad++
    // 与 abs 内建等价
    if |-9| != abs(-9)
        bad++
    // |e| 作函数实参/下标（|m| = 7）
    let i32[] xs = 1, 2, 3, 4, 5, 6, 7, 8
    if xs[|m|] != 8
        bad++
    // |e|**k 右结合链
    if |m|**2**2 != 2401
        bad++
    // 随机数组合：幂在区间上下界可复现（种子固定）
    rand.seed(9)
    let i32 hits = 0
    let i32 i = 0
    while i < 100
        let i64 v = rand(2, 5)
        if v**2 >= 4 and v**2 <= 25
            hits++
        i++
    if hits != 100
        bad++
    if bad != 0
        return 1
    output("pow_abs_test OK")
    output("\n")
    return 0
