// uint 后缀语法：int uint / long long uint / short int uint 等（宽度词在前，uint 在后）
void main()
    int uint a = 3000000000
    long long uint b = 1234567890123456789
    short short uint c = 255
    short int uint d = 65535
    long int uint e = 4000000000
    output(a, sep='|')
    output(b, sep='|')
    output(c, sep='|')
    output(d, sep='|')
    output(e, sep='|')
    int uint array au[3] = 1, 2, 3
    au[2] = 4000000000
    output(au[0], au[1], au[2], sep=',')
    output(cast(a, long int uint) + cast(au[2], long int uint))
