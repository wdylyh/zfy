fn main()
  let chan<string> ch
  let t1 = spawn(fn() => chan_send(ch, "hello"))
  let t2 = spawn(fn() => chan_send(ch, "zfy"))
  join(t1)
  join(t2)
  output(chan_recv(ch) ?? "miss")
  output(chan_recv(ch) ?? "miss")
  output(chan_len(ch))
  chan_close(ch)
  let m = mutex_new()
  lock(m)
  unlock(m)
  output(true)
