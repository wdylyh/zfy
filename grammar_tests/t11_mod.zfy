// t11: 模块——内联 mod、pub 导出、use a::b::item / 分组 / as（grammar.md §9）
mod math
    pub fn i64 sq(let i64 x)
        return x * x

    pub let i64 one
    let i64 hidden = 7

    mod inner
        pub fn i64 add(let i64 a, let i64 b)
            return a + b

mod util
    pub let f64 frac hl = 1/2
    pub let string tag = "u"

use math::sq
use math::{one, inner as mi}
use util as ut

fn main()
    let i64 a = sq(6)
    let i64 b = mi.add(1, 2)
    output(a, b, one)
    output(ut.tag, ut.hl)
    return 0
