// push 内建：追加元素自动扩长，覆盖 i32/f64/string 列表
fn main()
    let i32 a[] = 1,2
    a = push(a, 3)
    a = push(a, 4)
    output(length(a), sep=' ')          // 期望 4
    output(a[0], a[1], a[2], a[3], sep=',')  // 期望 1,2,3,4
    let f64 d[] = 1.5
    d = push(d, 2.5)
    output(d[1])                        // 期望 2.5
    let string s[] = "x"
    s = push(s, "yz")
    output(s[1])                        // 期望 yz
