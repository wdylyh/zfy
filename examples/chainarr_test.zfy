// 第7条：字段链下数组元素写入（b.data[0] = 7）+ 指针形态自引用（Node 链）
struct Node
    i32 v = 0
    Node* next = null

struct Buf
    i32 data[4]
    i32 n = 0

i64 main()
    // 字段链下数组元素写入
    Buf b = Buf()
    b.data[0] = 7
    b.data[1] = 8
    Buf* bp = &b
    bp.data[2] = 9          // 指针链下数组元素写
    output(b.data[0], b.data[1], b.data[2], sep=',')
    // 链表自引用
    Node c = Node(3, null)
    Node a = Node(1, &c)
    a.next.v = 30
    output(a.v, a.next.v, sep=',')
    return 0
