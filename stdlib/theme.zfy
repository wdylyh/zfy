// stdlib/theme.zfy —— L2 设计令牌体系（v4 令牌化主题）
//
// 目标：组件层不再硬编码任何颜色/字号/间距/圆角/描边/动效时长，一律从
// get_theme() 取令牌。三套预置主题（dark / light / high_contrast），运行期
// set_theme 切换后下一帧组件重绘即生效（组件绘制函数每帧读主题）。
//
// 另提供：
//   - 组件级样式覆盖：Style（每字段配 hasX 标志位）+ widget_set_style(id, s)
//   - 布局方向 / 文本方向：set_layout_dir / set_text_dir（RTL 与 LTR 独立可设）
//
// 用法：
//   use theme::{theme_light, set_theme, get_theme, Style}
//   set_theme(theme_light())
//   let Theme th = get_theme()
//   gui_fill_rect(0, 0, w, h, th.bg)

use gui::{gui_set_rtl}

// ===== 主题令牌 =====
pub struct Theme
    // ---- 颜色（0xAARRGGBB）----
    u32 bg = 0xFF202020
    u32 surface = 0xFF2C2C2C
    u32 surfaceAlt = 0xFF383838
    u32 border = 0xFF3A3A3A
    u32 borderFocus = 0xFF4CC2FF
    u32 text = 0xFFFFFFFF
    u32 textMuted = 0xFFA0A0A0
    u32 accent = 0xFF4CC2FF
    u32 accentHover = 0xFF6FD0FF
    u32 accentPressed = 0xFF0C3B5E
    u32 danger = 0xFFFF6B6B
    u32 success = 0xFF6CCB5F
    u32 warning = 0xFFFFC857
    u32 disabled = 0xFF6A6A6A
    u32 overlay = 0x99000000
    // ---- 字体 ----
    string fontFamily = "Microsoft YaHei UI"
    i32 fontSizeBase = 16
    i32 fontSizeSmall = 13
    i32 fontSizeLarge = 24
    f64 fontScale = 1.0
    // ---- 间距（逻辑 px）----
    i32 spaceXs = 4
    i32 spaceSm = 8
    i32 spaceMd = 12
    i32 spaceLg = 16
    i32 spaceXl = 24
    // ---- 圆角（逻辑 px）----
    i32 radiusSm = 4
    i32 radiusMd = 6
    i32 radiusLg = 10
    i32 radiusFull = 999
    // ---- 描边宽（物理 px，已乘 DPI）----
    i32 strokeWidth = 1
    i32 focusWidth = 2
    // ---- 动效时长（ms）----
    i32 animFast = 100
    i32 animNormal = 200
    i32 animSlow = 350
    // ---- 主题身份：0=dark 1=light 2=high_contrast ----
    i32 mode = 0

// ===== 预置主题 =====

// 深色（WinUI3 深色基底，与旧 widgets 配色一致）
pub fn Theme theme_dark()
    return Theme(mode=0)

// 浅色（Fluent 浅色）
pub fn Theme theme_light()
    return Theme(bg=0xFFF3F3F3, surface=0xFFFFFFFF, surfaceAlt=0xFFE9E9E9,
                 border=0xFFD6D6D6, borderFocus=0xFF0067C0,
                 text=0xFF1A1A1A, textMuted=0xFF5D5D5D,
                 accent=0xFF0067C0, accentHover=0xFF1A7FD4, accentPressed=0xFFCCE4F7,
                 danger=0xFFC42B1C, success=0xFF107C10, warning=0xFF9D5D00,
                 disabled=0xFFAAAAAA, overlay=0x66000000, mode=1)

// 高对比（黑底高亮，无障碍优先）
pub fn Theme theme_high_contrast()
    return Theme(bg=0xFF000000, surface=0xFF000000, surfaceAlt=0xFF1A1A1A,
                 border=0xFFFFFFFF, borderFocus=0xFFFFFF00,
                 text=0xFFFFFFFF, textMuted=0xFFD0D0D0,
                 accent=0xFFFFFF00, accentHover=0xFFFFFF80, accentPressed=0xFF333300,
                 danger=0xFFFF5555, success=0xFF00FF00, warning=0xFFFFFF00,
                 disabled=0xFF808080, overlay=0xAA000000, mode=2)

// ===== 当前主题（全局单份，set_theme 切换） =====
// 每个令牌一个模块级全局标量（模块内全局 struct 的字段访问不支持，且对
// 全局聚合值整体 copy 会释放野指针；标量全局最稳）
let u32 g_bg = 0xFF202020
let u32 g_surface = 0xFF2C2C2C
let u32 g_surface_alt = 0xFF383838
let u32 g_border = 0xFF3A3A3A
let u32 g_border_focus = 0xFF4CC2FF
let u32 g_text = 0xFFFFFFFF
let u32 g_text_muted = 0xFFA0A0A0
let u32 g_accent = 0xFF4CC2FF
let u32 g_accent_hover = 0xFF6FD0FF
let u32 g_accent_pressed = 0xFF0C3B5E
let u32 g_danger = 0xFFFF6B6B
let u32 g_success = 0xFF6CCB5F
let u32 g_warning = 0xFFFFC857
let u32 g_disabled = 0xFF6A6A6A
let u32 g_overlay = 0x99000000
let string g_font_family = "Microsoft YaHei UI"
let i32 g_fs_base = 16
let i32 g_fs_small = 13
let i32 g_fs_large = 24
let f64 g_font_scale = 1.0
let i32 g_space_xs = 4
let i32 g_space_sm = 8
let i32 g_space_md = 12
let i32 g_space_lg = 16
let i32 g_space_xl = 24
let i32 g_radius_sm = 4
let i32 g_radius_md = 6
let i32 g_radius_lg = 10
let i32 g_radius_full = 999
let i32 g_stroke_width = 1
let i32 g_focus_width = 2
let i32 g_anim_fast = 100
let i32 g_anim_normal = 200
let i32 g_anim_slow = 350
let i32 g_mode = 0
// 版本号：主题/样式任何变更都自增，容器据此判定"下一帧需整体重绘"
let i32 g_theme_gen = 0
let i32 g_style_gen = 0

pub fn void set_theme(let Theme t)
    g_bg = t.bg
    g_surface = t.surface
    g_surface_alt = t.surfaceAlt
    g_border = t.border
    g_border_focus = t.borderFocus
    g_text = t.text
    g_text_muted = t.textMuted
    g_accent = t.accent
    g_accent_hover = t.accentHover
    g_accent_pressed = t.accentPressed
    g_danger = t.danger
    g_success = t.success
    g_warning = t.warning
    g_disabled = t.disabled
    g_overlay = t.overlay
    g_font_family = t.fontFamily
    g_fs_base = t.fontSizeBase
    g_fs_small = t.fontSizeSmall
    g_fs_large = t.fontSizeLarge
    g_font_scale = t.fontScale
    g_space_xs = t.spaceXs
    g_space_sm = t.spaceSm
    g_space_md = t.spaceMd
    g_space_lg = t.spaceLg
    g_space_xl = t.spaceXl
    g_radius_sm = t.radiusSm
    g_radius_md = t.radiusMd
    g_radius_lg = t.radiusLg
    g_radius_full = t.radiusFull
    g_stroke_width = t.strokeWidth
    g_focus_width = t.focusWidth
    g_anim_fast = t.animFast
    g_anim_normal = t.animNormal
    g_anim_slow = t.animSlow
    g_mode = t.mode
    g_theme_gen++
    // 主题切换后字体排版可能变化：同步把阅读方向重设一遍（无副作用）
    gui_set_rtl(g_text_dir)

// 主题 + 样式覆盖的合计版本（容器每帧比对，不同即整体重绘）
pub fn i32 theme_revision()
    return g_theme_gen * 100000 + g_style_gen

// 取当前主题（全新构造一份，调用方可自由持有）
pub fn Theme get_theme()
    return Theme(bg=g_bg, surface=g_surface, surfaceAlt=g_surface_alt,
                 border=g_border, borderFocus=g_border_focus, text=g_text,
                 textMuted=g_text_muted, accent=g_accent, accentHover=g_accent_hover,
                 accentPressed=g_accent_pressed, danger=g_danger, success=g_success,
                 warning=g_warning, disabled=g_disabled, overlay=g_overlay,
                 fontFamily=g_font_family, fontSizeBase=g_fs_base,
                 fontSizeSmall=g_fs_small, fontSizeLarge=g_fs_large,
                 fontScale=g_font_scale,
                 spaceXs=g_space_xs, spaceSm=g_space_sm, spaceMd=g_space_md,
                 spaceLg=g_space_lg, spaceXl=g_space_xl,
                 radiusSm=g_radius_sm, radiusMd=g_radius_md, radiusLg=g_radius_lg,
                 radiusFull=g_radius_full,
                 strokeWidth=g_stroke_width, focusWidth=g_focus_width,
                 animFast=g_anim_fast, animNormal=g_anim_normal,
                 animSlow=g_anim_slow, mode=g_mode)

pub fn bool is_dark()
    return g_mode == 0

// 令牌换算：逻辑字号 * fontScale → 逻辑 px
pub fn i32 font_px(let Theme t, let i32 px)
    let f64 v = cast(px, f64) * t.fontScale
    return cast(v, i32)

// ===== 组件级样式覆盖 =====
// 每个可覆盖字段配 hasX 标志位（Option 语义的手写形态）：只有 set_xxx 过的
// 字段才覆盖主题令牌，其余沿用主题（切换主题时仍随时间变化）。
pub struct Style
    bool hasBg = false
    u32 bg = 0
    bool hasSurface = false
    u32 surface = 0
    bool hasText = false
    u32 text = 0
    bool hasAccent = false
    u32 accent = 0
    bool hasBorder = false
    u32 border = 0
    bool hasRadius = false
    i32 radius = 0
    bool hasFontSize = false
    i32 fontSize = 0
    bool hasPadding = false
    i32 padding = 0
    bool hasSpacing = false
    i32 spacing = 0

    fn void set_bg(let u32 c)
        self.bg = c
        self.hasBg = true

    fn void set_surface(let u32 c)
        self.surface = c
        self.hasSurface = true

    fn void set_text(let u32 c)
        self.text = c
        self.hasText = true

    fn void set_accent(let u32 c)
        self.accent = c
        self.hasAccent = true

    fn void set_border(let u32 c)
        self.border = c
        self.hasBorder = true

    fn void set_radius(let i32 r)
        self.radius = r
        self.hasRadius = true

    fn void set_font_size(let i32 px)
        self.fontSize = px
        self.hasFontSize = true

    fn void set_padding(let i32 px)
        self.padding = px
        self.hasPadding = true

    fn void set_spacing(let i32 px)
        self.spacing = px
        self.hasSpacing = true

// 覆盖表条目（全局列表，按组件 id 索引）
pub struct StyleEntry
    i64 id = 0
    Style st

// 样式覆盖表（模块级全局列表：直接 push/切片清空，避免 copy 全局聚合值）
let StyleEntry[] g_styles

pub fn void widget_set_style(let i64 id, let Style s)
    let i32 i = 0
    let bool found = false
    while i < length(g_styles)
        if g_styles[i].id == id
            g_styles[i].st = s
            found = true
        i++
    if not found
        g_styles = push(g_styles, StyleEntry(id=id, st=s))
    g_style_gen++

pub fn void widget_clear_style(let i64 id)
    let StyleEntry[] out
    let i32 i = 0
    while i < length(g_styles)
        if g_styles[i].id != id
            out = push(out, copy(g_styles[i]))
        i++
    g_styles = move out
    g_style_gen++

pub fn void widget_clear_all_styles()
    g_styles = g_styles[0, -1]
    g_style_gen++

// 取该组件的有效样式（无覆盖返回全 false 的空 Style）
pub fn Style widget_style(let i64 id)
    let i32 i = 0
    while i < length(g_styles)
        if g_styles[i].id == id
            return copy(g_styles[i].st)
        i++
    return Style()

pub fn bool widget_has_style(let i64 id)
    let i32 i = 0
    while i < length(g_styles)
        if g_styles[i].id == id
            return true
        i++
    return false

pub fn i32 widget_style_count()
    return length(g_styles)

// 组件有效主题：当前主题 + 该组件 Style 覆盖（组件绘制入口一律用这个）
pub fn Theme theme_for(let i64 id)
    let Theme t = get_theme()
    let bool found = false
    let i32 i = 0
    while i < length(g_styles) and not found
        if g_styles[i].id == id
            let Style s = copy(g_styles[i].st)
            if s.hasBg
                t.bg = s.bg
            if s.hasSurface
                t.surface = s.surface
            if s.hasText
                t.text = s.text
            if s.hasAccent
                t.accent = s.accent
            if s.hasBorder
                t.border = s.border
            if s.hasRadius
                t.radiusSm = s.radius
                t.radiusMd = s.radius
                t.radiusLg = s.radius
            if s.hasFontSize
                t.fontSizeBase = s.fontSize
            found = true
        i++
    return move t

// ===== 布局方向 / 文本方向（RTL 支持） =====
// 两个方向相互独立：layout_dir 控制容器主轴镜像与文本对齐，
// text_dir 控制 DirectWrite 的阅读方向（bidi 重排）。
pub let i32 const DIR_LTR = 0
pub let i32 const DIR_RTL = 1

let i32 g_layout_dir = 0
let i32 g_text_dir = 0

pub fn void set_layout_dir(let i32 dir)
    if dir == DIR_RTL
        g_layout_dir = DIR_RTL
    else
        g_layout_dir = DIR_LTR

pub fn i32 get_layout_dir()
    return g_layout_dir

pub fn bool is_rtl()
    return g_layout_dir == DIR_RTL

// 文本方向：调用 runtime 内建（DirectWrite DWRITE_READING_DIRECTION_RIGHT_TO_LEFT）
pub fn void set_text_dir(let i32 dir)
    if dir == DIR_RTL
        g_text_dir = DIR_RTL
    else
        g_text_dir = DIR_LTR
    gui_set_rtl(g_text_dir)

pub fn i32 get_text_dir()
    return g_text_dir

pub fn bool is_rtl_text()
    return g_text_dir == DIR_RTL
