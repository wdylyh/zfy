// main.zfy —— zfy v3.15.0 文本统计与报告工具（完整修正版）
// 用法：main.exe <文件> [topN] [--chars] [--md]
//   不给文件则从 stdin 逐行读取（EOF 安全退出）。

// ---------------- §28.1 泛型约束 ----------------
fn <T: num> T gsum2(let T a, let T b)
    return a + b

// ---------------- §22 枚举 ----------------
enum OutFmt
    Plain
    Markdown

enum Kind
    Num
    Word

// ---------------- 工具函数（返回类型前置） ----------------
fn bool is_space(let char c)
    return c == ' ' or c == '\t' or c == '\r' or c == '\n'

fn string[] tokenize(let string s)
    let string[] out
    let i32 n = length(s)
    let i32 i = 0
    let i32 start = 0
    let bool in_tok = false
    while i < n
        let char c = s[i]
        if is_space(c)
            if in_tok
                out = push(out, s[start, i - 1])
                in_tok = false
            i++
        else
            if not in_tok
                start = i
                in_tok = true
            i++
    if in_tok
        out = push(out, s[start, n - 1])
    return out

fn string lower(let string s)
    let string r = ""
    let i32 n = length(s)
    let i32 i = 0
    while i < n
        let char c = s[i]
        if c >= 'A' and c <= 'Z'
            r += chr(ord(c) + 32)
        else
            r += c
        i++
    return r

// 词频条目
struct WordCount
    string w = ""
    i32 n = 0

// 手写选择排序：按次数降序，同次数按词字典序升序
// （struct 元素不支持 sort_by，见规范 §19.4）
fn WordCount[] top_words(let map<string, i32> freq, let i32 topn)
    let string[] ks = keys(freq)
    let WordCount[] ws
    for k in ks
        let i32 c = freq[k] ?? 0
        ws = push(ws, WordCount(w=k, n=c))
    let i32 m = length(ws)
    let i32 i = 0
    while i < m
        let i32 bi = i
        let i32 j = i + 1
        while j < m
            let bool better = false
            if ws[j].n > ws[bi].n
                better = true
            else if ws[j].n == ws[bi].n
                if ws[j].w < ws[bi].w
                    better = true
            if better
                bi = j
            j++
        if bi != i
            let WordCount tmp = copy(ws[i])
            ws[i] = ws[bi]
            ws[bi] = tmp
        i++
    let WordCount[] out
    let i32 k2 = 0
    while k2 < m and k2 < topn
        out = push(out, ws[k2])
        k2++
    return out

fn string[] top_chars(let map<string, i32> cf, let i32 topn)
    let string[] pool = keys(cf)
    let string[] out
    let i32 used = 0
    while used < topn and length(pool) > 0
        let i32 bi = 0
        let i32 bv = -1
        let i32 i = 0
        while i < length(pool)
            let i32 v = cf[pool[i]] ?? 0
            if v > bv
                bv = v
                bi = i
            i++
        out = push(out, pool[bi] + ":" + to_str(bv))
        let string dropped = remove(pool, bi)
        used++
    return out

fn Kind classify(let i32 n)
    let Kind k = match n % 2
        0 => Kind.Num
        _ => Kind.Word
    return k

fn string describe(let Kind k)
    let string s = match k
        Kind.Num =>
            "even/number"
        Kind.Word =>
            "odd/word"
    return s

// ---------------- 主流程 ----------------
fn main()
    let string[] argv = os_args()
    let string fname = ""
    let i32 topn = 10
    let bool want_chars = false
    let OutFmt fmt = OutFmt.Plain
    let i32 ai = 1
    while ai < length(argv)
        let string a = argv[ai]
        if a == "--chars"
            want_chars = true
        else if a == "--md"
            fmt = OutFmt.Markdown
        else if startswith(a, "--")
            output("unknown option: ", a, "\n")
            return 2
        else if length(fname) == 0
            fname = a
        else
            let i32! pn = cast(a, i32)
            if (pn ?? 0) > 0
                topn = pn ?? 10
            else
                output("bad topN: ", a, "\n")
                return 2
        ai++

    // 读取输入
    let string text = ""
    if length(fname) > 0
        let string! rf = read_file(fname)
        let string got = rf ??
            output("cannot read: ", fname, "\n")
            return 1
            ""
        text = got
    else
        // stdin：逐行读到 EOF（用 ?? 值形式判失败，不用 ? 传播）
        let bool eof = false
        while not eof
            let string! seg
            input(seg, delim='\n')
            let string line = seg ??
                eof = true
                ""
            if not eof
                text += line + "\n"

    // 统计
    let i32 bytes = length(text)
    let string[] lines = split(text, '\n')
    let i32 nlines = length(lines)
    if nlines > 0 and length(lines[nlines - 1]) == 0
        nlines--
    let string[] words = tokenize(text)
    let i32 nwords = length(words)

    // 词频（小写归一）
    let map<string, i32> freq
    for w in words
        let string lw = lower(w)
        let i32 old = freq[lw] ?? 0
        freq[lw] = old + 1

    // 字符频率（char→string 用 cast）
    let map<string, i32> cf
    if want_chars
        let i32 i = 0
        while i < bytes
            let char c = text[i]
            if not is_space(c)
                let string k = cast(c, string)
                cf[k] = (cf[k] ?? 0) + 1
            i++

    // 最长行
    let i32 longest = 0
    let i32 longest_ln = 0
    let i32 li = 0
    for ln in lines
        let i32 L = length(ln)
        if L > longest
            longest = L
            longest_ln = li + 1
        li++

    // 输出（enum 用 match 分派，不能用 ==）
    let string header = match fmt
        OutFmt.Plain =>
            "== report: " + fname + " ==\n"
        OutFmt.Markdown =>
            "# report: `" + fname + "`\n\n"
    output(header)

    output("lines: ", nlines, "\n")
    output("words: ", nwords, "\n")
    output("bytes: ", bytes, "\n")
    output("longest line: ", longest_ln, " (", longest, " bytes)\n")
    output("unique words: ", map_len(freq), "\n\n")

    output("top ", topn, " words:\n")
    let WordCount[] tw = top_words(freq, topn)
    for wc in tw
        output("  ", prec(wc.w, 16), " ", wc.n, "\n")

    if want_chars
        output("\ntop ", topn, " chars (non-space):\n")
        let string[] tc = top_chars(cf, topn)
        for s in tc
            output("  ", s, "\n")

    // §26 断言自检
    assert_eq(gsum2(2, 3), 5)

    // 分类演示（前 3 个词）
    for i in words, idx
        if idx < 3
            let Kind k = classify(length(i))
            output("word[", idx, "] kind=", describe(k), "\n")

    return 0