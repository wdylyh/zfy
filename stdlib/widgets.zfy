// stdlib/widgets.zfy —— GUI 组件层（design_gui.md L2，v3.3.8）
//
// 纯 zfy 实现，构建在 gui（L1）之上。核心设计：
//   - **damage 跟踪**：每个组件带 dirty 标志，只有变化的组件在本帧重绘，
//     整帧仅在"本帧有组件重绘"时才 present（BitBlt）——空闲时零拷贝开销
//   - **保留模式**（retained）：App 持有组件数组，每帧一次 app.step() 完成
//     事件分发、状态更新、脏区重绘；业务逻辑读组件状态（clicks/text/value/sel）
//
// 用法：
//   mod widgets;
//   use widgets::{App, Button, InputBox, Slider}
//   fn main()
//       let App app = App()
//       if app.open(480, 360, "demo") != 0
//           return 1
//       let Button btn = Button(x=20, y=20, w=120, h=36, text="点我")
//       app.add_button(btn)
//       while app.alive()
//           app.step()
//           gui_frame_sleep(app.t0)
//       app.close()


use gui::{gui_open, gui_alive, gui_close, gui_w, gui_h, gui_dpi, gui_fill_rect, gui_rect, gui_draw_text, gui_text_w, gui_present, gui_poll, gui_frame_sleep, gui_font, gui_round_rect, gui_line, Event, EV_MOVE, EV_LDOWN, EV_LUP, EV_KEY, EV_WHEEL, KEY_EXT, KEY_CTRL, KEY_SHIFT, gui_clip_get, gui_clip_set}

// ===== 主题配色（WinUI3 深色风：扁平卡片 + subtle 边框 + 焦点下划线） =====
pub let u32 const C_BG      = 0x202020   // 窗口背景（WinUI Layer）
pub let u32 const C_PANEL   = 0x2C2C2C   // 卡片/控件面（Card）
pub let u32 const C_PANELH  = 0x383838   // 卡片悬停/按下亮面
pub let u32 const C_PANDOWN = 0x242424   // 按下暗面
pub let u32 const C_BORDER  = 0x3A3A3A   // subtle 边框
pub let u32 const C_TEXT    = 0xFFFFFF   // 主文本
pub let u32 const C_SUB     = 0xA0A0A0   // 次级文本
pub let u32 const C_ACCENT  = 0x4CC2FF   // 强调（WinUI 深色 accent light2）
pub let u32 const C_ACCENTD = 0x0C3B5E   // 强调低亮度（选中行底）
pub let u32 const C_HOT     = 0x383838   // 悬停
pub let u32 const C_DOWN    = 0x242424   // 按下
pub let u32 const C_OK      = 0x6CCB5F   // 绿（Fluent success）

// 界面缩放：96dpi=100。组件内部尺寸一律 逻辑值 * SC() / 100
pub fn i32 SC()
    return gui_dpi() * 100 / 96

// 文本行高（雅黑 16 逻辑px）——按 DPI 缩放后的物理值
fn i32 LH()
    return 22 * SC() / 100

// ===== Label：静态文本 =====
pub struct Label
    i32 x
    i32 y
    string text
    u32 color = C_TEXT
    i32 bg_w = 0         // 清屏宽度：0=按当前文本宽度；文本会变短时设大可防残影
    i32 fs = 16          // 字号（逻辑 px）
    bool bold = false
    bool nobg = false    // true=不清背景（叠加在渐变带等自绘背景上）
    bool dirty = true

    fn void draw()
        let i32 b = 0
        if self.bold
            b = 1
        gui_font(self.fs, b)
        let i32 tw = gui_text_w(self.text)
        let i32 cw = self.bg_w
        if cw <= 0
            cw = tw + 4
        if not self.nobg
            gui_fill_rect(self.x - 2, self.y - 2, cw + 2, self.fs * SC() / 100 + 6, C_BG)
        gui_draw_text(self.x, self.y, self.text, self.color)
        gui_font(16, 0)
        self.dirty = false

// ===== Button：点击计数按钮 =====
pub struct Button
    i32 x
    i32 y
    i32 w
    i32 h
    string text
    bool hot = false
    bool pressed = false
    i32 clicks = 0        // 业务读这个
    bool dirty = true
    u32 color = 0         // 自定义面色（0=主题 C_PANEL；按下仍 C_PANDOWN）
    u32 tcolor = 0        // 自定义文本色（0=主题 C_TEXT）
    i32 radius = 6        // 圆角（逻辑 px，UI 标签可覆盖）

    fn bool hit(let i32 mx, let i32 my)
        return mx >= self.x and mx < self.x + self.w and my >= self.y and my < self.y + self.h

    fn void set_text(let string t)
        self.text = t
        self.dirty = true

    fn void draw()
        let i32 u = SC()
        let u32 fill = C_PANEL
        if self.color != 0
            // 自定义面色：保留按下反馈，悬停不覆盖自定义色
            fill = self.color
            if self.pressed
                fill = C_PANDOWN
        else
            if self.pressed
                fill = C_PANDOWN
            else
                if self.hot
                    fill = C_PANELH
        // 扁平卡片：同色细边框（视觉上无边框），WinUI 标准圆角 6
        gui_round_rect(self.x, self.y, self.w, self.h, self.radius * u / 100, fill, fill)
        gui_font(13, 0)
        let u32 tc = C_TEXT
        if self.tcolor != 0
            tc = self.tcolor
        let i32 tw = gui_text_w(self.text)
        let i32 th = 13 * u / 100
        gui_draw_text(self.x + (self.w - tw) / 2, self.y + (self.h - th) / 2, self.text, tc)
        gui_font(16, 0)
        self.dirty = false

// ===== InputBox：单行文本框（点击聚焦；鼠标拖选；Ctrl+A/C/X/V、方向键、Home/End） =====
pub struct InputBox
    i32 x
    i32 y
    i32 w
    string text
    bool focus = false
    bool dirty = true
    i32 cx = 0            // 光标字节位置（码点对齐）
    i32 sel_a = 0         // 选区锚点（字节）；cx==sel_a 即无选区
    bool dragging = false

    fn bool hit(let i32 mx, let i32 my)
        return mx >= self.x and mx < self.x + self.w and my >= self.y and my < self.y + LH() + 8 * SC() / 100

    fn void set_focus(let bool f)
        if self.focus != f
            self.focus = f
            if not f
                self.sel_a = self.cx
                self.dragging = false
            self.dirty = true

    // 像素 → 字节光标位置（最近码点起点；右侧空白落行尾）
    fn i32 pos_from_mx(let i32 mx)
        let i32 u = SC()
        let i32 target = mx - self.x - 8 * u / 100
        let i32 n = length(self.text)
        if target <= 0
            return 0
        if gui_text_w(self.text) <= target
            return n
        let i32 i = 0
        let i32 best = 0
        while i < n
            if gui_text_w(prefix(self.text, i)) > target
                break
            best = i
            i = next_cp(self.text, i)
        return best

    // 选区规范化端点 [lo,hi)
    fn i32 sel_lo()
        if self.cx < self.sel_a
            return self.cx
        return self.sel_a

    fn i32 sel_hi()
        if self.cx < self.sel_a
            return self.sel_a
        return self.cx

    // 有选区则删除并归位光标；返回是否有选区被删
    fn bool del_selection()
        let i32 lo = self.sel_lo()
        let i32 hi = self.sel_hi()
        if lo == hi
            return false
        self.text = prefix(self.text, lo) + suffix(self.text, hi)
        self.cx = lo
        self.sel_a = lo
        self.dirty = true
        return true

    // 鼠标按下：定位光标 + 开始拖选
    fn void on_press(let i32 mx)
        let i32 p = self.pos_from_mx(mx)
        self.cx = p
        self.sel_a = p
        self.dragging = true
        self.dirty = true

    fn void on_drag(let i32 mx)
        if self.dragging
            let i32 p = self.pos_from_mx(mx)
            if p != self.cx
                self.cx = p
                self.dirty = true

    fn void on_release()
        self.dragging = false

    // 单行化剪贴板文本：\r \n → 空格
    fn string flatten(let string s)
        let string out = ""
        let i32 i = 0
        while i < length(s)
            let i32 b = ord(s[i])
            if b == 10 or b == 13
                out = out + " "
            else
                out = out + s[i]
            i++
        return out

    // 返回 true = 本帧有变化
    fn bool handle_key(let i64 k)
        let i32 n = length(self.text)
        let bool shift = k >= KEY_SHIFT   // SHIFT 位：0x40000000 为 k 值最高段
        // Ctrl 组合键
        if k == KEY_CTRL + 65        // Ctrl+A 全选
            self.sel_a = 0
            self.cx = n
            self.dirty = true
            return true
        if k == KEY_CTRL + 67        // Ctrl+C 复制
            let i32 lo = self.sel_lo()
            let i32 hi = self.sel_hi()
            if lo != hi
                gui_clip_set(suffix(prefix(self.text, hi), lo))
            return true
        if k == KEY_CTRL + 88        // Ctrl+X 剪切
            let i32 lo2 = self.sel_lo()
            let i32 hi2 = self.sel_hi()
            if lo2 != hi2
                gui_clip_set(suffix(prefix(self.text, hi2), lo2))
                let bool _dx = self.del_selection()
                return true
            return false
        if k == KEY_CTRL + 86        // Ctrl+V 粘贴
            let string clip = gui_clip_get()
            if length(clip) > 0
                let string ins = self.flatten(clip)
                let bool _dv = self.del_selection()
                self.text = prefix(self.text, self.cx) + ins + suffix(self.text, self.cx)
                self.cx = self.cx + length(ins)
                self.sel_a = self.cx
                self.dirty = true
                return true
            return false
        // 导航键（Shift 按下时扩选：只移 cx，锚点 sel_a 不动；无 Shift 移动即取消选区）
        if k == KEY_EXT + 37 or k == KEY_SHIFT + KEY_EXT + 37      // Left
            if self.cx > 0
                self.cx = align_back(self.text, self.cx - 1)
            if not shift
                self.sel_a = self.cx
            self.dirty = true
            return true
        if k == KEY_EXT + 39 or k == KEY_SHIFT + KEY_EXT + 39      // Right
            if self.cx < n
                self.cx = next_cp(self.text, self.cx)
            if not shift
                self.sel_a = self.cx
            self.dirty = true
            return true
        if k == KEY_EXT + 36 or k == KEY_SHIFT + KEY_EXT + 36      // Home
            self.cx = 0
            if not shift
                self.sel_a = 0
            self.dirty = true
            return true
        if k == KEY_EXT + 35 or k == KEY_SHIFT + KEY_EXT + 35      // End
            self.cx = n
            if not shift
                self.sel_a = n
            self.dirty = true
            return true
        if k == KEY_EXT + 46         // Delete：删选区或光标后一码点
            if self.del_selection()
                return true
            if self.cx < n
                let i32 p2 = next_cp(self.text, self.cx)
                self.text = prefix(self.text, self.cx) + suffix(self.text, p2)
                self.sel_a = self.cx
                self.dirty = true
                return true
            return false
        if k == 8
            // Backspace：先删选区，否则删光标前一码点
            if self.del_selection()
                return true
            if self.cx > 0
                let i32 p = align_back(self.text, self.cx - 1)
                self.text = prefix(self.text, p) + suffix(self.text, self.cx)
                self.cx = p
                self.sel_a = p
                self.dirty = true
                return true
            return false
        if k >= 32 and k < KEY_EXT
            // 可打印：覆盖选区后插入光标处（UTF-8 字节流逐字节拼出正确串）
            let bool _dp = self.del_selection()
            self.text = prefix(self.text, self.cx) + cast(k, char) + suffix(self.text, self.cx)
            self.cx = self.cx + 1
            self.sel_a = self.cx
            self.dirty = true
            return true
        return false

    fn void draw()
        let i32 u = SC()
        let i32 hh = LH() + 8 * u / 100
        gui_round_rect(self.x, self.y, self.w, hh, 4 * u / 100, C_PANEL, C_BORDER)
        if self.focus
            // 选区高亮（码点对齐的字节区间 → 像素区间）
            let i32 lo = self.sel_lo()
            let i32 hi = self.sel_hi()
            if lo != hi
                let i32 x1 = self.x + 8 * u / 100 + gui_text_w(prefix(self.text, lo))
                let i32 x2 = self.x + 8 * u / 100 + gui_text_w(prefix(self.text, hi))
                gui_fill_rect(x1, self.y + 4 * u / 100, x2 - x1, LH(), C_ACCENTD)
            gui_draw_text(self.x + 8 * u / 100, self.y + 5 * u / 100, self.text, C_TEXT)
            // 焦点下划线 + 光标（cx 可在文本中间）
            gui_fill_rect(self.x + 1, self.y + hh - 2 * u / 100, self.w - 2, 2 * u / 100, C_ACCENT)
            let i32 cw = gui_text_w(prefix(self.text, self.cx))
            gui_fill_rect(self.x + 8 * u / 100 + cw, self.y + 5 * u / 100, 2 * u / 100, LH() - 4 * u / 100, C_TEXT)
        else
            gui_draw_text(self.x + 8 * u / 100, self.y + 5 * u / 100, self.text, C_TEXT)
        self.dirty = false

// ===== Slider：拖动滑块，value 0..100 =====
pub struct Slider
    i32 x
    i32 y
    i32 w
    i32 value = 0        // 业务读这个（0..100）
    bool dragging = false
    bool dirty = true

    fn void set_value(let i32 v)
        let i32 vv = v
        if vv < 0
            vv = 0
        if vv > 100
            vv = 100
        if vv != self.value
            self.value = vv
            self.dirty = true

    // 命中判定（含上下 6px 容差）
    fn bool hit_wide(let i32 mx, let i32 my)
        return mx >= self.x and mx < self.x + self.w and my >= self.y - 6 * SC() / 100 and my < self.y + 26 * SC() / 100

    fn void draw()
        let i32 u = SC()
        gui_fill_rect(self.x, self.y + 8 * u / 100, self.w, 4 * u / 100, C_PANEL)
        gui_rect(self.x, self.y + 8 * u / 100, self.w, 4 * u / 100, C_BORDER)
        let i32 fx = self.x + (self.w - 2 * u / 100) * self.value / 100
        if fx > self.x
            gui_fill_rect(self.x, self.y + 8 * u / 100, fx - self.x, 4 * u / 100, C_ACCENT)
        if self.dragging
            gui_fill_rect(fx - 5 * u / 100, self.y, 10 * u / 100, 20 * u / 100, C_HOT)
        else
            gui_fill_rect(fx - 5 * u / 100, self.y, 10 * u / 100, 20 * u / 100, C_ACCENT)
        self.dirty = false

// ===== ProgressBar：进度条 =====
pub struct ProgressBar
    i32 x
    i32 y
    i32 w
    i32 value = 0
    u32 color = C_OK
    bool dirty = true

    fn void set_value(let i32 v)
        let i32 vv = v
        if vv < 0
            vv = 0
        if vv > 100
            vv = 100
        if vv != self.value
            self.value = vv
            self.dirty = true

    fn void draw()
        let i32 u = SC()
        gui_fill_rect(self.x, self.y, self.w, 18 * u / 100, C_PANEL)
        gui_rect(self.x, self.y, self.w, 18 * u / 100, C_BORDER)
        let i32 fw = (self.w - 4 * u / 100) * self.value / 100
        if fw > 0
            gui_fill_rect(self.x + 2 * u / 100, self.y + 2 * u / 100, fw, 14 * u / 100, self.color)
        self.dirty = false

// ===== ListBox：字符串列表（滚轮滚动，点击选中） =====
pub struct ListBox
    i32 x
    i32 y
    i32 w
    i32 rows             // 可见行数
    string[] items
    i32 sel = -1         // 业务读这个（-1 未选）
    i32 top = 0          // 滚动偏移（首行下标）
    i32 dbl = 0          // 双击计数（业务读差值；两次单击同一行 <400ms）
    i32 dbl_row = -1     // 最后双击的行（items 下标）
    i64 last_ms = 0      // 上次单击时刻（内部）
    i32 last_row = -1    // 上次单击行（内部）
    bool dirty = true

    fn void clear()
        self.items = self.items[0, -1]
        self.sel = -1
        self.top = 0
        self.dirty = true

    fn void add_item(let string s)
        self.items = push(self.items, s)
        self.dirty = true

    fn void scroll(let i32 d)
        let i32 n = length(self.items)
        let i32 nt = self.top + d
        if nt < 0
            nt = 0
        if n > self.rows
            if nt > n - self.rows
                nt = n - self.rows
        else
            nt = 0
        if nt != self.top
            self.top = nt
            self.dirty = true

    fn void draw()
        let i32 u = SC()
        let i32 hgt = self.rows * LH() + 8 * u / 100
        gui_round_rect(self.x, self.y, self.w, hgt, 6 * u / 100, C_PANEL, C_BORDER)
        let i32 n = length(self.items)
        let i32 last = self.top + self.rows
        if last > n
            last = n
        let i32 i = self.top
        while i < last
            let i32 row = i - self.top
            let i32 ry = self.y + 4 * u / 100 + row * LH()
            if i == self.sel
                // WinUI 选中行：accent 暗底 + 左侧强调条
                gui_fill_rect(self.x + 2 * u / 100, ry - 1, self.w - 4 * u / 100, LH(), C_ACCENTD)
                gui_draw_text(self.x + 8 * u / 100 + 4 * u / 100, ry, self.items[i], C_TEXT)
                gui_fill_rect(self.x + 2 * u / 100, ry - 1, 3 * u / 100, LH(), C_ACCENT)
            else
                gui_draw_text(self.x + 8 * u / 100 + 4 * u / 100, ry, self.items[i], C_TEXT)
                if row > 0
                    gui_line(self.x + 2 * u / 100, ry - 1, self.x + self.w - 2 * u / 100, ry - 1, 0x303030)
            i++
        self.dirty = false

// ===== App：应用容器 + 事件循环骨架 =====
pub struct App
    Label[] labels
    Button[] buttons
    InputBox[] inputs
    Slider[] sliders
    ProgressBar[] bars
    ListBox[] lists
    TextArea[] texts
    Checkbox[] checks
    Menu[] menus
    UI[] uis
    bool menu_dirty = false
    i32 mx = -1
    i32 my = -1
    bool ldown = false
    bool ldown_prev = false
    bool quit = false
    bool any_dirty = false
    i64 t0 = 0           // 帧起点（gui_frame_sleep 用）

    fn i32 open(let i32 w, let i32 h, let string title)
        let i32 r = gui_open(w, h, title)
        if r != 0
            return r
        gui_fill_rect(0, 0, gui_w(), gui_h(), C_BG)
        gui_present()
        self.t0 = tick_ms()
        return 0

    fn bool alive()
        return gui_alive() and not self.quit

    fn void close()
        gui_close()

    // add_* 返回组件索引（v3.5 DX）：App 为值语义容器——add 进去的是副本，
    // 之后业务读写一律走 app.xxx[idx].field，不要读局部变量
    fn i32 add_label(let Label l)
        self.labels = push(self.labels, l)
        return length(self.labels) - 1

    fn i32 add_button(let Button b)
        self.buttons = push(self.buttons, b)
        return length(self.buttons) - 1

    fn i32 add_input(let InputBox ib)
        self.inputs = push(self.inputs, ib)
        return length(self.inputs) - 1

    fn i32 add_slider(let Slider s)
        self.sliders = push(self.sliders, s)
        return length(self.sliders) - 1

    fn i32 add_bar(let ProgressBar p)
        self.bars = push(self.bars, p)
        return length(self.bars) - 1

    fn i32 add_list(let ListBox lb)
        self.lists = push(self.lists, lb)
        return length(self.lists) - 1

    fn i32 add_text(let TextArea t)
        self.texts = push(self.texts, t)
        return length(self.texts) - 1

    fn i32 add_checkbox(let Checkbox c)
        self.checks = push(self.checks, c)
        return length(self.checks) - 1

    fn i32 add_menu(let Menu m)
        self.menus = push(self.menus, m)
        self.menu_dirty = true
        return length(self.menus) - 1

    // 按元素名查 uis 下标（ui 语句注册查重）；无则 -1
    fn i32 find_ui(let string n)
        let i32 i = 0
        while i < length(self.uis)
            if self.uis[i].uname == n
                return i
            i++
        return -1

    // ===== 统一元素入口（new2.md 元素+标签模型） =====
    // add(UI) 返回元素下标 k；此后输出读 app.uis[k]，输入用 app.set_xxx(k, ...)
    fn i32 add(let UI u)
        let UI e = u
        e.which = kind_of(e.kind)
        if e.which == 0
            let Label w = Label(x=e.x, y=e.y, text=e.text)
            if e.tcolor != 0
                w.color = e.tcolor
            e.idx = self.add_label(w)
        if e.which == 1
            let i32 rr = e.radius
            if rr <= 0
                rr = 6
            let Button w = Button(x=e.x, y=e.y, w=e.w, h=e.h, text=e.text)
            w.color = e.color
            w.tcolor = e.tcolor
            w.radius = rr
            e.idx = self.add_button(w)
        if e.which == 2
            let InputBox w = InputBox(x=e.x, y=e.y, w=e.w)
            w.text = e.text
            w.cx = length(e.text)
            e.idx = self.add_input(w)
        if e.which == 3
            let Slider w = Slider(x=e.x, y=e.y, w=e.w)
            w.value = e.value
            e.idx = self.add_slider(w)
        if e.which == 4
            let ProgressBar w = ProgressBar(x=e.x, y=e.y, w=e.w)
            w.value = e.value
            if e.color != 0
                w.color = e.color
            e.idx = self.add_bar(w)
        if e.which == 5
            let i32 nr = e.rows
            if nr <= 0
                nr = 4
            let ListBox w = ListBox(x=e.x, y=e.y, w=e.w, rows=nr)
            w.items = e.items
            e.idx = self.add_list(w)
        if e.which == 6
            let Checkbox w = Checkbox(x=e.x, y=e.y, text=e.text)
            w.checked = e.checked
            e.idx = self.add_checkbox(w)
        if e.which == 7
            let Menu w = Menu(title=e.text)
            w.items = e.items
            e.idx = self.add_menu(w)
            self.layout_menus()
        if e.which == 8
            let i32 th = e.h
            if th <= 0
                th = 120
            let TextArea w = TextArea(x=e.x, y=e.y, w=e.w, h=th)
            if e.text != ""
                w.set_text(e.text)
            e.idx = self.add_text(w)
        self.uis = push(self.uis, e)
        return length(self.uis) - 1

    // 输出标签刷新（step 末尾自动调用）：把内部组件状态同步进 uis[k]
    fn void sync_outputs()
        let i32 k = 0
        while k < length(self.uis)
            let UI e = self.uis[k]
            let i32 ix = e.idx
            if e.which == 1
                e.clicks = self.buttons[ix].clicks
            if e.which == 2
                e.text_out = self.inputs[ix].text
                e.changed = e.text_out != e.cache_s
                e.cache_s = e.text_out
            if e.which == 3
                e.value = self.sliders[ix].value
                e.changed = e.value != e.cache_i
                e.cache_i = e.value
            if e.which == 4
                e.value = self.bars[ix].value
                e.changed = e.value != e.cache_i
                e.cache_i = e.value
            if e.which == 5
                e.sel = self.lists[ix].sel
                e.clicks = self.lists[ix].dbl
                e.changed = e.sel != e.cache_i
                e.cache_i = e.sel
                if e.sel >= 0
                    if e.sel < length(self.lists[ix].items)
                        e.text_out = self.lists[ix].items[e.sel]
            if e.which == 6
                e.checked = self.checks[ix].checked
                e.clicks = self.checks[ix].clicks
            if e.which == 7
                e.sel = self.menus[ix].sel
                e.clicks = self.menus[ix].clicks
            if e.which == 8
                e.text_out = self.texts[ix].text()
                e.changed = e.text_out != e.cache_s
                e.cache_s = e.text_out
            self.uis[k] = e
            k++

    // ---- 加元素后的输入标签（按元素下标 k 修改） ----
    fn void set_text(let i32 k, let string s)
        let UI e = self.uis[k]
        let i32 ix = e.idx
        e.text = s
        if e.which == 0
            self.labels[ix].text = s
            self.labels[ix].dirty = true
        if e.which == 1
            self.buttons[ix].set_text(s)
        if e.which == 2
            self.inputs[ix].text = s
            self.inputs[ix].cx = length(s)
            self.inputs[ix].sel_a = length(s)
            self.inputs[ix].dirty = true
        if e.which == 7
            self.menus[ix].title = s
            self.layout_menus()
        if e.which == 8
            self.texts[ix].set_text(s)
        self.uis[k] = e

    fn void set_pos(let i32 k, let i32 px, let i32 py)
        let UI e = self.uis[k]
        let i32 ix = e.idx
        e.x = px
        e.y = py
        if e.which == 0
            self.labels[ix].x = px
            self.labels[ix].y = py
            self.labels[ix].dirty = true
        if e.which == 1
            self.buttons[ix].x = px
            self.buttons[ix].y = py
            self.buttons[ix].dirty = true
        if e.which == 2
            self.inputs[ix].x = px
            self.inputs[ix].y = py
            self.inputs[ix].dirty = true
        if e.which == 3
            self.sliders[ix].x = px
            self.sliders[ix].y = py
            self.sliders[ix].dirty = true
        if e.which == 4
            self.bars[ix].x = px
            self.bars[ix].y = py
            self.bars[ix].dirty = true
        if e.which == 5
            self.lists[ix].x = px
            self.lists[ix].y = py
            self.lists[ix].dirty = true
        if e.which == 6
            self.checks[ix].x = px
            self.checks[ix].y = py
            self.checks[ix].dirty = true
        if e.which == 8
            self.texts[ix].x = px
            self.texts[ix].y = py
            self.texts[ix].dirty = true
        self.uis[k] = e

    fn void set_size(let i32 k, let i32 pw, let i32 ph)
        let UI e = self.uis[k]
        let i32 ix = e.idx
        e.w = pw
        e.h = ph
        if e.which == 1
            self.buttons[ix].w = pw
            self.buttons[ix].h = ph
            self.buttons[ix].dirty = true
        if e.which == 2
            self.inputs[ix].w = pw
            self.inputs[ix].dirty = true
        if e.which == 3
            self.sliders[ix].w = pw
            self.sliders[ix].dirty = true
        if e.which == 4
            self.bars[ix].w = pw
            self.bars[ix].dirty = true
        if e.which == 5
            self.lists[ix].w = pw
            if ph > 0
                let i32 nr = (ph - 8 * SC() / 100) / LH()
                if nr < 1
                    nr = 1
                self.lists[ix].rows = nr
            self.lists[ix].dirty = true
        if e.which == 8
            self.texts[ix].w = pw
            self.texts[ix].h = ph
            self.texts[ix].dirty = true
        self.uis[k] = e

    fn void set_color(let i32 k, let u32 c)
        let UI e = self.uis[k]
        let i32 ix = e.idx
        e.color = c
        if e.which == 0
            self.labels[ix].color = c
            self.labels[ix].dirty = true
        if e.which == 1
            self.buttons[ix].color = c
            self.buttons[ix].dirty = true
        if e.which == 4
            self.bars[ix].color = c
            self.bars[ix].dirty = true
        self.uis[k] = e

    fn void set_text_color(let i32 k, let u32 c)
        let UI e = self.uis[k]
        let i32 ix = e.idx
        e.tcolor = c
        if e.which == 0
            self.labels[ix].color = c
            self.labels[ix].dirty = true
        if e.which == 1
            self.buttons[ix].tcolor = c
            self.buttons[ix].dirty = true
        self.uis[k] = e

    fn void set_value(let i32 k, let i32 v)
        let UI e = self.uis[k]
        let i32 ix = e.idx
        e.value = v
        if e.which == 3
            self.sliders[ix].set_value(v)
        if e.which == 4
            self.bars[ix].set_value(v)
        self.uis[k] = e

    fn void set_checked(let i32 k, let bool b)
        let UI e = self.uis[k]
        let i32 ix = e.idx
        e.checked = b
        if e.which == 6
            self.checks[ix].checked = b
            self.checks[ix].dirty = true
        self.uis[k] = e

    fn void add_item(let i32 k, let string s)
        let UI e = self.uis[k]
        let i32 ix = e.idx
        if e.which == 5
            self.lists[ix].add_item(s)
        if e.which == 7
            let Menu mm = self.menus[ix]
            mm.items = push(mm.items, s)
            mm.dirty = true
            self.menus[ix] = mm
            self.menu_dirty = true
        e.items = push(e.items, s)
        self.uis[k] = e

    // 关闭全部下拉（点击空白/打开新菜单/选中项后调用）
    fn void close_menus()
        let i32 i = 0
        while i < length(self.menus)
            if self.menus[i].open
                self.menus[i].open = false
                self.menus[i].dirty = true
            i++
        if self.menu_dirty == false
            self.menu_dirty = true

    // 菜单栏高度（物理 px）
    fn i32 menu_bar_h()
        return LH() + 6 * SC() / 100

    // 任意组件标脏（业务侧主动刷新用）
    fn void invalidate_all()
        let i32 i = 0
        while i < length(self.labels)
            self.labels[i].dirty = true
            i++
        i = 0
        while i < length(self.buttons)
            self.buttons[i].dirty = true
            i++
        i = 0
        while i < length(self.inputs)
            self.inputs[i].dirty = true
            i++
        i = 0
        while i < length(self.sliders)
            self.sliders[i].dirty = true
            i++
        i = 0
        while i < length(self.bars)
            self.bars[i].dirty = true
            i++
        i = 0
        while i < length(self.lists)
            self.lists[i].dirty = true
            i++
        i = 0
        while i < length(self.texts)
            self.texts[i].dirty = true
            i++
        i = 0
        while i < length(self.checks)
            self.checks[i].dirty = true
            i++
        self.menu_dirty = true

    // 一帧：泵事件 → 更新 → 脏区重绘 → 按需 present
    fn void step()
        self.t0 = tick_ms()                // 帧起点（gui_frame_sleep 依赖每帧刷新）
        self.any_dirty = false
        let Event e = Event()
        while gui_poll(ref e)
            if e.typ == EV_MOVE
                self.mx = cast(e.x, i32)
                self.my = cast(e.y, i32)
                self.on_hover()
                let i32 mi = 0
                while mi < length(self.menus)
                    if self.menus[mi].open
                        self.menu_dirty = true
                    mi++
            if e.typ == EV_LDOWN or e.typ == EV_LUP
                self.mx = cast(e.x, i32)
                self.my = cast(e.y, i32)
                self.ldown = e.typ == EV_LDOWN
                self.on_click()
            if e.typ == EV_WHEEL
                let i32 i = 0
                while i < length(self.lists)
                    self.lists[i].scroll(cast(e.key, i32))
                    if self.lists[i].dirty
                        self.any_dirty = true
                    i++
                i = 0
                while i < length(self.texts)
                    self.texts[i].scroll(cast(e.key, i32))
                    if self.texts[i].dirty
                        self.any_dirty = true
                    i++
            if e.typ == EV_KEY
                self.on_key(cast(e.key, i64))
        // 拖动持续更新（按住不放也跟随）
        let i32 si = 0
        while si < length(self.sliders)
            if self.sliders[si].dragging and self.ldown
                self.sliders[si].set_value((self.mx - self.sliders[si].x) * 100 / (self.sliders[si].w - 2))
            if self.sliders[si].dirty
                self.any_dirty = true
            si++
        self.ldown_prev = self.ldown
        // 输出标签刷新（uis[k].clicks/value/sel/text_out/changed）
        self.sync_outputs()
        // 重绘脏组件
        self.flush_dirty()
        if self.any_dirty
            gui_present()

    fn void on_hover()
        // 输入框拖选：聚焦且按住左键时移动即扩展选区
        let i32 di = 0
        while di < length(self.inputs)
            if self.inputs[di].focus and self.inputs[di].dragging and self.ldown
                self.inputs[di].on_drag(self.mx)
                if self.inputs[di].dirty
                    self.any_dirty = true
            di++
        let i32 i = 0
        while i < length(self.buttons)
            let bool h = self.buttons[i].hit(self.mx, self.my) and not self.ldown
            if h != self.buttons[i].hot
                self.buttons[i].hot = h
                self.buttons[i].dirty = true
            i++
        i = 0
        while i < length(self.checks)
            let bool hc = self.checks[i].hit(self.mx, self.my) and not self.ldown
            if hc != self.checks[i].hot
                self.checks[i].hot = hc
                self.checks[i].dirty = true
            i++

    fn void on_click()
        let bool press = self.ldown and not self.ldown_prev
        let bool release = not self.ldown and self.ldown_prev
        // ---- 菜单栏（优先于一切组件） ----
        if press and length(self.menus) > 0
            let i32 mbh = self.menu_bar_h()
            let bool in_bar = self.my < mbh
            let bool handled = false
            let i32 mi = 0
            // 下拉打开时：条目命中 > 其他标题 > 空白关闭
            mi = 0
            while mi < length(self.menus)
                if self.menus[mi].open
                    let i32 it = self.menu_item_at(mi, self.mx, self.my)
                    if it >= 0
                        self.menus[mi].sel = it
                        self.menus[mi].clicks++
                        self.menus[mi].open = false
                        self.menus[mi].dirty = true
                        self.menu_dirty = true
                        handled = true
                mi++
            if not handled and in_bar
                mi = 0
                while mi < length(self.menus)
                    if self.mx >= self.menus[mi].x and self.mx < self.menus[mi].x + self.menus[mi].tw
                        let bool was = self.menus[mi].open
                        self.close_menus()
                        self.menus[mi].open = not was
                        self.menus[mi].dirty = true
                        self.menu_dirty = true
                        handled = true
                    mi++
            if not handled
                self.close_menus()
            self.ldown_prev = self.ldown
            return
        // 输入框聚焦：press 时先全部失焦（inputs 与 texts 互斥），再按命中恢复
        let i32 i = 0
        if press
            i = 0
            while i < length(self.inputs)
                self.inputs[i].set_focus(false)
                i++
            i = 0
            while i < length(self.texts)
                self.texts[i].set_focus(false)
                i++
        i = 0
        while i < length(self.inputs)
            if press
                self.inputs[i].set_focus(self.inputs[i].hit(self.mx, self.my))
                if self.inputs[i].focus
                    self.inputs[i].on_press(self.mx)
            if not press
                self.inputs[i].on_release()
            if self.inputs[i].dirty
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.texts)
            if press
                self.texts[i].set_focus(self.texts[i].hit(self.mx, self.my))
                if self.texts[i].focus
                    self.texts[i].place_cursor(self.mx, self.my)
            if self.texts[i].dirty
                self.any_dirty = true
            i++
        // 复选框
        i = 0
        while i < length(self.checks)
            let bool inside = self.checks[i].hit(self.mx, self.my)
            if press and inside
                self.checks[i].pressed = true
                self.checks[i].dirty = true
            if release and self.checks[i].pressed
                self.checks[i].pressed = false
                self.checks[i].checked = not self.checks[i].checked
                self.checks[i].clicks++
                self.checks[i].dirty = true
            if self.checks[i].dirty
                self.any_dirty = true
            i++
        // 按钮
        i = 0
        while i < length(self.buttons)
            let bool inside = self.buttons[i].hit(self.mx, self.my)
            if press and inside
                self.buttons[i].pressed = true
                self.buttons[i].dirty = true
            if release and self.buttons[i].pressed
                self.buttons[i].pressed = false
                self.buttons[i].dirty = true
                if inside
                    self.buttons[i].clicks++
            if self.buttons[i].dirty
                self.any_dirty = true
            i++
        // 滑块：左键按下进入拖动，抬起结束
        i = 0
        while i < length(self.sliders)
            if press and self.sliders[i].hit_wide(self.mx, self.my)
                self.sliders[i].dragging = true
                self.sliders[i].set_value((self.mx - self.sliders[i].x) * 100 / (self.sliders[i].w - 2))
            if release
                self.sliders[i].dragging = false
            if self.sliders[i].dirty
                self.any_dirty = true
            i++
        // 列表选中
        i = 0
        while i < length(self.lists)
            if press and self.mx >= self.lists[i].x and self.mx < self.lists[i].x + self.lists[i].w
                let i32 rows = length(self.lists[i].items)
                let i32 hgt = self.lists[i].rows * LH() + 8 * SC() / 100
                if self.my >= self.lists[i].y and self.my < self.lists[i].y + hgt
                    let i32 row = (self.my - self.lists[i].y - 4 * SC() / 100) / LH()
                    let i32 idx = self.lists[i].top + row
                    if row >= 0 and idx < rows
                        self.lists[i].sel = idx
                        self.lists[i].dirty = true
                        // 双击检测：同一行 <400ms 两次按下
                        let i64 tms = tick_ms()
                        if idx == self.lists[i].last_row and tms - self.lists[i].last_ms < 400
                            self.lists[i].dbl++
                            self.lists[i].dbl_row = idx
                            self.lists[i].last_row = -1
                            self.lists[i].last_ms = 0
                        else
                            self.lists[i].last_row = idx
                            self.lists[i].last_ms = tms
            if self.lists[i].dirty
                self.any_dirty = true
            i++
        // 边沿状态推进：每次鼠标事件处理后更新（合成 press/release
        // 与真实事件流都依赖此序——press 后紧跟 release 才可检出）
        self.ldown_prev = self.ldown

    fn void on_key(let i64 k)
        let i32 i = 0
        while i < length(self.inputs)
            if self.inputs[i].focus
                if self.inputs[i].handle_key(k)
                    self.any_dirty = true
            i++
        i = 0
        while i < length(self.texts)
            if self.texts[i].focus
                if self.texts[i].handle_key(k)
                    self.any_dirty = true
            i++

    // 下拉菜单条目命中：返回条目索引（-1 = 未命中）
    fn i32 menu_item_at(let i32 mi, let i32 px, let i32 py)
        let i32 u = SC()
        let i32 mbh = LH() + 6 * u / 100
        let i32 iw = self.menu_item_w(mi)
        let i32 ih = LH() + 4 * u / 100
        let i32 n = length(self.menus[mi].items)
        let i32 i = 0
        while i < n
            let i32 iy = mbh + i * ih
            if px >= self.menus[mi].x and px < self.menus[mi].x + iw and py >= iy and py < iy + ih
                return i
            i++
        return -1

    // 下拉面板宽度（最长条目 + 内边距）
    fn i32 menu_item_w(let i32 mi)
        let i32 u = SC()
        let i32 iw = 0
        let i32 i = 0
        while i < length(self.menus[mi].items)
            let i32 twi = gui_text_w(self.menus[mi].items[i])
            if twi > iw
                iw = twi
            i++
        return iw + 24 * u / 100

    // 布局菜单标题横向位置（加菜单/改标题后调用一次即可；draw 也会自愈）
    fn void layout_menus()
        let i32 u = SC()
        let i32 px = 6 * u / 100
        let i32 i = 0
        while i < length(self.menus)
            self.menus[i].x = px
            self.menus[i].tw = gui_text_w(self.menus[i].title) + 16 * u / 100
            px = px + self.menus[i].tw
            self.menus[i].dirty = true
            i++
        self.menu_dirty = true

    fn void draw_menu_bar()
        let i32 u = SC()
        let i32 mbh = LH() + 6 * u / 100
        if length(self.menus) == 0
            return
        // 自愈布局（v3.5 DX）：任一菜单 tw<=0（未调 layout_menus）时先补齐
        // 标题 x/tw——否则标题画得出（gui_draw_text 不用 tw）却点不中（命中用 x+tw）
        let i32 nl = 0
        while nl < length(self.menus)
            if self.menus[nl].tw <= 0
                self.layout_menus()
                break
            nl++
        let i32 nopen = 0
        let i32 i = 0
        while i < length(self.menus)
            if self.menus[i].open
                nopen++
            i++
        if self.menu_dirty or nopen > 0
            gui_fill_rect(0, 0, gui_w(), mbh, C_PANEL)
            gui_fill_rect(0, mbh - 1, gui_w(), 1, C_BORDER)
            i = 0
            while i < length(self.menus)
                let Menu m = self.menus[i]
                let bool hot = self.my < mbh and self.mx >= m.x and self.mx < m.x + m.tw
                if m.open
                    gui_fill_rect(m.x, 0, m.tw, mbh, C_HOT)
                else
                    if hot
                        gui_fill_rect(m.x, 0, m.tw, mbh, C_PANEL)
                gui_draw_text(m.x + 8 * u / 100, 4 * u / 100, m.title, C_TEXT)
                i++
            // 下拉面板（打开时覆盖在内容之上，最后画）
            i = 0
            while i < length(self.menus)
                if self.menus[i].open
                    let i32 iw = self.menu_item_w(i)
                    let i32 ih = LH() + 4 * u / 100
                    let i32 n = length(self.menus[i].items)
                    gui_fill_rect(self.menus[i].x, mbh, iw, n * ih + 4 * u / 100, C_PANEL)
                    gui_rect(self.menus[i].x, mbh, iw, n * ih + 4 * u / 100, C_BORDER)
                    let i32 j = 0
                    while j < n
                        let i32 iy = mbh + j * ih
                        let bool hov = self.mx >= self.menus[i].x and self.mx < self.menus[i].x + iw and self.my >= iy and self.my < iy + ih
                        if hov
                            gui_fill_rect(self.menus[i].x + 1, iy, iw - 2, ih, C_HOT)
                        gui_draw_text(self.menus[i].x + 12 * u / 100, iy + 2 * u / 100,
                                      self.menus[i].items[j], C_TEXT)
                        j++
                i++
            self.menu_dirty = false

    fn void flush_dirty()
        self.draw_menu_bar()
        let i32 i = 0
        while i < length(self.labels)
            if self.labels[i].dirty
                self.labels[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.buttons)
            if self.buttons[i].dirty
                self.buttons[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.inputs)
            if self.inputs[i].dirty
                self.inputs[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.sliders)
            if self.sliders[i].dirty
                self.sliders[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.bars)
            if self.bars[i].dirty
                self.bars[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.lists)
            if self.lists[i].dirty
                self.lists[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.texts)
            if self.texts[i].dirty
                self.texts[i].draw()
                self.any_dirty = true
            i++
        i = 0
        while i < length(self.checks)
            if self.checks[i].dirty
                self.checks[i].draw()
                self.any_dirty = true
            i++


// ===== 字符串辅助（TextArea 用；按 UTF-8 字节索引，闭区间切片） =====

// 前 i 字节（i<=0 得空串）
fn string prefix(let string s, let i32 i)
    if i <= 0
        return ""
    return s[0, i - 1]

// 从第 i 字节到串尾（i>=len 得空串）
fn string suffix(let string s, let i32 i)
    let i32 n = length(s)
    if i >= n
        return ""
    return s[i, n - 1]

// s[i] 是否 UTF-8 continuation 字节（0x80..0xBF；ord 返回有符号字节值，即 -128..-65）
fn bool is_cont(let string s, let i32 i)
    if i < 0 or i >= length(s)
        return false
    let i32 b = ord(s[i])
    return b <= -65

// 从位置 i 向前对齐到码点起点
fn i32 align_back(let string s, let i32 i)
    let i32 p = i
    while p > 0 and is_cont(s, p)
        p--
    return p

// 从位置 i 向后对齐到下一码点起点
fn i32 align_fwd(let string s, let i32 i)
    let i32 n = length(s)
    let i32 q = i
    while q < n and is_cont(s, q)
        q++
    return q

// 从码点起点 i 前进到下一码点起点（i 为起点/任意位置均安全；i>=n 返回 n）
fn i32 next_cp(let string s, let i32 i)
    let i32 n = length(s)
    if i >= n
        return n
    let i32 q = i + 1
    while q < n and is_cont(s, q)
        q++
    return q

// ===== Checkbox：复选框 =====
// ===== Menu：菜单栏下拉菜单（App.add_menu 挂载；sel/clicks 业务读取） =====
pub struct Menu
    string title
    string[] items
    i32 x = 0            // 标题左起点（layout_menus 布局）
    i32 tw = 0           // 标题宽
    i32 sel = -1         // 最后选中的条目索引
    i32 clicks = 0       // 选中任一条目时 ++（业务对比差值）
    bool open = false
    bool dirty = true

pub struct Checkbox
    i32 x
    i32 y
    string text
    bool checked = false      // 业务读写
    bool hot = false
    bool pressed = false
    i32 clicks = 0
    bool dirty = true

    fn i32 box_size()
        return 16 * SC() / 100

    fn bool hit(let i32 mx, let i32 my)
        let i32 bs = self.box_size()
        let i32 tw = gui_text_w(self.text)
        let i32 wfull = bs + 6 * SC() / 100 + tw
        let i32 hfull = bs
        if bs < LH()
            hfull = LH()
        return mx >= self.x and mx < self.x + wfull and my >= self.y and my < self.y + hfull

    fn void draw()
        let i32 u = SC()
        let i32 bs = self.box_size()
        let u32 fill = C_PANEL
        if self.pressed
            fill = C_DOWN
        else
            if self.hot
                fill = C_HOT
        gui_fill_rect(self.x, self.y, bs, bs, fill)
        gui_rect(self.x, self.y, bs, bs, C_BORDER)
        if self.checked
            gui_draw_text(self.x + 2 * u / 100, self.y - 2 * u / 100, "✓", C_OK)
        let i32 ty = self.y + (bs - LH()) / 2
        gui_draw_text(self.x + bs + 6 * u / 100, ty, self.text, C_TEXT)
        self.dirty = false

// ===== TextArea：多行文本编辑 =====
// 光标（字节列 cx / 行 cy）、Enter 拆行、Backspace 合行、方向键/Home/End/
// Delete、滚轮滚动、Ctrl+V 粘贴（剪贴板 \n 拆行插入）。超宽行按像素截断。
pub struct TextArea
    i32 x
    i32 y
    i32 w
    i32 h
    string[] lines
    i32 cx = 0            // 光标字节列
    i32 cy = 0            // 光标行
    i32 top = 0           // 首可见行
    bool focus = false
    bool dirty = true

    fn i32 vis_rows()
        let i32 vr = (self.h - 8 * SC() / 100) / LH()
        if vr < 1
            vr = 1
        return vr

    fn void scroll(let i32 d)
        let i32 vr = self.vis_rows()
        let i32 n = length(self.lines)
        let i32 nt = self.top + d
        if nt < 0
            nt = 0
        if n > vr
            if nt > n - vr
                nt = n - vr
        else
            nt = 0
        if nt != self.top
            self.top = nt
            self.dirty = true

    fn void clamp_scroll()
        let i32 vr = self.vis_rows()
        if self.cy < self.top
            self.top = self.cy
        if self.cy >= self.top + vr
            self.top = self.cy - vr + 1
        if self.top < 0
            self.top = 0
        self.dirty = true

    fn void set_text(let string s)
        self.lines = split(s, "\n")
        let i32 i = 0
        while i < length(self.lines)
            self.lines[i] = trim(self.lines[i], "\r")
            i++
        self.cx = 0
        self.cy = 0
        self.top = 0
        self.dirty = true

    fn string text()
        let string s2 = ""
        let i32 i = 0
        while i < length(self.lines)
            if i > 0
                s2 = s2 + "\n"
            s2 = s2 + self.lines[i]
            i++
        return s2

    fn bool hit(let i32 mx, let i32 my)
        return mx >= self.x and mx < self.x + self.w and my >= self.y and my < self.y + self.h

    fn void set_focus(let bool f)
        if self.focus != f
            self.focus = f
            self.dirty = true

    // 鼠标点击定位光标（空 lines 时自动初始化为单空行，v3.5 DX 防越界）
    fn void place_cursor(let i32 mx, let i32 my)
        if length(self.lines) == 0
            self.set_text("")
        let i32 pad = 4 * SC() / 100
        let i32 row = (my - self.y - pad) / LH()
        if row < 0
            row = 0
        self.cy = self.top + row
        let i32 nl = length(self.lines)
        if self.cy >= nl
            self.cy = nl - 1
        let string ln = self.lines[self.cy]
        let i32 target = mx - self.x - pad
        let i32 n2 = length(ln)
        if gui_text_w(ln) <= target
            // 点击在行尾之后：光标落行尾（字节末尾，码点安全）
            self.cx = n2
        else
            let i32 i = 0
            let i32 best = 0
            while i < n2
                if gui_text_w(prefix(ln, i)) > target
                    break
                best = i
                i = next_cp(ln, i)
            self.cx = best
        self.clamp_scroll()

    // 替换第 cy 行并重建数组的通用入口都不需要——直接改 self.lines[cy]
    // 光标处插入多行文本（\n 拆行；空串无操作），供 Ctrl+V 与业务侧复用
    fn void insert_at_cursor(let string clip)
        if length(self.lines) == 0
            self.set_text("")
        let i32 nl = length(self.lines)
        let string ln = self.lines[self.cy]
        if clip != ""
            let string[] segs = split(clip, "\n")
            let i32 ns = length(segs)
            let i32 i = 0
            while i < ns
                segs[i] = trim(segs[i], "\r")
                i++
            segs[0] = prefix(ln, self.cx) + segs[0]
            segs[ns - 1] = segs[ns - 1] + suffix(ln, self.cx)
            // lines[0..cy-1] + segs + lines[cy+1..]（占位首元素后裁掉）
            let string[] out = self.lines[0, 0]
            i = 0
            while i < self.cy
                out = push(out, self.lines[i])
                i++
            i = 0
            while i < ns
                out = push(out, segs[i])
                i++
            i = self.cy + 1
            while i < nl
                out = push(out, self.lines[i])
                i++
            self.lines = out[1, length(out) - 1]
            self.cy = self.cy + ns - 1
            self.cx = length(segs[ns - 1]) - length(suffix(ln, self.cx))
        self.clamp_scroll()

    fn bool handle_key(let i64 k)
        if length(self.lines) == 0
            self.set_text("")
        let i32 nl = length(self.lines)
        let string ln = self.lines[self.cy]
        let i32 n = length(ln)
        if k == 8
            // Backspace：删光标前一码点；行首则与上一行合并
            if self.cx > 0
                let i32 s2 = align_back(ln, self.cx - 1)
                self.lines[self.cy] = prefix(ln, s2) + suffix(ln, self.cx)
                self.cx = s2
            else
                if self.cy > 0
                    let i32 pn = length(self.lines[self.cy - 1])
                    self.lines[self.cy - 1] = self.lines[self.cy - 1] + ln
                    let string[] out = self.lines[0, 0]
                    let i32 i = 0
                    while i < nl
                        if i != self.cy
                            out = push(out, self.lines[i])
                        i++
                    self.lines = out[1, length(out) - 1]
                    self.cy--
                    self.cx = pn
            self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x2E
            // Delete：删光标处码点；行尾则吞并下一行
            if self.cx < n
                let i32 e2 = align_fwd(ln, self.cx + 1)
                self.lines[self.cy] = prefix(ln, self.cx) + suffix(ln, e2)
            else
                if self.cy < nl - 1
                    self.lines[self.cy] = ln + self.lines[self.cy + 1]
                    let string[] out = self.lines[0, 0]
                    let i32 i = 0
                    while i < nl
                        if i != self.cy + 1
                            out = push(out, self.lines[i])
                        i++
                    self.lines = out[1, length(out) - 1]
            self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x25
            // Left
            if self.cx > 0
                self.cx = align_back(ln, self.cx - 1)
            else
                if self.cy > 0
                    self.cy--
                    self.cx = length(self.lines[self.cy])
            self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x27
            // Right
            if self.cx < n
                self.cx = align_fwd(ln, self.cx + 1)
            else
                if self.cy < nl - 1
                    self.cy++
                    self.cx = 0
            self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x26
            // Up
            if self.cy > 0
                self.cy--
                if self.cx > length(self.lines[self.cy])
                    self.cx = length(self.lines[self.cy])
                self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x28
            // Down
            if self.cy < nl - 1
                self.cy++
                if self.cx > length(self.lines[self.cy])
                    self.cx = length(self.lines[self.cy])
                self.clamp_scroll()
            return true
        if k == KEY_EXT + 0x24
            self.cx = 0
            self.dirty = true
            return true
        if k == KEY_EXT + 0x23
            self.cx = n
            self.dirty = true
            return true
        if k == KEY_CTRL + 86 or k == 22
            // Ctrl+V 粘贴（86='V'；22=0x16 为 WM_CHAR 控制码兜底）
            self.insert_at_cursor(gui_clip_get())
            return true
        if k == 13 or k == 10
            // Enter：光标处拆行
            let string head = prefix(ln, self.cx)
            let string tail = suffix(ln, self.cx)
            let string[] out = self.lines[0, 0]
            let i32 i = 0
            while i < self.cy
                out = push(out, self.lines[i])
                i++
            out = push(out, head)
            out = push(out, tail)
            i = self.cy + 1
            while i < nl
                out = push(out, self.lines[i])
                i++
            self.lines = out[1, length(out) - 1]
            self.cy++
            self.cx = 0
            self.clamp_scroll()
            return true
        if k >= 32 and k < KEY_EXT
            // 可打印（含中文，WM_CHAR UTF-16 码元）：光标处插入
            self.lines[self.cy] = prefix(ln, self.cx) + cast(k, char) + suffix(ln, self.cx)
            self.cx = self.cx + length("" + cast(k, char))
            self.clamp_scroll()
            return true
        return false

    fn void draw()
        let i32 u = SC()
        let i32 pad = 4 * u / 100
        let u32 border = C_BORDER
        if self.focus
            border = C_ACCENT
        gui_round_rect(self.x, self.y, self.w, self.h, 6 * u / 100, C_PANEL, border)
        let i32 vr = self.vis_rows()
        let i32 nl = length(self.lines)
        let i32 last = self.top + vr
        if last > nl
            last = nl
        let i32 avail = self.w - 2 * pad
        let i32 i = self.top
        while i < last
            let i32 ry = self.y + pad + (i - self.top) * LH()
            let string ln = self.lines[i]
            // 超宽行按像素截断（对齐码点）
            let i32 cnt = length(ln)
            while cnt > 0 and gui_text_w(prefix(ln, cnt)) > avail
                cnt = align_back(ln, cnt - 1)
            if cnt > 0
                gui_draw_text(self.x + pad, ry, prefix(ln, cnt), C_TEXT)
            i++
        // 光标
        if self.focus
            if self.cy >= self.top and self.cy < last
                let string ln2 = self.lines[self.cy]
                let i32 cxx = gui_text_w(prefix(ln2, self.cx))
                gui_fill_rect(self.x + pad + cxx, self.y + pad + (self.cy - self.top) * LH(), 2 * u / 100, LH(), C_TEXT)
        self.dirty = false

// ===== UI：统一元素（new2.md「元素+标签」模型，v3.17） =====
// 一个元素类型 + 标签袋：kind 决定功能，标签声明坐标/颜色/形状/大小/内容。
//   输入 = 打标签：加入前用元素方法（pos/size/text/color/...），
//          加入后用 app.set_xxx(k, ...)；
//   输出 = 读标签：每帧 app.step() 后读 app.uis[k] 的
//          clicks / value / sel / checked / text_out / changed。
// kind："label" "button" "input" "slider" "progress" "list" "check" "menu" "textarea"
pub fn i32 kind_of(let string k)
    if k == "button"
        return 1
    if k == "input"
        return 2
    if k == "slider"
        return 3
    if k == "progress"
        return 4
    if k == "list"
        return 5
    if k == "check"
        return 6
    if k == "menu"
        return 7
    if k == "textarea"
        return 8
    return 0

pub struct UI
    string kind = "label"
    // ---- 属性标签 ----
    i32 x = 0
    i32 y = 0
    i32 w = 0
    i32 h = 0
    string text = ""
    u32 color = 0        // 面色/填充（0=各 kind 主题默认）
    u32 tcolor = 0       // 文本色（0=主题 C_TEXT）
    i32 radius = 0       // 圆角（0=各 kind 默认；button 生效）
    i32 value = 0        // slider/progress 初值（0..100）
    i32 rows = 0         // list 可见行数（0=默认 4）
    string[] items       // list 条目 / menu 条目
    bool checked = false // check 初值
    // ---- 输出标签（app.step() 后自动刷新） ----
    i32 clicks = 0       // button/check/menu：点击计数；list：双击计数
    i32 sel = -1         // list/menu 选中下标
    bool changed = false // 本帧 value/sel/text 是否变化
    // （value/checked 兼作输出：step 后同步为当前值）
    string text_out = "" // input/textarea 当前文本；list 选中项文本
    // ---- 内部 ----
    i32 which = 0
    i32 idx = -1         // 在 App 对应组件数组中的下标
    string cache_s = ""
    i32 cache_i = 0
    string uname = ""    // ui 语句查重键（元素名）
    i32 p_clicks = 0     // on_xxx 边沿检查用的上一帧值
    i32 p_sel = -1
    i32 p_value = 0
    string p_text = ""

    // ---- 加入前的标签方法 ----
    fn void uname(let string s)
        self.uname = s

    fn void pos(let i32 px, let i32 py)
        self.x = px
        self.y = py

    fn void size(let i32 pw, let i32 ph)
        self.w = pw
        self.h = ph

    fn void text(let string s)
        self.text = s

    fn void color(let u32 c)
        self.color = c

    fn void text_color(let u32 c)
        self.tcolor = c

    fn void radius(let i32 r)
        self.radius = r

    fn void value(let i32 v)
        let i32 vv = v
        if vv < 0
            vv = 0
        if vv > 100
            vv = 100
        self.value = vv

    fn void rows(let i32 n)
        self.rows = n

    fn void checked(let bool b)
        self.checked = b

    fn void add_item(let string s)
        self.items = push(self.items, s)
