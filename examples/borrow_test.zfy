// borrow 借用测试（v3.21）：borrow e 取借用，借用期内源不可 move
struct Bag
    i32 n
    i32 m

fn i32 bump(ref let i32 v)
    v = v + 1
    return v

fn main()
    // 1) 基本借用：借用变量经解引用读
    let i32 x = 7
    let i32* const p = borrow(x)
    output(p^)                       // 期望 7
    output(bump(ref x))              // 8（借用传参，源仍可用）
    output(x)                        // 8

    // 2) 借用字段/元素
    let Bag b = Bag(n=1, m=2)
    let i32* const pn = borrow(b.n)
    output(pn^)                      // 期望 1

    // 3) 借用 struct
    let Bag* const pb = borrow(b)
    output(pb^.m)                    // 期望 2

    // 4) 正常 move（无借用冲突时）
    let i32[] ys = 4, 5
    let i32 n0 = length(ys)
    output(n0)
    output("ok")
