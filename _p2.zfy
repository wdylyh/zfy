fn main()
    let i32[] xs = 1, 2, 3, 4, 5
    bump(ref xs, 100)
    output("xs0=", xs[0], "\n")
    let i32[] ys = xs[0:2]
    output("ys_len=", length(ys), " ys1=", ys[1], "\n")
    let u64 v = 7
    let u64* pv = &v
    output("v=", v, "\n")
    return 0

fn void bump(ref let i32 xs[], let i32 v)
    xs[0] = v
