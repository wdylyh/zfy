// T8: 泛型函数 + 泛型 struct（单态化实例 300k + 150k 次）
struct Box<T>
    T v = 0

fn <T> T pick(let T a, let T b)
    if a < b
        return a
    return b

fn main()
    let i64 acc = 0
    let f64 accf = 0.0
    for let i32 i = 0,   i < 300000, i++
        let Box<i32> b = Box(i)
        acc += b.v
        acc += pick(i % 7, 3)
    for let i32 j = 0,   j < 150000, j++
        let Box<f64> c = Box(cast(j, f64) * 0.5)
        accf += c.v
    output("T8 acc=", acc, " accf=", accf)
    return 0
