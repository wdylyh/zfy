type IntPair = i32

struct Point
    i32 x = 0
    i32 y = 0

struct packed Node
    i32 value = 0
    Node* next

i32 frac half_num(i32 x)
    i32 frac r = x / 2
    return r

i32 frac reduce_demo(i32 x, i64 n, i64 d)
    i32 frac r = x
    reduce(r, n, d)
    return r

i32! safe_div(i32 a, i32 b)
    if b == 0
        fail(1, "division by zero")
    return a / b

i32! parse_number(string s)
    i32 v = cast(s, i32)?
    return v

void print_point(Point p)
    output("Point")

void swap(i32 ref a, i32 ref b)
    i32 t = a
    a = b
    b = t

<T> T max_of(T a, T b)
    if a > b
        return a
    return b

i32 sum_array(i32 arr[5])
    i32 s = 0
    i32 i = 0
    while i < 5
        s += arr[i]
        i++
    return s

void demo_basic()
    i32 a = 10
    i32 b = 20
    swap(ref a, ref b)
    output("after swap: ", a, ", ", b)

    i32 arr[5]
    arr[0] = 1
    arr[1] = 2
    arr[2] = 3
    arr[3] = 4
    arr[4] = 5
    output("sum_array = ", sum_array(arr))

    i32 nums[] = 10, 20, 30
    push(nums, 40)
    output("nums length = ", length(nums))
    remove(nums, 1)
    output("after remove: ", nums[0], ", ", nums[1], ", ", nums[2])

    string parts[] = split("a,b,c", ",")
    output("parts = ", parts[0], " | ", parts[1], " | ", parts[2])

    string s = "hello world"
    // replace 按下标区间替换：replace(s, a, rep)=从 a 到尾；replace(s, a, b, rep)=区间 a..b
    // 无"替换字符"内建——用 find + 切片拼接实现单次替换
    i64 w = find(s, 'w') ?? -1
    string t = s[0, w] + "zfy" + s[w + 1, length(s) - 1]
    output(t)
    string seg = replace(s, 6, "there")     // 从下标 6 起替换到尾
    output(seg)
    string seg2 = replace(s, 0, 4, "HELLO") // 区间 0..4 两端含
    output(seg2)

    i64 idx = find(s, 'o') ?? -1
    output("find fallback = ", idx)

void demo_error()
    i32! x = safe_div(10, 2)
    i32 v = x ?? -1
    output("safe_div ok = ", v)

    i32! y = safe_div(10, 0)
    i32 w = y ?? -1
    output("safe_div fallback = ", w)

    i32! z = parse_number("123")
    i32 p = z ?? 0
    output("parse_number = ", p)

    i32! bad = parse_number("abc")
    i32 q = bad ?? 0
    output("parse bad fallback = ", q)

void demo_control()
    // 注意：for 头部里 `i = 0` 是赋值段（归入 update），不是初始化段——
    // 变量已在上方声明时应写 `for i < 3, i++`，或直接在头部声明 `for i32 i = 0, ...`
    for i32 i = 0, i < 3, i++
        output("for i = ", i)

    i32 j = 0
    while j < 3
        if j == 1
            j++
            continue
        output("while j = ", j)
        j++

    i32 k = 0
    for
        if k >= 3
            break
        output("loop k = ", k)
        k++

void demo_generic()
    i32 m = max_of(3, 7)
    f64 n = max_of(1.5, 2.5)
    output("max i32 = ", m)
    output("max f64 = ", n)

void demo_input()
    string name
    input(name, delim="\n")
    output("hello, ", name)

void main()
    demo_basic()
    demo_error()
    demo_control()
    demo_generic()
    demo_input()