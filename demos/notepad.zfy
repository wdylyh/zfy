// notepad.zfy — zfy GUI M4 记事本（菜单栏版）
// 组件：MenuBar（文件/编辑）+ TextArea + 状态栏 + 窗口图标
// 功能：编辑多行文本 / 新建 / 复制 / 粘贴 / 插入时间 / 退出 / 字数统计
//       响应式：拖拽窗口边缘缩放，编辑区与状态栏随尺寸重排
mod gui;
mod widgets;
use widgets::{App, TextArea, Menu, Label}
use gui::{gui_present, gui_alive, gui_w, gui_h, gui_clip_set, gui_clip_get, gui_frame_sleep, gui_set_icon}

// 字符数（按 UTF-8 码点粗算）
fn i32 char_count(let string s)
    let i32 n = length(s)
    let i32 i = 0
    let i32 cnt = 0
    while i < n
        let string ch = s[i, i]
        let i32 b = ord(ch[0])
        if b >= 0
            cnt++
        else
            // 负字节 = 多字节首字节（i8）：2字节 -64..-33 / 3字节 -32..-17 / 4字节 -16..-9
            if b >= -16
                i = i + 3
            else
                if b >= -32
                    i = i + 2
                else
                    i = i + 1
        i++
    return cnt

fn main()
    let App app = App()
    let i32 rc = app.open(640, 440, "zfy 记事本")
    if rc != 0
        output("open fail rc=", rc)
        return 1
    gui_set_icon("zfy.ico")

    let Menu mFile = Menu()
    mFile.title = "文件"
    mFile.items = "新建", "退出"
    let Menu mEdit = Menu()
    mEdit.title = "编辑"
    mEdit.items = "复制", "粘贴", "插入时间"
    let i32 _idx1 = app.add_menu(mFile)
    let i32 _idx2 = app.add_menu(mEdit)
    app.layout_menus()

    let TextArea ta = TextArea()
    ta.set_text("zfy 记事本\n\n菜单栏：文件/编辑（点击打开下拉）\n支持中英文输入、回车换行、Ctrl+V、方向键移动光标")
    let i32 _idx3 = app.add_text(ta)

    let Label stat = Label()
    stat.text = ""
    let i32 _idx4 = app.add_label(stat)

    let string last = ""          // 上次统计文本，变化才刷状态栏
    let i32 pw = 0
    let i32 ph = 0

    while app.alive()
        // 菜单动作（clicks 差值 + sel 项索引）
        if app.menus[0].clicks > 0
            // 文件菜单
            if app.menus[0].sel == 0
                app.texts[0].set_text("")
                app.texts[0].dirty = true
            if app.menus[0].sel == 1
                app.quit = true
            app.menus[0].clicks = 0
        if app.menus[1].clicks > 0
            // 编辑菜单
            if app.menus[1].sel == 0
                gui_clip_set(app.texts[0].text())
            if app.menus[1].sel == 1
                let string cb = gui_clip_get()
                if cb != ""
                    app.texts[0].insert_at_cursor(cb)
                    app.texts[0].dirty = true
            if app.menus[1].sel == 2
                let datetime dt = localtime(now())
                let string stamp = cast(dt.year, string) + "-" + cast(dt.month, string) + "-" + cast(dt.day, string) + " " + cast(dt.hour, string) + ":" + cast(dt.minute, string)
                app.texts[0].insert_at_cursor(stamp)
                app.texts[0].dirty = true
            app.menus[1].clicks = 0

        // 响应式布局：窗口尺寸变化时重排
        if gui_w() != pw or gui_h() != ph
            pw = gui_w()
            ph = gui_h()
            app.texts[0].x = 8
            app.texts[0].y = app.menu_bar_h() + 6
            app.texts[0].w = pw - 16
            app.texts[0].h = ph - app.menu_bar_h() - 40
            app.labels[0].x = 8
            app.labels[0].y = ph - 26
            app.labels[0].bg_w = pw - 16
            app.invalidate_all()

        // 状态栏：文本变化才重算
        let string cur = app.texts[0].text()
        if cur != last
            last = cur
            let i32 cc = char_count(cur)
            let i32 lc = length(app.texts[0].lines)
            app.labels[0].text = cast(cc, string) + " 字 · " + cast(lc, string) + " 行 · 光标 " + cast(app.texts[0].cy + 1, string) + ":" + cast(app.texts[0].cx, string)
            app.labels[0].dirty = true

        app.step()
        app.labels[0].draw()
        gui_present()
        gui_frame_sleep(app.t0)

    app.close()
    return 0
