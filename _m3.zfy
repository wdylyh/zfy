struct Acc
    u64 s0 = 1
    u64 s1 = 2

    fn u64 step()
        self.s0 = self.s0 + self.s1
        return self.s0

    fn u64 twice()
        let u64 a = self.step()
        return a + self.step()

fn main()
    let Acc a = Acc(s0 = 1, s1 = 1)
    output(a.twice(), "\n")     // step:2, step:3 -> 5
    output(a.s0, "\n")          // 3
    return 0
